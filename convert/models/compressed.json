{
  "gguf": ["deepseek4"],
  "graph": {
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "streams_in", "in": "x", "out": "xs"},
      {"op": "stream_read", "streams": "xs", "in": ["x", "x"], "out": "ai", "of": "attn"},
      {"op": "norm", "in": "ai", "w": "attn_norm", "out": "n"},
      {"op": "matvec", "in": "n", "w": "attn_q_a", "rows": "rows('attn_q_a')", "out": "qa"},
      {"op": "norm", "in": "qa", "w": "attn_q_a_norm", "eps": "latent_eps", "out": "qa"},
      {"op": "matvec", "in": "qa", "w": ["attn_q_b", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "norm", "in": "k", "w": "attn_kv_a_norm", "out": "k", "if": "stored('attn_kv_a_norm')"},
      {"op": "emit", "kind": "head_norm", "in": "q", "attr": {"Eps": "eps", "HeadDim": "head_dim"}, "outs": [{"name": "q.unit", "width": "heads * head_dim"}], "out": "q"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": "q", "name": "q.rope", "attr": {"Offset": "head_dim - rot"}, "out": "q", "if": "rope_at"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": "k", "name": "k.rope", "attr": {"Offset": "head_dim - rot"}, "out": "k", "if": "rope_at"},
      {"op": "matvec", "in": "n", "w": "attn_compressor_kv", "rows": "rows('attn_compressor_kv')", "out": "cv", "if": "src['attention.compress_ratios'][layer] > 0"},
      {"op": "matvec", "in": "n", "w": "attn_compressor_gate", "rows": "rows('attn_compressor_gate')", "out": "cg", "if": "src['attention.compress_ratios'][layer] > 0"},
      {"op": "matvec", "in": "n", "w": "indexer_compressor_kv", "rows": "rows('indexer_compressor_kv')", "out": "iv", "if": "selects"},
      {"op": "matvec", "in": "n", "w": "indexer_compressor_gate", "rows": "rows('indexer_compressor_gate')", "out": "ig", "if": "selects"},
      {"op": "emit", "kind": "concat", "in": ["k", "cv", "cg"], "outs": [{"name": "k.row", "width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv')"}], "out": "k", "if": "src['attention.compress_ratios'][layer] > 0 and not selects"},
      {"op": "emit", "kind": "concat", "in": ["k", "cv", "cg", "iv", "ig"], "outs": [{"name": "k.row", "width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + 2 * rows('indexer_compressor_kv')"}], "out": "k", "if": "selects"},
      {"op": "kv_append", "in": ["k", "k"], "out": "hist"},
      {"op": "history_pool", "hist": "hist", "attr": {"Span": "src['attention.compress_ratios'][layer]", "Width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv')"}, "words": ["0", "kv_heads * head_dim", "kv_heads * head_dim + rows('attn_compressor_kv')", "0"], "bind": [{"w": "attn_compressor_ape", "k": "rows('attn_compressor_kv')", "rows": "src['attention.compress_ratios'][layer]"}], "outs": [{"name": "pool", "width": "rows('attn_compressor_kv')"}], "out": "ent", "if": "src['attention.compress_ratios'][layer] > 0 and not selects"},
      {"op": "history_pool", "hist": "hist", "attr": {"Span": "src['attention.compress_ratios'][layer]", "Width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + 2 * rows('indexer_compressor_kv')"}, "words": ["1", "kv_heads * head_dim", "kv_heads * head_dim + rows('attn_compressor_kv')", "0", "0", "kv_heads * head_dim + rows('attn_compressor_kv') // 2", "kv_heads * head_dim + rows('attn_compressor_kv') + rows('attn_compressor_kv') // 2", "rows('attn_compressor_kv') // 2"], "bind": [{"w": "attn_compressor_ape", "k": "rows('attn_compressor_kv')", "rows": "src['attention.compress_ratios'][layer]"}], "outs": [{"name": "pool", "width": "rows('attn_compressor_kv') // 2"}], "out": "ent", "if": "selects"},
      {"op": "norm", "in": "ent", "w": "attn_compressor_norm", "out": "ent", "if": "src['attention.compress_ratios'][layer] > 0"},
      {"op": "rope_table", "global": "src['attention.compress_ratios'][layer] > 0", "attr": {"Span": "src['attention.compress_ratios'][layer]"}, "out": "tab", "if": "src['attention.compress_ratios'][layer] > 0 and rope_at"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": ["ent", "tab"], "name": "ent.rope", "attr": {"HeadDim": "rows('attn_compressor_kv')", "Offset": "rows('attn_compressor_kv') - rot"}, "out": "ent", "if": "src['attention.compress_ratios'][layer] > 0 and not selects and rope_at"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": ["ent", "tab"], "name": "ent.rope", "attr": {"HeadDim": "rows('attn_compressor_kv') // 2", "Offset": "rows('attn_compressor_kv') // 2 - rot"}, "out": "ent", "if": "selects and rope_at"},
      {"op": "history_pool", "hist": "hist", "attr": {"Span": "src['attention.compress_ratios'][layer]", "Width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + 2 * rows('indexer_compressor_kv')"}, "words": ["1", "kv_heads * head_dim + 2 * rows('attn_compressor_kv')", "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + rows('indexer_compressor_kv')", "0", "0", "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + rows('indexer_compressor_kv') // 2", "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + rows('indexer_compressor_kv') + rows('indexer_compressor_kv') // 2", "rows('indexer_compressor_kv') // 2"], "bind": [{"w": "indexer_compressor_ape", "k": "rows('indexer_compressor_kv')", "rows": "src['attention.compress_ratios'][layer]"}], "outs": [{"name": "pool", "width": "rows('indexer_compressor_kv') // 2"}], "out": "ie", "if": "selects"},
      {"op": "norm", "in": "ie", "w": "indexer_compressor_norm", "out": "ie", "if": "selects"},
      {"op": "rope_table", "global": "src['attention.compress_ratios'][layer] > 0", "attr": {"Span": "src['attention.compress_ratios'][layer]"}, "out": "tab", "if": "selects and rope_at"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": ["ie", "tab"], "name": "ent.rope", "attr": {"HeadDim": "rows('indexer_compressor_kv') // 2", "Offset": "rows('indexer_compressor_kv') // 2 - rot"}, "out": "ie", "if": "selects and rope_at"},
      {"op": "emit", "kind": "concat", "in": ["ent", "ie"], "outs": [{"name": "ent.row", "width": "rows('attn_compressor_kv') // 2 + rows('indexer_compressor_kv') // 2"}], "out": "ent", "if": "selects"},
      {"op": "kv_append", "in": ["ent", "ent"], "at": "1", "attr": {"Span": "src['attention.compress_ratios'][layer]"}, "out": "entries", "if": "src['attention.compress_ratios'][layer] > 0"},
      {"op": "indexer", "global": "src['attention.compress_ratios'][layer] > 0", "attr": {"Offset": "src['attention.indexer.key_length'] - rot"}, "in": ["n", "qa"], "out": "ix", "if": "selects"},
      {"op": "select", "in": ["ix.query", "ix.weight"], "hist": "entries", "attr": {"Offset": "rows('attn_compressor_kv') // 2", "Width": "rows('attn_compressor_kv') // 2 + rows('indexer_compressor_kv') // 2"}, "out": "sel", "if": "selects and select_weighted"},
      {"op": "select", "in": "ix.query", "hist": "entries", "attr": {"Offset": "rows('attn_compressor_kv') // 2", "Width": "rows('attn_compressor_kv') // 2 + rows('indexer_compressor_kv') // 2"}, "out": "sel", "if": "selects and not select_weighted"},
      {"op": "attend", "in": ["q", "sel"], "hist": ["hist", "entries"], "w": "attn_sinks?", "attr": {"Width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv') + 2 * rows('indexer_compressor_kv')", "Span": "src['attention.compress_ratios'][layer]"}, "words": ["rows('attn_compressor_kv') // 2 + rows('indexer_compressor_kv') // 2"], "out": "att", "if": "selects"},
      {"op": "attend", "in": "q", "hist": ["hist", "entries"], "w": "attn_sinks?", "attr": {"Width": "kv_heads * head_dim + 2 * rows('attn_compressor_kv')", "Span": "src['attention.compress_ratios'][layer]"}, "words": ["rows('attn_compressor_kv')"], "out": "att", "if": "src['attention.compress_ratios'][layer] > 0 and not selects"},
      {"op": "attend", "in": "q", "hist": "hist", "w": "attn_sinks?", "out": "att", "if": "not (src['attention.compress_ratios'][layer] > 0)"},
      {"op": "rope", "global": "src['attention.compress_ratios'][layer] > 0", "in": "att", "name": "att.unrope", "attr": {"Offset": "head_dim - rot", "Inverse": "true"}, "out": "att", "if": "rope_at"},
      {"op": "emit", "kind": "expert_matvec", "in": "att", "bind": [{"w": "attn_output_a", "k": "heads // src['attention.output_group_count'] * head_dim", "rows": "src['attention.output_lora_rank']", "sheets": "src['attention.output_group_count']"}], "outs": [{"name": "att.groups", "width": "src['attention.output_group_count'] * src['attention.output_lora_rank']"}], "out": "att", "if": "stored('attn_output_a')"},
      {"op": "matvec", "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "stream_writes", "streams": "xs", "in": "o", "ex": "ai.ex", "out": "cur", "of": "attn"},
      {"op": "stream_read", "streams": "cur", "in": ["x", "x"], "out": "fi", "of": "ffn"},
      {"op": "norm", "in": "fi", "w": "ffn_norm", "out": "m"},
      {"op": "mark", "if": "moe", "out": "routed"},
      {"op": "matvec", "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated", "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let", "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit", "if": "moe and stored('exp_probs_b.bias')", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "top_k", "in": "choose", "attr": {"TopK": "[2, experts // expert_groups] | min", "Span": "experts // expert_groups"}, "outs": [{"name": "router.group.sel", "width": "expert_groups * ([2, experts // expert_groups] | min)", "elem": "u32"}, {"name": "router.group.best", "width": "expert_groups * ([2, experts // expert_groups] | min)", "as": "gbest"}]},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "reduce", "in": "gbest", "attr": {"Fn": "'add'", "Span": "[2, experts // expert_groups] | min"}, "outs": [{"name": "router.group.score", "width": "expert_groups"}], "out": "gscore"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "rank", "in": "gscore", "outs": [{"name": "router.group.rank", "width": "expert_groups", "elem": "u32"}], "out": "grank"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": "grank", "attr": {"Fn": "'less'", "Const": "expert_groups_used"}, "outs": [{"name": "router.group.kept", "width": "expert_groups"}], "out": "gkept"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": ["gkept", "choose"], "attr": {"Fn": "'where'", "Const": "-inf"}, "outs": [{"name": "router.kept", "width": "experts"}], "out": "choose"},
      {"op": "emit", "kind": "embed", "bind": [{"w": "ffn_gate_tid2eid"}], "outs": [{"name": "router.token", "width": "experts_used", "elem": "u32", "as": "sel"}], "if": "moe and stored('ffn_gate_tid2eid')"},
      {"op": "emit", "if": "moe and not stored('ffn_gate_tid2eid')", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit", "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum", "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "if": "moe", "from": "routed"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and not stored('ffn_gate_shexp'))", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "add", "if": "(stored('ffn_up_shexp')) and (moe)", "in": ["d", "so"], "out": "d"},
      {"op": "stream_writes", "streams": "cur", "in": "d", "ex": "fi.ex", "out": "fo", "of": "ffn"},
      {"op": "out_streams", "streams": "fo"}
    ]
  }
}

{
  "classes": ["HunYuanDenseV1ForCausalLM", "HunYuanMoEV1ForCausalLM"],
  "config": {
    "arch": "hunyuan-moe",
    "keys": {
      "block_count":                       {"uint": "num_hidden_layers ?? 32"},
      "context_length":                    {"uint": "max_position_embeddings ?? 2048"},
      "embedding_length":                  {"uint": "hidden_size ?? 4096"},
      "feed_forward_length":               {"uint": "intermediate_size ?? 11008"},
      "attention.head_count":              {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":           {"uint": "num_key_value_heads ?? (num_attention_heads ?? 32)"},
      "attention.key_length":              {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.value_length":            {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon":  {"float": "rms_norm_eps ?? 1e-5"},
      "rope.dimension_count":              {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "rope.freq_base":                    {"float": "(((rope_parameters ?? rope_scaling).rope_type ?? (rope_parameters ?? rope_scaling).type) == 'dynamic' && ((rope_parameters ?? rope_scaling).alpha ?? 0) != 0) ? (rope_theta ?? rope_parameters.rope_theta ?? 10000) * (rope_parameters ?? rope_scaling).alpha ** ((head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) / ((head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) - 2)) : (rope_theta ?? rope_parameters.rope_theta ?? 10000)"},
      "expert_count":                      {"uint": "(num_experts ?? 0) > 1 ? num_experts : 0"},
      "expert_used_count":                 {"uint": "uniform(moe_topk ?? 1)"},
      "expert_feed_forward_length":        {"uint": "intermediate_size ?? 11008"},
      "expert_shared_feed_forward_length": {"uint": "(num_experts ?? 0) > 1 ? (intermediate_size ?? 11008) : 0"}
    },
    "vocab": "vocab_size ?? 290943",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "(((rope_parameters ?? rope_scaling).rope_type ?? (rope_parameters ?? rope_scaling).type) == 'dynamic' && ((rope_parameters ?? rope_scaling).alpha ?? 0) != 0) ? null : (rope_parameters ?? rope_scaling)",
    "gating": "softmax",
    "require": [
      {"that": "(use_cla ?? false) == false", "else": "use_cla (cross-layer attention) is not implemented"},
      {"that": "!((num_experts ?? 0) > 1) || uniform(moe_intermediate_size ?? 0) in [0, intermediate_size ?? 11008]",
       "else": "moe_intermediate_size differs from intermediate_size: transformers builds the experts from the second and llama.cpp from the first"},
      {"that": "!((num_experts ?? 0) > 1) || uniform(num_shared_expert ?? 1) in [0, 1]",
       "else": "num_shared_expert is not 0 or 1, and the class builds one shared MLP"}
    ]
  },
  "tensors": {
    "gather": [
      {"role": "attn_q_norm.weight", "from": ["self_attn.query_layernorm.weight", "self_attn.key_layernorm.weight"],
       "do": [{"map": "x * y"}]},
      {"role": "attn_k_norm.weight", "from": ["self_attn.key_layernorm.weight"], "do": [{"map": "1"}]}
    ],
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":           "attn_norm.weight",
      "post_attention_layernorm.weight":  "ffn_norm.weight",
      "self_attn.q_proj.weight":          "attn_q.weight",
      "self_attn.k_proj.weight":          "attn_k.weight",
      "self_attn.v_proj.weight":          "attn_v.weight",
      "self_attn.o_proj.weight":          "attn_output.weight",
      "self_attn.q_proj.bias":            "attn_q.bias",
      "self_attn.k_proj.bias":            "attn_k.bias",
      "self_attn.v_proj.bias":            "attn_v.bias",
      "self_attn.o_proj.bias":            "attn_output.bias",
      "mlp.gate_proj.weight":             "ffn_gate.weight",
      "mlp.up_proj.weight":               "ffn_up.weight",
      "mlp.down_proj.weight":             "ffn_down.weight",
      "mlp.gate.wg.weight":               "ffn_gate_inp.weight",
      "mlp.shared_mlp.gate_proj.weight":  "ffn_gate_shexp.weight",
      "mlp.shared_mlp.up_proj.weight":    "ffn_up_shexp.weight",
      "mlp.shared_mlp.down_proj.weight":  "ffn_down_shexp.weight"
    },
    "experts": {
      "prefix": "mlp.experts.",
      "names": {
        "gate_proj.weight": "ffn_gate_exps.weight",
        "up_proj.weight":   "ffn_up_exps.weight",
        "down_proj.weight": "ffn_down_exps.weight"
      }
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

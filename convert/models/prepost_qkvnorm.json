{
  "gguf": ["gemma4"],
  "container": {
    "gemma4": {"revision": {"picture_bidir_sliding": "(src['embedding_length_per_layer_input'] | default(0)) == 0"},
               "flags": {"rope_neox": "true", "qk_norm": "true", "v_norm": "true", "dense_moe": "(src['expert_count'] | default(0)) > 0"},
               "router": {"gate": "softmax", "renormalise": "always", "unscaled": true, "ungrouped": true},
               "tensors": {
                 "drop": [{"tensor": "attn_k.weight", "if": "block >= block_count - (attention.shared_kv_layers ?? 0)"},
                         {"tensor": "attn_v.weight", "if": "block >= block_count - (attention.shared_kv_layers ?? 0)"},
                         {"tensor": "attn_k_norm.weight", "if": "block >= block_count - (attention.shared_kv_layers ?? 0)"}],
                 "block": {
                   "ffn_gate.weight": {"role": "ffn_gate_shexp.weight", "if": "(expert_count ?? 0) > 0"},
                   "ffn_up.weight": {"role": "ffn_up_shexp.weight", "if": "(expert_count ?? 0) > 0"},
                   "ffn_down.weight": {"role": "ffn_down_shexp.weight", "if": "(expert_count ?? 0) > 0"},
                   "ffn_gate_inp.scale": {"role": "ffn_gate_inp.scale", "if": "(expert_count ?? 0) > 0",
                                          "do": [{"map": "x * f32(1 / sqrt(embedding_length))"}]}
                 }
               },
               "activation": "gelu_pytorch_tanh", "embd_scale": "src['embedding_length'] ** 0.5", "attn_scale": "1",
               "final_softcap": "src['final_logit_softcapping'] | default(0)",
               "kv_shared": "src['attention.shared_kv_layers'] | default(0)",
               "ple_width": "src['embedding_length_per_layer_input'] | default(0)",
               "window": {"size": "src['attention.sliding_window']", "pattern": "0", "rope_base": "src['rope.freq_base_swa'] | default(10000)"},
               "whole_rotary": true, "value_key_width": true, "rope_freqs": true,
               "sliding": {"head_dim": "src['attention.key_length_swa']",
                           "value_dim": "src['attention.value_length_swa'] | default(src['attention.key_length_swa'])",
                           "rotary": "src['rope.dimension_count_swa'] | default(src['attention.key_length_swa'])"}}
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "in",         "if": "ple_dim > 0", "out": "ple", "width": "side_width"},
      {"op": "norm",       "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "if": "not kv_shared", "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "if": "not kv_shared and stored('attn_v')", "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "let",        "if": "not kv_shared and not stored('attn_v')", "in": "k", "out": "v"},
      {"op": "head_norm",  "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm",  "if": "not kv_shared", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at and not kv_shared", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "emit",       "if": "not kv_shared", "kind": "head_norm", "in": "v", "attr": {"Eps": "eps", "HeadDim": "head_dim"}, "outs": [{"name": "v.norm", "width": "kv_heads * head_dim"}], "out": "v"},
      {"op": "kv_append",  "if": "not kv_shared", "in": ["k", "v"], "out": "kv"},
      {"op": "kv_from",    "if": "kv_shared", "at": "kv_source", "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "norm",       "in": "o", "w": "post_attention_norm", "out": "o"},
      {"op": "add",        "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "let",        "in": "h", "out": "m"},
      {"op": "norm",       "if": "stored('ffn_norm')", "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act",        "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec",     "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark",       "if": "moe", "out": "routed"},
      {"op": "let",        "if": "moe", "in": "m", "out": "rin"},
      {"op": "let",        "if": "moe", "in": "m", "out": "ein"},
      {"op": "norm",       "if": "moe and stored('ffn_gate_inp.scale')", "in": "h", "w": "ffn_gate_inp.scale", "out": "rin"},
      {"op": "norm",       "if": "moe and stored('pre_ffw_norm_2')", "in": "h", "w": "pre_ffw_norm_2", "out": "ein"},
      {"op": "matvec",     "if": "moe", "in": "rin", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated",     "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "emit",       "if": "moe", "kind": "top_k", "in": "score", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit",       "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and stored('ffn_down_exps.scale')", "kind": "slice", "bind": [{"w": "ffn_down_exps.scale"}], "attr": {"Width": "experts"}, "outs": [{"name": "router.expscale", "width": "experts"}], "out": "es"},
      {"op": "emit",       "if": "moe and stored('ffn_down_exps.scale')", "kind": "take", "in": ["es", "sel"], "outs": [{"name": "router.expscale.sel", "width": "experts_used"}], "out": "es"},
      {"op": "emit",       "if": "moe and stored('ffn_down_exps.scale')", "kind": "map", "in": ["w", "es"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "router.expscaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe", "kind": "tile", "in": "ein", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "xin"},
      {"op": "emit",       "if": "moe and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["xin", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["xin", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act",        "if": "moe and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act",        "if": "moe and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit",       "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum",  "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed",     "if": "moe", "from": "routed"},
      {"op": "norm",       "if": "moe and stored('post_ffw_norm_2')", "in": "d", "w": "post_ffw_norm_2", "out": "d"},
      {"op": "matvec",     "if": "moe and stored('ffn_gate_shexp')", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec",     "if": "moe and stored('ffn_up_shexp')", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act",        "if": "moe and stored('ffn_gate_shexp')", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act",        "if": "moe and stored('ffn_up_shexp') and not stored('ffn_gate_shexp')", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec",     "if": "moe and stored('ffn_up_shexp')", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "norm",       "if": "moe and stored('ffn_up_shexp') and stored('post_ffw_norm_1')", "in": "so", "w": "post_ffw_norm_1", "out": "so"},
      {"op": "add",        "if": "moe and stored('ffn_up_shexp')", "in": ["d", "so"], "out": "d"},
      {"op": "norm",       "in": "d", "w": "post_ffw_norm", "out": "d"},
      {"op": "add",        "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "matvec",     "if": "ple_dim > 0", "in": "y", "w": "inp_gate", "rows": "ple_dim", "out": "pg"},
      {"op": "emit",       "if": "ple_dim > 0", "kind": "slice", "in": "ple", "attr": {"Offset": "deep_taps * embd + layer * ple_dim", "Width": "ple_dim"}, "outs": [{"name": "ple.in", "width": "ple_dim"}], "out": "pi"},
      {"op": "act",        "if": "ple_dim > 0", "name": "ple.act", "in": ["pg", "pi"], "width": "ple_dim", "out": "pa"},
      {"op": "matvec",     "if": "ple_dim > 0", "in": "pa", "w": "proj", "rows": "embd", "out": "po"},
      {"op": "norm",       "if": "ple_dim > 0", "in": "po", "w": "post_norm", "out": "po"},
      {"op": "add",        "if": "ple_dim > 0", "in": ["y", "po"], "out": "y"},
      {"op": "emit",       "if": "stored('layer_output_scale')", "kind": "map", "in": "y", "attr": {"Fn": "'mul'", "Width": "1"}, "bind": [{"w": "layer_output_scale", "k": "1"}], "outs": [{"name": "out.scaled", "width": "embd"}], "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

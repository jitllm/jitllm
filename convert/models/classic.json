{
  "gguf": ["phi2", "starcoder", "starcoder2", "stablelm", "falcon", "nemotron", "command-r", "cohere2", "dbrx", "phimoe", "bert", "nomic-bert", "modern-bert"],
  "graph": {
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "layer_norm", "if": "layer_norm and stored('attn_norm')", "in": "x", "w": ["attn_norm", "attn_norm.bias?"], "out": "n"},
      {"op": "norm", "if": "not layer_norm and stored('attn_norm')", "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "let", "if": "not stored('attn_norm')", "in": "x", "out": "n"},
      {"op": "matvec", "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec", "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "stated", "if": "qkv_act", "of": "qkv_act", "name": "q.act", "in": "q", "out": "q"},
      {"op": "stated", "if": "qkv_act", "of": "qkv_act", "name": "k.act", "in": "k", "out": "k"},
      {"op": "stated", "if": "qkv_act", "of": "qkv_act", "name": "v.act", "in": "v", "out": "v"},
      {"op": "rope", "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope", "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append", "in": ["k", "v"], "out": "kv"},
      {"op": "attend", "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "matvec", "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "add", "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "layer_norm", "if": "layer_norm and stored('attn_out_norm')", "in": "h", "w": ["attn_out_norm", "attn_out_norm.bias?"], "out": "h"},
      {"op": "norm", "if": "not layer_norm and stored('attn_out_norm')", "in": "h", "w": "attn_out_norm", "out": "h"},
      {"op": "layer_norm", "if": "not parallel and layer_norm and stored('ffn_norm')", "in": "h", "w": ["ffn_norm", "ffn_norm.bias?"], "out": "m"},
      {"op": "norm", "if": "not parallel and not layer_norm and stored('ffn_norm')", "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "let", "if": "not parallel and not stored('ffn_norm')", "in": "h", "out": "m"},
      {"op": "layer_norm", "if": "parallel and stored('ffn_norm')", "in": "x", "w": ["ffn_norm", "ffn_norm.bias?"], "out": "m"},
      {"op": "let", "if": "parallel and not stored('ffn_norm')", "in": "n", "out": "m"},
      {"op": "matvec", "if": "not moe and stored('ffn_gate')", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec", "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act", "if": "not moe and stored('ffn_gate')", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "act", "if": "not moe and not stored('ffn_gate')", "in": "u", "width": "ffn", "out": "a"},
      {"op": "matvec", "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark", "if": "moe", "out": "routed"},
      {"op": "matvec", "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated", "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let", "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit", "if": "moe", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "if": "moe and not router_weight", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and router_weight", "kind": "rank", "in": "choose", "outs": [{"name": "router.rank", "width": "experts", "elem": "u32"}], "out": "rank"},
      {"op": "emit", "if": "moe and router_weight", "kind": "take", "in": ["logits", "sel"], "outs": [{"name": "router.picked", "width": "experts_used"}], "out": "picked"},
      {"op": "each", "if": "moe and router_weight", "n": "experts_used", "as": "j", "name": "router.w", "out": "w", "steps": [
        {"op": "let", "if": "j == 0", "in": "logits", "out": "rest"},
        {"op": "emit", "if": "j > 0", "kind": "map", "in": "rank", "attr": {"Fn": "'less'", "Const": "j"}, "outs": [{"name": "router.earlier", "width": "experts"}], "out": "earlier"},
        {"op": "expr", "if": "j > 0", "name": "router.rest", "width": "experts", "in": ["earlier", "logits"], "terms": [{"fn": "where", "args": [{"in": 0}, {"const": "-inf"}, {"in": 1}]}], "out": "rest"},
        {"op": "emit", "kind": "slice", "in": "picked", "attr": {"Offset": "j", "Width": "1"}, "outs": [{"name": "router.pick", "width": "1"}], "out": "pick"},
        {"op": "stated", "of": "router_weight", "name": "router.weight", "in": ["rest", "pick"], "width": "experts", "out": "row"},
        {"op": "emit", "kind": "take", "in": ["row", "sel"], "outs": [{"name": "router.row", "width": "experts_used"}], "out": "row"},
        {"op": "emit", "kind": "slice", "in": "row", "attr": {"Offset": "j", "Width": "1"}, "outs": [{"name": "router.w", "width": "1"}], "out": "w"}
      ]},
      {"op": "emit", "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit", "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum", "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "if": "moe", "from": "routed"},
      {"op": "add", "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "layer_norm", "if": "layer_norm and stored('layer_out_norm')", "in": "y", "w": ["layer_out_norm", "layer_out_norm.bias?"], "out": "y"},
      {"op": "norm", "if": "not layer_norm and stored('layer_out_norm')", "in": "y", "w": "layer_out_norm", "out": "y"},
      {"op": "out", "in": "y"}
    ]
  }
}

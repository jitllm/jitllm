{
  "gguf": ["mamba2", "granitehybrid", "nemotron_h", "nemotron_h_moe", "falcon-h1"],
  "container": {
    "mamba2": {"flags": {"no_pos_enc": "true"}, "recurrent": {"conv_kernel": "src['ssm.conv_kernel'] | default(0)", "groups": "src['ssm.group_count'] | default(1)", "inner": "src['ssm.inner_size'] | default(0)", "state_size": "src['ssm.state_size'] | default(0)", "heads_v": "src['ssm.time_step_rank'] | default(0)"}, "layers": [{"tensors": ["ssm_conv1d.weight"], "kind": "ssd"}, {"tensors": ["ssm_conv1d.weight", "attn_q.weight"], "kind": "ssd_attention"}]},
    "granitehybrid": {"logit_div": "src['logit_scale']", "embd_scale": "src['embedding_scale'] | default(1)",
                      "residual_scale": "src['residual_scale'] | default(0)",
                      "flags": {"no_pos_enc": "not (src['rope.scaling.finetuned'] | default(true))"},
                      "recurrent": {"conv_kernel": "src['ssm.conv_kernel'] | default(0)", "groups": "src['ssm.group_count'] | default(1)", "inner": "src['ssm.inner_size'] | default(0)", "state_size": "src['ssm.state_size'] | default(0)", "heads_v": "src['ssm.time_step_rank'] | default(0)"}, "layers": [{"tensors": ["ssm_conv1d.weight"], "kind": "ssd"}, {"tensors": ["ssm_conv1d.weight", "attn_q.weight"], "kind": "ssd_attention"}]},
    "nemotron_h": {"merge_mixers": true, "layers": [{"tensors": ["ssm_conv1d.weight"], "kind": "ssd"}], "flags": {"no_pos_enc": "true"}, "activation": "relu2", "recurrent": {"conv_kernel": "src['ssm.conv_kernel'] | default(0)", "groups": "src['ssm.group_count'] | default(1)", "inner": "src['ssm.inner_size'] | default(0)", "state_size": "src['ssm.state_size'] | default(0)", "heads_v": "src['ssm.time_step_rank'] | default(0)"}},
    "nemotron_h_moe": {"merge_mixers": true, "layers": [{"tensors": ["ssm_conv1d.weight"], "kind": "ssd"}], "flags": {"no_pos_enc": "true"}, "activation": "relu2",
                       "router": {"gate": "sigmoid", "ungrouped": true}, "recurrent": {"conv_kernel": "src['ssm.conv_kernel'] | default(0)", "groups": "src['ssm.group_count'] | default(1)", "inner": "src['ssm.inner_size'] | default(0)", "state_size": "src['ssm.state_size'] | default(0)", "heads_v": "src['ssm.time_step_rank'] | default(0)"}},
    "falcon-h1": {"flags": {"rope_neox": "true"}, "recurrent": {"conv_kernel": "src['ssm.conv_kernel'] | default(0)", "groups": "src['ssm.group_count'] | default(1)", "inner": "src['ssm.inner_size'] | default(0)", "state_size": "src['ssm.state_size'] | default(0)", "heads_v": "src['ssm.time_step_rank'] | default(0)"}, "layers": [{"tensors": ["ssm_conv1d.weight"], "kind": "ssd"}, {"tensors": ["ssm_conv1d.weight", "attn_q.weight"], "kind": "ssd_attention"}]}
  },
  "graph": {
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "norm", "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec", "in": "n", "w": "attn_qkv", "rows": "chans", "out": "mixed", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "matvec", "in": "n", "w": "attn_gate", "rows": "v_heads * v_dim", "out": "z", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "matvec", "in": "n", "w": "ssm_ba", "rows": "v_heads", "out": "dtraw", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "state_conv", "in": "mixed", "attr": {"Taps": "conv"}, "advances": ["rec.conv"], "bind": [{"w": "ssm_conv1d", "k": "conv", "rows": "chans"}], "outs": [{"name": "conv", "width": "chans"}], "out": "conv", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "if": "(kind == 'ssd' or kind == 'ssd+attn') and (stored('ssm_conv1d.bias'))", "kind": "map", "in": "conv", "attr": {"Fn": "'add'"}, "bind": [{"w": "ssm_conv1d.bias"}], "outs": [{"name": "conv.biased", "width": "chans"}], "out": "conv"},
      {"op": "silu", "name": "conv.act", "in": "conv", "out": "act", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "0", "Width": "k_heads * k_dim"}, "outs": [{"name": "c", "width": "k_heads * k_dim"}], "out": "cq", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "k_heads * k_dim", "Width": "k_heads * k_dim"}, "outs": [{"name": "b", "width": "k_heads * k_dim"}], "out": "bk", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "2 * k_heads * k_dim", "Width": "v_heads * v_dim"}, "outs": [{"name": "x", "width": "v_heads * v_dim"}], "out": "xs", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "map", "in": "dtraw", "attr": {"Fn": "'add'"}, "bind": [{"w": "ssm_dt.bias"}], "outs": [{"name": "dt.biased", "width": "v_heads"}], "out": "dt", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "map", "in": "dt", "attr": {"Fn": "'softplus'"}, "outs": [{"name": "dt", "width": "v_heads"}], "out": "dt", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "map", "in": "dt", "attr": {"Fn": "'mul'"}, "bind": [{"w": "ssm_a"}], "outs": [{"name": "decay.a", "width": "v_heads"}], "out": "da", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "map", "in": "da", "attr": {"Fn": "'exp'"}, "outs": [{"name": "decay", "width": "v_heads"}], "out": "decay", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "state_scan", "in": ["cq", "bk", "xs", "decay", "dt"], "advances": ["rec.state"], "attr": {"NHead": "v_heads", "NKVHead": "k_heads", "HeadDim": "k_dim", "Update": "3"}, "axes": ["'group col'", "'group col'", "'head row'", "'head'", "'head'"], "terms": [{"fn": "mul", "args": [{"state": true}, {"in": 3}]}, {"fn": "mul", "args": [{"in": 2}, {"in": 4}]}, {"fn": "mul", "args": [{"in": 1}, {"term": 1}]}, {"fn": "add", "args": [{"term": 0}, {"term": 2}]}, {"fn": "mul", "args": [{"term": 3}, {"in": 0}]}], "outs": [{"name": "ssm.y", "width": "v_heads * v_dim"}], "out": "y", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "kind": "map", "in": "xs", "attr": {"Fn": "'mul'"}, "bind": [{"w": "ssm_d"}], "outs": [{"name": "ssm.skip", "width": "v_heads * v_dim"}], "out": "skip", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "add", "in": ["y", "skip"], "out": "y", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "silu_gated", "name": "gated", "in": ["z", "y"], "out": "g", "if": "kind == 'ssd' or kind == 'ssd+attn'"},
      {"op": "emit", "if": "(kind == 'ssd' or kind == 'ssd+attn') and (stored('ssm_norm'))", "kind": "head_norm", "in": "g", "attr": {"Eps": "eps", "HeadDim": "v_heads * v_dim // norm_groups"}, "outs": [{"name": "ssm.norm", "width": "v_heads * v_dim"}], "out": "u"},
      {"op": "emit", "if": "(kind == 'ssd' or kind == 'ssd+attn') and (stored('ssm_norm'))", "kind": "map", "in": "u", "attr": {"Fn": "'mul'"}, "bind": [{"w": "ssm_norm"}], "outs": [{"name": "ssm.normed", "width": "v_heads * v_dim"}], "out": "g"},
      {"op": "matvec", "if": "(kind == 'ssd' or kind == 'ssd+attn') and (kind == 'ssd')", "in": "g", "w": ["ssm_out", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "matvec", "if": "(kind == 'ssd' or kind == 'ssd+attn') and (kind == 'ssd+attn')", "in": "g", "w": "ssm_out", "rows": "embd", "out": "so"},
      {"op": "matvec", "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "matvec", "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "matvec", "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "head_norm", "if": "(kind == 'full' or kind == 'ssd+attn') and (stored('attn_q_norm'))", "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm", "if": "(kind == 'full' or kind == 'ssd+attn') and (stored('attn_k_norm'))", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope", "if": "(kind == 'full' or kind == 'ssd+attn') and (rope_at)", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope", "if": "(kind == 'full' or kind == 'ssd+attn') and (rope_at)", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append", "in": ["k", "v"], "out": "kv", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "attend", "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "matvec", "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o", "if": "kind == 'full' or kind == 'ssd+attn'"},
      {"op": "add", "if": "kind == 'ssd+attn'", "in": ["o", "so"], "out": "o"},
      {"op": "add", "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "let", "in": "h", "out": "y"},
      {"op": "norm", "if": "moe or stored('ffn_up')", "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec", "if": "(not moe and stored('ffn_up')) and (stored('ffn_gate'))", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u", "if": "not moe and stored('ffn_up')"},
      {"op": "act", "if": "(not moe and stored('ffn_up')) and (stored('ffn_gate'))", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "act", "if": "(not moe and stored('ffn_up')) and (not stored('ffn_gate'))", "in": "u", "width": "ffn", "out": "a"},
      {"op": "matvec", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d", "if": "not moe and stored('ffn_up')"},
      {"op": "mark", "if": "moe", "out": "routed"},
      {"op": "matvec", "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated", "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let", "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit", "if": "moe and stored('exp_probs_b.bias')", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "top_k", "in": "choose", "attr": {"TopK": "[2, experts // expert_groups] | min", "Span": "experts // expert_groups"}, "outs": [{"name": "router.group.sel", "width": "expert_groups * ([2, experts // expert_groups] | min)", "elem": "u32"}, {"name": "router.group.best", "width": "expert_groups * ([2, experts // expert_groups] | min)", "as": "gbest"}]},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "reduce", "in": "gbest", "attr": {"Fn": "'add'", "Span": "[2, experts // expert_groups] | min"}, "outs": [{"name": "router.group.score", "width": "expert_groups"}], "out": "gscore"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "rank", "in": "gscore", "outs": [{"name": "router.group.rank", "width": "expert_groups", "elem": "u32"}], "out": "grank"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": "grank", "attr": {"Fn": "'less'", "Const": "expert_groups_used"}, "outs": [{"name": "router.group.kept", "width": "expert_groups"}], "out": "gkept"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": ["gkept", "choose"], "attr": {"Fn": "'where'", "Const": "-inf"}, "outs": [{"name": "router.kept", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit", "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum", "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "if": "moe", "from": "routed"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and not stored('ffn_gate_shexp'))", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "add", "if": "(stored('ffn_up_shexp')) and (moe)", "in": ["d", "so"], "out": "d"},
      {"op": "add", "if": "moe or stored('ffn_up')", "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out", "in": "y"}
    ]
  }
}

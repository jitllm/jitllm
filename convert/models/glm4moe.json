{
  "classes": ["Glm4MoeForCausalLM"],
  "config": {
    "arch": "glm4moe",
    "keys": {
      "block_count":                      {"uint": "(num_hidden_layers ?? 46) + (num_nextn_predict_layers ?? 1)"},
      "nextn_predict_layers":             {"uint": "num_nextn_predict_layers ?? 1"},
      "context_length":                   {"uint": "max_position_embeddings ?? 131072"},
      "embedding_length":                 {"uint": "hidden_size ?? 4096"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 10944"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 96"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? 8"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 96)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 96)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.dimension_count":             {"uint": "(head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 96)) * (rope_parameters.partial_rotary_factor ?? partial_rotary_factor ?? 0.5)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"},
      "expert_count":                     {"uint": "n_routed_experts ?? 128"},
      "expert_used_count":                {"uint": "num_experts_per_tok ?? 8"},
      "expert_feed_forward_length":       {"uint": "moe_intermediate_size ?? 1408"},
      "expert_shared_count":              {"uint": "n_shared_experts ?? 1"},
      "leading_dense_block_count":        {"uint": "first_k_dense_replace ?? 1"},
      "expert_weights_norm":              {"bool": "norm_topk_prob ?? true"},
      "expert_weights_scale":             {"float": "routed_scaling_factor ?? 1"},
      "expert_group_count":               {"uint": "n_group ?? 1"},
      "expert_group_used_count":          {"uint": "topk_group ?? 1"}
    },
    "vocab": "vocab_size ?? 151552",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "use_sliding_window ?? true"},
    "gating": "sigmoid"
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":              "attn_norm.weight",
      "post_attention_layernorm.weight":     "ffn_norm.weight",
      "self_attn.q_proj.weight":             "attn_q.weight",
      "self_attn.k_proj.weight":             "attn_k.weight",
      "self_attn.v_proj.weight":             "attn_v.weight",
      "self_attn.o_proj.weight":             "attn_output.weight",
      "self_attn.q_proj.bias":               "attn_q.bias",
      "self_attn.k_proj.bias":               "attn_k.bias",
      "self_attn.v_proj.bias":               "attn_v.bias",
      "self_attn.o_proj.bias":               "attn_output.bias",
      "self_attn.q_norm.weight":             "attn_q_norm.weight",
      "self_attn.k_norm.weight":             "attn_k_norm.weight",
      "mlp.gate_proj.weight":                "ffn_gate.weight",
      "mlp.up_proj.weight":                  "ffn_up.weight",
      "mlp.down_proj.weight":                "ffn_down.weight",
      "mlp.gate.weight":                     "ffn_gate_inp.weight",
      "mlp.gate.e_score_correction_bias":    "exp_probs_b.bias",
      "mlp.shared_experts.gate_proj.weight": "ffn_gate_shexp.weight",
      "mlp.shared_experts.up_proj.weight":   "ffn_up_shexp.weight",
      "mlp.shared_experts.down_proj.weight": "ffn_down_shexp.weight",
      "eh_proj.weight":                      "nextn.eh_proj.weight",
      "enorm.weight":                        "nextn.enorm.weight",
      "hnorm.weight":                        "nextn.hnorm.weight",
      "shared_head.norm.weight":             "nextn.shared_head_norm.weight",
      "shared_head.head.weight":             "nextn.shared_head_head.weight",
      "embed_tokens.weight":                 "nextn.embed_tokens.weight"
    },
    "experts": {
      "prefix": "mlp.experts.",
      "names": {
        "gate_proj.weight": "ffn_gate_exps.weight",
        "up_proj.weight":   "ffn_up_exps.weight",
        "down_proj.weight": "ffn_down_exps.weight"
      }
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

{
  "classes": ["MixtralForCausalLM"],
  "gguf": ["llama", "granite", "granitemoe", "llama4", "mistral3", "minimax-m2", "hunyuan-dense", "hunyuan-moe", "gpt-oss", "bitnet-b1.58", "minimax-m3", "hunyuan_vl"],
  "container": {
    "gpt-oss": {"flags": {"rope_neox": "true", "swiglu_oai": "true", "yarn_exact": "true"},
                "window": {"size": "src['attention.sliding_window']", "period": "2"}},
    "bitnet-b1.58": {"flags": {"rope_neox": "true"}, "activation": "relu2"},
    "granite": {"logit_div": "src['logit_scale']", "embd_scale": "src['embedding_scale'] | default(1)",
                "residual_scale": "src['residual_scale'] | default(0)", "requires": ["logit_scale"],
                "flags": {"no_rotary": "not (src['rope.scaling.finetuned'] | default(true))"}},
    "granitemoe": {"logit_div": "src['logit_scale']", "embd_scale": "src['embedding_scale'] | default(1)",
                   "residual_scale": "src['residual_scale'] | default(0)", "requires": ["logit_scale"],
                   "flags": {"no_rotary": "not (src['rope.scaling.finetuned'] | default(true))"}},
    "llama4": {"flags": {"swa_chunked": "true", "no_pe_global": "true", "expert_weight_in": "true",
                         "qk_l2_norm": "(src['expert_count'] | default(0)) != 128",
                         "all_global": "src['attention.sliding_window'] is defined and src['attention.sliding_window'] == 0"},
               "window": {"size": "src['attention.chunk_size'] | default(8192)", "pattern": "4"},
               "attn_temp": {"scale": "src['attention.temperature_scale'] | default(0.1)",
                             "floor": "src['attention.temperature_length'] | default(8192)", "offset": "1"},
               "router": {"gate": "sigmoid", "renormalise": "never"},
               "moe_step": "src['interleave_moe_layer_step'] | default(1)"},
    "minimax-m2": {"flags": {"rope_neox": "true", "qk_norm": "true", "qk_norm_wide": "true"},
                   "router": {"gate": "sigmoid", "renormalise": "always"},
                   "requires": ["expert_count", "blk.*.exp_probs_b.bias"],
                   "lacks": ["expert_shared_count", "leading_dense_block_count"]},
    "hunyuan-dense": {"flags": {"rope_neox": "true", "qk_norm": "true", "qk_norm_post_rope": "true"}, "router": {"gate": "softmax", "renormalise": "always", "unscaled": true}},
    "hunyuan-moe": {"flags": {"rope_neox": "true", "qk_norm": "true", "qk_norm_post_rope": "true"}, "router": {"gate": "softmax", "renormalise": "always", "unscaled": true}},
    "hunyuan_vl": {"flags": {"rope_neox": "true", "qk_norm": "true", "qk_norm_post_rope": "true"}, "router": {"gate": "softmax", "renormalise": "always", "unscaled": true}, "mrope": "true", "whole_rotary": true,
                   "rope_base": "(src['rope.freq_base'] | default(10000)) * src['rope.scaling.alpha'] ** ((src['rope.dimension_count'] | default(src['attention.key_length'] | default(src['embedding_length'] // src['attention.head_count']))) / ((src['rope.dimension_count'] | default(src['attention.key_length'] | default(src['embedding_length'] // src['attention.head_count']))) - 2)) if (src['rope.scaling.alpha'] | default(0)) > 0 else src['rope.freq_base'] | default(10000)"}
  },
  "config": {
    "defaults": {"num_key_value_heads": 8},
    "arch": "llama",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 32"},
      "context_length":                   {"uint": "max_position_embeddings ?? 131072"},
      "embedding_length":                 {"uint": "hidden_size ?? 4096"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 14336"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 32)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 1000000"},
      "expert_count":                     {"uint": "num_local_experts ?? num_experts ?? 8"},
      "expert_used_count":                {"uint": "num_experts_per_tok ?? 2"},
      "expert_feed_forward_length":       {"uint": "intermediate_size ?? 14336"},
      "expert_weights_norm":              {"bool": "true"}
    },
    "vocab": "vocab_size ?? 32000",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "true", "layers": {}}
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight": {"role": "attn_q.weight", "do": [
        {"reshape": ["num_attention_heads ?? 32", 2, "(head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) / 2", "hidden_size ?? 4096"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_attention_heads ?? 32) * (head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32))", "hidden_size ?? 4096"]}]},
      "self_attn.k_proj.weight": {"role": "attn_k.weight", "do": [
        {"reshape": ["num_key_value_heads ?? (num_attention_heads ?? 32)", 2, "(head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) / 2", "hidden_size ?? 4096"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_key_value_heads ?? (num_attention_heads ?? 32)) * (head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32))", "hidden_size ?? 4096"]}]},
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "block_sparse_moe.gate.weight":    "ffn_gate_inp.weight"
    },
    "experts": {
      "prefix": "block_sparse_moe.experts.",
      "names": {
        "w1.weight": "ffn_gate_exps.weight",
        "w3.weight": "ffn_up_exps.weight",
        "w2.weight": "ffn_down_exps.weight"
      }
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "norm",       "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q", "int8": "token_act"},
      {"op": "matvec",     "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k", "int8": "token_act"},
      {"op": "matvec",     "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v", "int8": "token_act"},
      {"op": "norm",       "if": "qk_norm and qk_norm_wide", "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "norm",       "if": "qk_norm and qk_norm_wide", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "head_norm",  "if": "qk_norm and not qk_norm_wide and not qk_norm_post", "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm",  "if": "qk_norm and not qk_norm_wide and not (qk_norm_post and not rope_keeps_rms and rope_at)", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "emit",       "if": "rope_at and qk_l2", "kind": "head_norm", "in": "q", "attr": {"Eps": "eps", "HeadDim": "head_dim"}, "outs": [{"name": "q.l2", "width": "heads * head_dim"}], "out": "q"},
      {"op": "emit",       "if": "rope_at and qk_l2", "kind": "head_norm", "in": "k", "attr": {"Eps": "eps", "HeadDim": "head_dim"}, "outs": [{"name": "k.l2", "width": "kv_heads * head_dim"}], "out": "k"},
      {"op": "head_norm",  "if": "qk_norm and qk_norm_post", "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm",  "if": "qk_norm and qk_norm_post and not rope_keeps_rms and rope_at", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "emit",       "if": "temp_scale != 0 and not (nope_global and rope_at) and temp_offset >= 0 and temp_offset == temp_offset|int", "kind": "position", "attr": {"Offset": "temp_offset|int", "Span": "temp_floor"}, "outs": [{"name": "pos", "width": "1"}], "out": "pos"},
      {"op": "expr",       "if": "temp_scale != 0 and not (nope_global and rope_at) and temp_offset >= 0 and temp_offset == temp_offset|int", "name": "temp", "in": "pos", "width": "1", "terms": [
        {"fn": "add", "args": [{"in": 0}, {"const": "1"}]},
        {"fn": "log", "args": [{"term": 0}]},
        {"fn": "fma", "args": [{"term": 1}, {"const": "temp_scale"}, {"const": "1"}]}], "out": "t"},
      {"op": "emit",       "if": "temp_scale != 0 and not (nope_global and rope_at) and not (temp_offset >= 0 and temp_offset == temp_offset|int)", "kind": "position", "outs": [{"name": "pos", "width": "1"}], "out": "pos"},
      {"op": "expr",       "if": "temp_scale != 0 and not (nope_global and rope_at) and not (temp_offset >= 0 and temp_offset == temp_offset|int)", "name": "temp", "in": "pos", "width": "1", "terms": [
        {"fn": "add", "args": [{"in": 0}, {"const": "temp_offset"}]},
        {"fn": "div", "args": [{"term": 0}, {"const": "temp_floor"}]},
        {"fn": "round", "args": [{"term": 1}]},
        {"fn": "less", "args": [{"term": 1}, {"term": 2}]},
        {"fn": "sub", "args": [{"term": 2}, {"term": 3}]},
        {"fn": "add", "args": [{"term": 4}, {"const": "1"}]},
        {"fn": "log", "args": [{"term": 5}]},
        {"fn": "fma", "args": [{"term": 6}, {"const": "temp_scale"}, {"const": "1"}]}], "out": "t"},
      {"op": "emit",       "if": "temp_scale != 0 and not (nope_global and rope_at)", "kind": "map", "in": ["q", "t"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "q.temp", "width": "heads * head_dim"}], "out": "q"},
      {"op": "indexer", "if": "selects", "in": ["n", "n"], "out": "ix"},
      {"op": "emit", "if": "selects", "kind": "concat", "in": ["k", "ix.key"], "outs": [{"name": "k.row", "width": "kv_heads * head_dim + key_width"}], "out": "k"},
      {"op": "emit", "if": "selects", "kind": "map", "in": "ix.key", "attr": {"Fn": "'mul'"}, "outs": [{"name": "v.pad", "width": "key_width"}], "out": "vpad"},
      {"op": "emit", "if": "selects", "kind": "concat", "in": ["v", "vpad"], "outs": [{"name": "v.row", "width": "kv_heads * head_dim + key_width"}], "out": "v"},
      {"op": "kv_append", "in": ["k", "v"], "out": "kv"},
      {"op": "select", "if": "selects and select_weighted", "in": ["ix.query", "ix.weight"], "hist": "kv", "attr": {"Offset": "kv_heads * head_dim", "Width": "kv_heads * head_dim + key_width"}, "out": "sel"},
      {"op": "select", "if": "selects and not select_weighted", "in": "ix.query", "hist": "kv", "attr": {"Offset": "kv_heads * head_dim", "Width": "kv_heads * head_dim + key_width"}, "out": "sel"},
      {"op": "attend", "if": "not selects", "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "attend", "if": "selects", "in": ["q", "sel"], "hist": "kv", "w": "attn_sinks?", "attr": {"Width": "kv_heads * head_dim + key_width"}, "out": "att"},
      {"op": "norm",       "if": "stored('attn_sub_norm')", "in": "att", "w": "attn_sub_norm", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o", "int8": "token_act"},
      {"op": "add",        "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "norm",       "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g", "int8": "token_act"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u", "int8": "token_act"},
      {"op": "act",        "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "norm",       "if": "not moe and stored('ffn_sub_norm')", "in": "a", "w": "ffn_sub_norm", "out": "a"},
      {"op": "matvec",     "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d", "int8": "token_act"},
      {"op": "mark",       "if": "moe", "out": "routed"},
      {"op": "matvec",     "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated",     "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let",        "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit",       "if": "moe and stored('exp_probs_b.bias')", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit",       "if": "moe and expert_groups > 1", "kind": "top_k", "in": "choose", "attr": {"TopK": "[2, experts // expert_groups] | min", "Span": "experts // expert_groups"}, "outs": [{"name": "router.group.sel", "width": "expert_groups * ([2, experts // expert_groups] | min)", "elem": "u32"}, {"name": "router.group.best", "width": "expert_groups * ([2, experts // expert_groups] | min)", "as": "gbest"}]},
      {"op": "emit",       "if": "moe and expert_groups > 1", "kind": "reduce", "in": "gbest", "attr": {"Fn": "'add'", "Span": "[2, experts // expert_groups] | min"}, "outs": [{"name": "router.group.score", "width": "expert_groups"}], "out": "gscore"},
      {"op": "emit",       "if": "moe and expert_groups > 1", "kind": "rank", "in": "gscore", "outs": [{"name": "router.group.rank", "width": "expert_groups", "elem": "u32"}], "out": "grank"},
      {"op": "emit",       "if": "moe and expert_groups > 1", "kind": "map", "in": "grank", "attr": {"Fn": "'less'", "Const": "expert_groups_used"}, "outs": [{"name": "router.group.kept", "width": "expert_groups"}], "out": "gkept"},
      {"op": "emit",       "if": "moe and expert_groups > 1", "kind": "map", "in": ["gkept", "choose"], "attr": {"Fn": "'where'", "Const": "-inf"}, "outs": [{"name": "router.kept", "width": "experts"}], "out": "choose"},
      {"op": "emit",       "if": "moe", "kind": "top_k", "in": "choose","attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit",       "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "emit",       "if": "moe and expert_weight_in and stored('ffn_gate_exps')", "kind": "map", "in": ["eg", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.in.weighted", "width": "experts_used * rows('ffn_up_exps')"}], "out": "eg"},
      {"op": "emit",       "if": "moe and expert_weight_in", "kind": "map", "in": ["eu", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.in.weighted", "width": "experts_used * rows('ffn_up_exps')"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit",       "if": "moe and not expert_weight_in", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum",  "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed",     "if": "moe", "from": "routed"},
      {"op": "matvec",     "if": "moe and stored('ffn_gate_shexp')", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec",     "if": "moe and stored('ffn_up_shexp')", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act",        "if": "moe and stored('ffn_gate_shexp')", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act",        "if": "moe and stored('ffn_up_shexp') and not stored('ffn_gate_shexp')", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec",     "if": "moe and stored('ffn_up_shexp')", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "add",        "if": "moe and stored('ffn_up_shexp')", "in": ["d", "so"], "out": "d"},
      {"op": "add",        "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

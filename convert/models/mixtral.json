{
  "classes": ["MixtralForCausalLM"],
  "config": {
    "defaults": {"num_key_value_heads": 8},
    "arch": "llama",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 32"},
      "context_length":                   {"uint": "max_position_embeddings ?? 131072"},
      "embedding_length":                 {"uint": "hidden_size ?? 4096"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 14336"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 32)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 1000000"},
      "expert_count":                     {"uint": "num_local_experts ?? num_experts ?? 8"},
      "expert_used_count":                {"uint": "num_experts_per_tok ?? 2"},
      "expert_feed_forward_length":       {"uint": "intermediate_size ?? 14336"},
      "expert_weights_norm":              {"bool": "true"}
    },
    "vocab": "vocab_size ?? 32000",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "true"}
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight": {"role": "attn_q.weight", "do": [
        {"reshape": ["num_attention_heads ?? 32", 2, "(head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) / 2", "hidden_size ?? 4096"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_attention_heads ?? 32) * (head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32))", "hidden_size ?? 4096"]}]},
      "self_attn.k_proj.weight": {"role": "attn_k.weight", "do": [
        {"reshape": ["num_key_value_heads ?? (num_attention_heads ?? 32)", 2, "(head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)) / 2", "hidden_size ?? 4096"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_key_value_heads ?? (num_attention_heads ?? 32)) * (head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32))", "hidden_size ?? 4096"]}]},
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "block_sparse_moe.gate.weight":    "ffn_gate_inp.weight"
    },
    "experts": {
      "prefix": "block_sparse_moe.experts.",
      "names": {
        "w1.weight": "ffn_gate_exps.weight",
        "w3.weight": "ffn_up_exps.weight",
        "w2.weight": "ffn_down_exps.weight"
      }
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

{
  "describe": {"OPTForCausalLM": "OPT 125M to 66B with pre-norm blocks (safetensors only)"},
  "classes": ["OPTForCausalLM"],
  "container": {
    "opt": {"flags": {"layer_norm": "true", "no_pos_enc": "true"},
            "norm_eps": "src['attention.layer_norm_epsilon'] | default(1e-5)",
            "learned_positions": "true", "ffn_ungated": "true"}
  },
  "config": {
    "arch": "opt",
    "keys": {
      "block_count":                  {"uint": "num_hidden_layers ?? 12"},
      "context_length":               {"uint": "max_position_embeddings ?? 2048"},
      "embedding_length":             {"uint": "hidden_size ?? 768"},
      "feed_forward_length":          {"uint": "ffn_dim ?? 3072"},
      "attention.head_count":         {"uint": "num_attention_heads ?? 12"},
      "attention.head_count_kv":      {"uint": "num_attention_heads ?? 12"},
      "attention.key_length":         {"uint": "(hidden_size ?? 768) / (num_attention_heads ?? 12)"},
      "attention.value_length":       {"uint": "(hidden_size ?? 768) / (num_attention_heads ?? 12)"},
      "attention.layer_norm_epsilon": {"float": "1e-5"}
    },
    "vocab": "vocab_size ?? 50272",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? true"},
    "require": [
      {"that": "do_layer_norm_before ?? true",
       "else": "do_layer_norm_before is false: the block this file states normalises before attention and MLP"},
      {"that": "(word_embed_proj_dim ?? (hidden_size ?? 768)) == (hidden_size ?? 768)",
       "else": "word_embed_proj_dim differs from hidden_size: the embedding's projections in and out are not stated"},
      {"that": "(activation_function ?? 'relu') == 'relu'",
       "else": "activation_function is not relu: the block this file states computes a ReLU"},
      {"that": "enable_bias ?? true",
       "else": "enable_bias is false: the block this file states reads its projections' biases"},
      {"that": "layer_norm_elementwise_affine ?? true",
       "else": "layer_norm_elementwise_affine is false: the block this file states reads its norms' weights and biases"},
      {"that": "(_remove_final_layer_norm ?? false) == false",
       "else": "_remove_final_layer_norm is true: the head this file states reads the final norm"}
    ]
  },
  "tensors": {
    "block_prefix": "model.decoder.layers.",
    "model": {
      "model.decoder.embed_tokens.weight":    "token_embd.weight",
      "model.decoder.embed_positions.weight": {"role": "position_embd.weight", "do": [{"slice": [0, 2, "max_position_embeddings ?? 2048"]}]},
      "model.decoder.final_layer_norm.weight": "output_norm.weight",
      "model.decoder.final_layer_norm.bias":   "output_norm.bias",
      "lm_head.weight":                        "output.weight"
    },
    "block": {
      "self_attn_layer_norm.weight": "attn_norm.weight",
      "self_attn_layer_norm.bias":   "attn_norm.bias",
      "final_layer_norm.weight":     "ffn_norm.weight",
      "final_layer_norm.bias":       "ffn_norm.bias",
      "self_attn.q_proj.weight":     "attn_q.weight",
      "self_attn.q_proj.bias":       "attn_q.bias",
      "self_attn.k_proj.weight":     "attn_k.weight",
      "self_attn.k_proj.bias":       "attn_k.bias",
      "self_attn.v_proj.weight":     "attn_v.weight",
      "self_attn.v_proj.bias":       "attn_v.bias",
      "self_attn.out_proj.weight":   "attn_output.weight",
      "self_attn.out_proj.bias":     "attn_output.bias",
      "fc1.weight":                  "ffn_up.weight",
      "fc1.bias":                    "ffn_up.bias",
      "fc2.weight":                  "ffn_down.weight",
      "fc2.bias":                    "ffn_down.bias"
    }
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "layer_norm", "in": "x", "w": ["attn_norm", "attn_norm.bias"], "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "n", "w": ["attn_k", "attn_k.bias"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "n", "w": ["attn_v", "attn_v.bias"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias"], "rows": "embd", "out": "o"},
      {"op": "add",        "in": ["x", "o"], "out": "h"},
      {"op": "layer_norm", "in": "h", "w": ["ffn_norm", "ffn_norm.bias"], "out": "m"},
      {"op": "matvec",     "in": "m", "w": ["ffn_up", "ffn_up.bias"], "rows": "ffn", "out": "u"},
      {"op": "expr",       "name": "relu", "width": "ffn", "in": ["u"], "terms": [
        {"fn": "max", "args": [{"in": 0}, {"const": "0"}]}], "out": "a"},
      {"op": "matvec",     "in": "a", "w": ["ffn_down", "ffn_down.bias"], "rows": "embd", "out": "d"},
      {"op": "add",        "in": ["h", "d"], "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

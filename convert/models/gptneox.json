{
  "describe": {"GPTNeoXForCausalLM": "Pythia, GPT-NeoX-20B (safetensors only)"},
  "classes": ["GPTNeoXForCausalLM"],
  "container": {
    "gptneox": {"flags": {"layer_norm": "true", "rope_neox": "true", "parallel": "true"},
                "norm_eps": "src['attention.layer_norm_epsilon'] | default(1e-5)"}
  },
  "config": {
    "arch": "gptneox",
    "keys": {
      "block_count":                  {"uint": "num_hidden_layers ?? 44"},
      "context_length":               {"uint": "max_position_embeddings ?? 2048"},
      "embedding_length":             {"uint": "hidden_size ?? 6144"},
      "feed_forward_length":          {"uint": "intermediate_size ?? 24576"},
      "attention.head_count":         {"uint": "num_attention_heads ?? 64"},
      "attention.head_count_kv":      {"uint": "num_attention_heads ?? 64"},
      "attention.key_length":         {"uint": "(hidden_size ?? 6144) / (num_attention_heads ?? 64)"},
      "attention.value_length":       {"uint": "(hidden_size ?? 6144) / (num_attention_heads ?? 64)"},
      "attention.layer_norm_epsilon": {"float": "layer_norm_eps ?? 1e-5"},
      "rope.dimension_count":         {"uint": "(hidden_size ?? 6144) / (num_attention_heads ?? 64) * (rope_parameters.partial_rotary_factor ?? 0.25)"},
      "rope.freq_base":               {"float": "rope_parameters.rope_theta ?? 10000"}
    },
    "vocab": "vocab_size ?? 50432",
    "head": {"tensor": "embed_out.weight", "tied": "tie_word_embeddings ?? false"},
    "rope_scaling": "rope_parameters",
    "require": [
      {"that": "use_parallel_residual ?? true",
       "else": "use_parallel_residual is false: the block this file states adds attention and MLP in parallel"},
      {"that": "(hidden_act ?? 'gelu') == 'gelu'",
       "else": "hidden_act is not gelu: the block this file states computes the erf GELU"},
      {"that": "attention_bias ?? true",
       "else": "attention_bias is false: the block this file states reads the attention's biases"}
    ]
  },
  "tensors": {
    "block_prefix": "gpt_neox.layers.",
    "model": {
      "gpt_neox.embed_in.weight":          "token_embd.weight",
      "gpt_neox.final_layer_norm.weight":  "output_norm.weight",
      "gpt_neox.final_layer_norm.bias":    "output_norm.bias",
      "embed_out.weight":                  "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "input_layernorm.bias":            "attn_norm.bias",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "post_attention_layernorm.bias":   "ffn_norm.bias",
      "attention.query_key_value.weight": [
        {"role": "attn_q.weight", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)", "hidden_size ?? 6144"]}, {"slice": [1, 0, 1]}, {"reshape": [-1, "hidden_size ?? 6144"]}]},
        {"role": "attn_k.weight", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)", "hidden_size ?? 6144"]}, {"slice": [1, 1, 1]}, {"reshape": [-1, "hidden_size ?? 6144"]}]},
        {"role": "attn_v.weight", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)", "hidden_size ?? 6144"]}, {"slice": [1, 2, 1]}, {"reshape": [-1, "hidden_size ?? 6144"]}]}],
      "attention.query_key_value.bias": [
        {"role": "attn_q.bias", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)"]}, {"slice": [1, 0, 1]}, {"reshape": [-1]}]},
        {"role": "attn_k.bias", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)"]}, {"slice": [1, 1, 1]}, {"reshape": [-1]}]},
        {"role": "attn_v.bias", "do": [{"reshape": ["num_attention_heads ?? 64", 3, "(hidden_size ?? 6144) / (num_attention_heads ?? 64)"]}, {"slice": [1, 2, 1]}, {"reshape": [-1]}]}],
      "attention.dense.weight":          "attn_output.weight",
      "attention.dense.bias":            "attn_output.bias",
      "mlp.dense_h_to_4h.weight":        "ffn_up.weight",
      "mlp.dense_h_to_4h.bias":          "ffn_up.bias",
      "mlp.dense_4h_to_h.weight":        "ffn_down.weight",
      "mlp.dense_4h_to_h.bias":          "ffn_down.bias"
    },
    "ignore": ["attention.rotary_emb.inv_freq", "attention.bias", "attention.masked_bias", "gpt_neox.rotary_emb.inv_freq"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "layer_norm", "in": "x", "w": ["attn_norm", "attn_norm.bias"], "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "n", "w": ["attn_k", "attn_k.bias"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "n", "w": ["attn_v", "attn_v.bias"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias"], "rows": "embd", "out": "o"},
      {"op": "layer_norm", "in": "x", "w": ["ffn_norm", "ffn_norm.bias"], "out": "m"},
      {"op": "matvec",     "in": "m", "w": ["ffn_up", "ffn_up.bias"], "rows": "ffn", "out": "u"},
      {"op": "expr",       "name": "gelu", "width": "ffn", "in": ["u"], "terms": [
        {"fn": "mul", "args": [{"in": 0}, {"const": "0.7071067811865476"}]},
        {"fn": "erf", "args": [{"term": 0}]},
        {"fn": "add", "args": [{"term": 1}, {"const": "1"}]},
        {"fn": "mul", "args": [{"in": 0}, {"term": 2}]},
        {"fn": "mul", "args": [{"term": 3}, {"const": "0.5"}]}], "out": "a"},
      {"op": "matvec",     "in": "a", "w": ["ffn_down", "ffn_down.bias"], "rows": "embd", "out": "d"},
      {"op": "add",        "in": ["x", "o"], "out": "h"},
      {"op": "add",        "in": ["h", "d"], "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

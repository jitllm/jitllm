{
  "describe": {"GPTJForCausalLM": "GPT-J (safetensors only)"},
  "classes": ["GPTJForCausalLM"],
  "container": {
    "gptj": {"flags": {"layer_norm": "true"},
             "norm_eps": "src['attention.layer_norm_epsilon'] | default(1e-5)"}
  },
  "config": {
    "arch": "gptj",
    "keys": {
      "block_count":                  {"uint": "n_layer ?? 28"},
      "context_length":               {"uint": "n_positions ?? 2048"},
      "embedding_length":             {"uint": "n_embd ?? 4096"},
      "feed_forward_length":          {"uint": "n_inner ?? 4 * (n_embd ?? 4096)"},
      "attention.head_count":         {"uint": "n_head ?? 16"},
      "attention.head_count_kv":      {"uint": "n_head ?? 16"},
      "attention.key_length":         {"uint": "(n_embd ?? 4096) / (n_head ?? 16)"},
      "attention.value_length":       {"uint": "(n_embd ?? 4096) / (n_head ?? 16)"},
      "attention.layer_norm_epsilon": {"float": "layer_norm_epsilon ?? 1e-5"},
      "rope.dimension_count":         {"uint": "rotary_dim ?? ((n_embd ?? 4096) / (n_head ?? 16))"},
      "rope.freq_base":               {"float": "10000"}
    },
    "vocab": "vocab_size ?? 50400",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "require": [
      {"that": "(activation_function ?? 'gelu_new') == 'gelu_new'",
       "else": "activation_function is not gelu_new: the block this file states computes the tanh GELU"},
      {"that": "rotary ?? true",
       "else": "rotary is false: the block this file states rotates q and k"}
    ]
  },
  "tensors": {
    "block_prefix": "transformer.h.",
    "model": {
      "transformer.wte.weight":  "token_embd.weight",
      "transformer.ln_f.weight": "output_norm.weight",
      "transformer.ln_f.bias":   "output_norm.bias",
      "lm_head.weight":          "output.weight",
      "lm_head.bias":            "output.bias"
    },
    "block": {
      "ln_1.weight":          "attn_norm.weight",
      "ln_1.bias":            "attn_norm.bias",
      "attn.q_proj.weight":   "attn_q.weight",
      "attn.k_proj.weight":   "attn_k.weight",
      "attn.v_proj.weight":   "attn_v.weight",
      "attn.out_proj.weight": "attn_output.weight",
      "mlp.fc_in.weight":     "ffn_up.weight",
      "mlp.fc_in.bias":       "ffn_up.bias",
      "mlp.fc_out.weight":    "ffn_down.weight",
      "mlp.fc_out.bias":      "ffn_down.bias"
    },
    "ignore": ["attn.bias", "attn.masked_bias", "attn.rotary_emb.inv_freq", "attn.embed_positions"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "layer_norm", "in": "x", "w": ["attn_norm", "attn_norm.bias"], "out": "n"},
      {"op": "matvec",     "in": "n", "w": "attn_q", "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "n", "w": "attn_k", "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "n", "w": "attn_v", "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "out": "att"},
      {"op": "matvec",     "in": "att", "w": "attn_output", "rows": "embd", "out": "o"},
      {"op": "matvec",     "in": "n", "w": ["ffn_up", "ffn_up.bias"], "rows": "ffn", "out": "u"},
      {"op": "expr",       "name": "gelu", "width": "ffn", "in": ["u"], "terms": [
        {"fn": "mul", "args": [{"in": 0}, {"in": 0}]},
        {"fn": "mul", "args": [{"term": 0}, {"in": 0}]},
        {"fn": "mul", "args": [{"term": 1}, {"const": "0.044715"}]},
        {"fn": "add", "args": [{"in": 0}, {"term": 2}]},
        {"fn": "mul", "args": [{"term": 3}, {"const": "0.7978845608028654"}]},
        {"fn": "tanh", "args": [{"term": 4}]},
        {"fn": "add", "args": [{"term": 5}, {"const": "1"}]},
        {"fn": "mul", "args": [{"in": 0}, {"term": 6}]},
        {"fn": "mul", "args": [{"term": 7}, {"const": "0.5"}]}], "out": "a"},
      {"op": "matvec",     "in": "a", "w": ["ffn_down", "ffn_down.bias"], "rows": "embd", "out": "d"},
      {"op": "add",        "in": ["x", "o"], "out": "h"},
      {"op": "add",        "in": ["h", "d"], "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

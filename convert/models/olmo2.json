{
  "classes": ["Olmo2ForCausalLM"],
  "gguf": ["olmo2"],
  "container": {
    "olmo2": {"flags": {"rope_neox": "true", "qk_norm": "true", "qk_norm_wide": "true"},
              "window": {"size": "src['attention.sliding_window'] | default(0)", "pattern": "4",
                         "rope_base": "src['rope.freq_base_swa'] | default(src['rope.freq_base'] | default(10000))"},
              "revision": {"rope_scale_swa": "1 if (src['attention.sliding_window'] | default(0)) > 0 else 0"}}
  },
  "config": {
    "arch": "olmo2",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 32"},
      "context_length":                   {"uint": "max_position_embeddings ?? 2048"},
      "embedding_length":                 {"uint": "hidden_size ?? 4096"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 11008"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 32)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.dimension_count":             {"uint": "head_dim ?? (hidden_size ?? 4096) / (num_attention_heads ?? 32)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"}
    },
    "vocab": "vocab_size ?? 50304",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling"
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "post_attention_layernorm.weight":   "post_attention_norm.weight",
      "post_feedforward_layernorm.weight": "post_ffw_norm.weight",
      "self_attn.q_proj.weight":           "attn_q.weight",
      "self_attn.k_proj.weight":           "attn_k.weight",
      "self_attn.v_proj.weight":           "attn_v.weight",
      "self_attn.o_proj.weight":           "attn_output.weight",
      "self_attn.q_norm.weight":           "attn_q_norm.weight",
      "self_attn.k_norm.weight":           "attn_k_norm.weight",
      "self_attn.q_proj.bias":             "attn_q.bias",
      "self_attn.k_proj.bias":             "attn_k.bias",
      "self_attn.v_proj.bias":             "attn_v.bias",
      "self_attn.o_proj.bias":             "attn_output.bias",
      "mlp.gate_proj.weight":              "ffn_gate.weight",
      "mlp.up_proj.weight":                "ffn_up.weight",
      "mlp.down_proj.weight":              "ffn_down.weight"
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "matvec",     "in": "x", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "x", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "x", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "norm",       "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "norm",       "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "norm",       "in": "o", "w": "post_attention_norm", "out": "o"},
      {"op": "add",        "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "matvec",     "in": "h", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec",     "in": "h", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act",        "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec",     "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "norm",       "in": "d", "w": "post_ffw_norm", "out": "d"},
      {"op": "add",        "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

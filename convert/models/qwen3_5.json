      {"op": "matvec",     "if": "not linear", "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "if": "not linear", "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "emit",       "if": "not linear", "kind": "slice", "in": "qq", "attr": {"HeadDim": "2 * head_dim", "Offset": "0", "Width": "head_dim"}, "outs": [{"name": "q", "width": "heads * head_dim"}], "out": "q"},
      {"op": "emit",       "if": "not linear", "kind": "slice", "in": "qq", "attr": {"HeadDim": "2 * head_dim", "Offset": "head_dim", "Width": "head_dim"}, "outs": [{"name": "gate", "width": "heads * head_dim"}], "out": "gate"},
      {"op": "head_norm",  "if": "not linear", "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm",  "if": "not linear", "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope",       "if": "not linear and rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "not linear and rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "indexer",    "if": "not linear and selects", "in": ["n", "n"], "out": "ix"},
      {"op": "emit",       "if": "not linear and selects", "kind": "concat", "in": ["k", "ix.key"], "outs": [{"name": "k.row", "width": "kv_heads * head_dim + key_width"}], "out": "k"},
      {"op": "emit",       "if": "not linear and selects", "kind": "map", "in": "ix.key", "attr": {"Fn": "'mul'"}, "outs": [{"name": "v.pad", "width": "key_width"}], "out": "vpad"},
      {"op": "emit",       "if": "not linear and selects", "kind": "concat", "in": ["v", "vpad"], "outs": [{"name": "v.row", "width": "kv_heads * head_dim + key_width"}], "out": "v"},
      {"op": "kv_append",  "if": "not linear", "in": ["k", "v"], "out": "kv"},
      {"op": "select",     "if": "not linear and selects and select_weighted", "in": ["ix.query", "ix.weight"], "hist": "kv", "attr": {"Offset": "kv_heads * head_dim", "Width": "kv_heads * head_dim + key_width"}, "out": "sel"},
      {"op": "select",     "if": "not linear and selects and not select_weighted", "in": "ix.query", "hist": "kv", "attr": {"Offset": "kv_heads * head_dim", "Width": "kv_heads * head_dim + key_width"}, "out": "sel"},
      {"op": "attend",     "if": "not linear and not selects", "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "attend",     "if": "not linear and selects", "in": ["q", "sel"], "hist": "kv", "w": "attn_sinks?", "attr": {"Width": "kv_heads * head_dim + key_width"}, "out": "att"},
      {"op": "sigmoid_mul", "if": "not linear", "name": "gated", "in": ["gate", "att"], "out": "att"},
      {"op": "matvec",     "if": "not linear", "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "stream_writes", "if": "attn_writes", "of": "attn", "streams": "xs", "in": "o", "ex": "ain.ex", "out": "cur"},
      {"op": "add",        "if": "not attn_writes", "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "stream_read", "if": "attn_writes", "of": "ffn", "streams": "cur", "in": ["x", "x"], "out": "fin"},
      {"op": "let",        "if": "not attn_writes", "in": "h", "out": "fin"},
      {"op": "let",        "if": "not stored('ffn_norm')", "in": "fin", "out": "m"},
      {"op": "norm",       "if": "stored('ffn_norm')", "in": "fin", "w": "ffn_norm", "out": "m"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act",        "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec",     "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark",       "if": "moe", "out": "routed"},
      {"op": "matvec",     "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated",     "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let",        "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit",       "if": "moe", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit",       "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit",       "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum",  "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed",     "if": "moe", "from": "routed"},
      {"op": "matvec",     "if": "moe", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec",     "if": "moe", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act",        "if": "moe", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec",     "if": "moe", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "emit",       "if": "moe", "kind": "map", "in": "m", "attr": {"Fn": "'mul'"}, "bind": [{"w": "ffn_gate_inp_shexp"}], "outs": [{"name": "shared.gate", "width": "embd"}], "out": "sl"},
      {"op": "emit",       "if": "moe", "kind": "reduce", "in": "sl", "attr": {"Fn": "'add'"}, "outs": [{"name": "shared.logit", "width": "1"}], "out": "sl"},
      {"op": "sigmoid_mul", "if": "moe", "name": "shared.gated", "in": ["sl", "so"], "out": "so"},
      {"op": "add",        "if": "moe", "in": ["d", "so"], "out": "d"},
      {"op": "stream_writes", "if": "ffn_writes", "of": "ffn", "streams": "cur", "in": "d", "ex": "fin.ex", "out": "fout"},
      {"op": "add",        "if": "not ffn_writes", "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out",        "if": "not ffn_writes", "in": "y"},
      {"op": "out_streams", "if": "ffn_writes", "streams": "fout"}
    ],
    "streams": {
      "if": "hc_rank > 0 and hc_streams > 1",
      "count": "hc_streams",
      "defs": {
        "hyper": [
          {"op": "concat",   "in": ["@range(inputs)"]},
          {"op": "rms_norm", "span": "embd", "eps": "eps"},
          {"op": "scale",    "w": ["$0"], "out": "xn"},
          {"op": "linear",   "w": ["$1"]},
          {"op": "stated",   "width": "hc_rank", "expr": "x * (1 / streams)"},
          {"op": "stated",   "width": "hc_rank", "expr": "x * sigmoid(x)"},
          {"op": "linear",   "w": ["$2"], "out": "u"},
          {"op": "stated",   "in": ["u", "xn"], "width": "streams * embd", "expr": "sigmoid(x) * y", "out": "g"},
          {"op": "slice",    "in": ["g"], "width": "embd", "out": "acc"},
          {"op": "each", "var": "k", "start": "1", "count": "streams", "ops": [
            {"op": "slice", "in": ["g"], "offset": "k * embd", "width": "embd", "out": "gk"},
            {"op": "add",   "in": ["acc", "gk"], "out": "acc"}
          ]},
          {"op": "stated",   "in": ["acc"], "width": "embd", "expr": "x * (1 / streams)"}
        ]
      },
      "expand": {"copy": true},
      "block": {
        "pre": {
          "if": "ngram_block > 0 and layer + 1 == ngram_block",
          "from": ["@range(streams)"],
          "read": [
            {"op": "ngram_rows", "in": [], "w": ["ngram_token_embd"], "span": "ngram",
             "width": "(ngram - 1) * ngram_heads * ngram_row", "out": "emb",
             "hash": {"eos": "ngram_eos", "image": "ngram_image", "heads_per": "ngram_heads",
                      "mul": "ngram_mul", "off": "ngram_off", "voc": "ngram_voc"}},
            {"op": "linear",   "w": ["ple_key"]},
            {"op": "rms_norm", "span": "embd", "eps": "eps"},
            {"op": "scale",    "w": ["ple_norm_key"], "out": "kn"},
            {"op": "linear",   "in": ["emb"], "w": ["ple_value"], "out": "val"},
            {"op": "concat",   "in": ["@range(inputs)"]},
            {"op": "rms_norm", "span": "embd", "eps": "eps"},
            {"op": "scale",    "w": ["ple_norm_query"], "out": "qn"},
            {"op": "stated",   "in": ["kn", "qn"], "width": "streams * embd", "expr": "x * y"},
            {"op": "sum",      "span": "embd"},
            {"op": "stated",   "width": "streams", "expr": "sigmoid(sign * mag)", "out": "gate",
             "with": [["s", "x * (1 / sqrt(embd))"], ["mag", "sqrt(max(abs(s), 1e-6))"], ["sign", "(0 < s) - (s < 0)"]]},
            {"op": "each", "var": "k", "count": "streams", "ops": [
              {"op": "slice",  "in": ["gate"], "offset": "k", "width": "1", "out": "gk"},
              {"op": "stated", "in": ["gk", "val"], "width": "embd", "expr": "x * y", "out": "gv[k]"}
            ]},
            {"op": "concat",    "in": ["gv[range(streams)]"], "out": "gvs"},
            {"op": "rms_norm",  "span": "embd", "eps": "eps"},
            {"op": "scale",     "w": ["ple_norm_conv"]},
            {"op": "tail_conv", "w": ["ple_conv1d"], "span": "ngram_conv", "offset": "ngram", "width": "streams * embd"},
            {"op": "stated",    "width": "streams * embd", "expr": "x * sigmoid(x)", "out": "act"},
            {"op": "add",       "in": ["gvs", "act"]}
          ],
          "writes": {"var": "k", "ops": [
            {"op": "slice", "in": ["in1"], "offset": "k * embd", "width": "embd", "out": "p"},
            {"op": "add",   "in": ["in", "p"]}
          ]}
        },
        "attn": {
          "from": ["@range(streams)"],
          "read": [
            {"op": "call",   "def": "hyper", "w": ["hc_attn_norm", "hc_attn_down", "hc_attn_up"], "out": "h"},
            {"op": "linear", "in": ["h.xn"], "w": ["hc_attn_inject"]},
            {"op": "stated", "width": "streams", "expr": "x * (1 / streams)"},
            {"op": "stated", "width": "streams", "expr": "sigmoid(x)"},
            {"op": "stated", "width": "streams", "expr": "x * 2", "out": "w"},
            {"op": "let",    "in": ["h"]}
          ],
          "exports": ["w"],
          "writes": {"var": "k", "ops": [
            {"op": "slice",  "in": ["in2"], "offset": "k", "width": "1", "out": "wk"},
            {"op": "stated", "in": ["wk", "in1"], "width": "embd", "expr": "x * y", "out": "o"},
            {"op": "add",    "in": ["in", "o"]}
          ]}
        },
        "ffn": {
          "from": ["@range(streams)"],
          "read": [
            {"op": "call",   "def": "hyper", "w": ["hc_ffn_norm", "hc_ffn_down", "hc_ffn_up"], "out": "h"},
            {"op": "linear", "in": ["h.xn"], "w": ["hc_ffn_inject"]},
            {"op": "stated", "width": "streams", "expr": "x * (1 / streams)"},
            {"op": "stated", "width": "streams", "expr": "sigmoid(x)"},
            {"op": "stated", "width": "streams", "expr": "x * 2", "out": "w"},
            {"op": "let",    "in": ["h"]}
          ],
          "exports": ["w"],
          "writes": {"var": "k", "ops": [
            {"op": "slice",  "in": ["in2"], "offset": "k", "width": "1", "out": "wk"},
            {"op": "stated", "in": ["wk", "in1"], "width": "embd", "expr": "x * y", "out": "o"},
            {"op": "add",    "in": ["in", "o"]}
          ]}
        }
      },
      "head": {
        "from": ["@range(streams)"],
        "read": [{"op": "call", "def": "hyper", "w": ["output_hc_norm", "output_hc_down", "output_hc_up"]}]
      }
    }
  }
}

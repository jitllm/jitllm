{
  "gguf": ["deepseek2", "deepseek32"],
  "container": {
    "deepseek2": {"tensors": {"block": {"attn_kv_b.weight": [
                    {"role": "attn_k_b.weight", "if": "packed && (attention.key_length - rope.dimension_count) % 32 == 0", "do": [{"type": "f32"}, {"reshape": ["attention.head_count", "(attention.key_length - rope.dimension_count) + (attention.value_length ?? (attention.key_length))", "attention.kv_lora_rank"]}, {"slice": [1, 0, "(attention.key_length - rope.dimension_count)"]}, {"transpose": [0, 2, 1]}, {"type": "q8"}]},
                    {"role": "attn_k_b.weight", "if": "!(packed && (attention.key_length - rope.dimension_count) % 32 == 0)", "do": [{"type": "f32"}, {"reshape": ["attention.head_count", "(attention.key_length - rope.dimension_count) + (attention.value_length ?? (attention.key_length))", "attention.kv_lora_rank"]}, {"slice": [1, 0, "(attention.key_length - rope.dimension_count)"]}, {"transpose": [0, 2, 1]}]},
                    {"role": "attn_v_b.weight", "do": [{"reshape": ["attention.head_count", "(attention.key_length - rope.dimension_count) + (attention.value_length ?? (attention.key_length))", "attention.kv_lora_rank"]}, {"slice": [1, "(attention.key_length - rope.dimension_count)", "(attention.value_length ?? (attention.key_length))"]}]}]}},
                  "yarn_magnitude": "softmax", "flags": {"no_expert_norm": "src['expert_weights_norm'] is not defined"}, "latent": {"kv": "src['attention.kv_lora_rank'] | default(src['attention.value_length'] | default(0))", "q": "src['attention.q_lora_rank'] | default(0)"}},
    "deepseek32": {"yarn_magnitude": "softmax", "flags": {"no_expert_norm": "src['expert_weights_norm'] is not defined"},
      "router": {"gate": "sigmoid"}, "latent": {"kv": "src['attention.kv_lora_rank'] | default(src['attention.value_length'] | default(0))", "q": "src['attention.q_lora_rank'] | default(0)"},
      "indexer": {"heads": "src['attention.indexer.head_count']", "key_width": "src['attention.indexer.key_length']", "top_k": "src['attention.indexer.top_k']"}}
  },
  "graph": {
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "norm", "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec", "if": "stored('attn_q_a')", "in": "n", "w": "attn_q_a", "rows": "rows('attn_q_a')", "out": "qa"},
      {"op": "norm", "if": "stored('attn_q_a')", "in": "qa", "w": "attn_q_a_norm", "eps": "latent_eps", "out": "qa"},
      {"op": "matvec", "if": "stored('attn_q_a')", "in": "qa", "w": ["attn_q_b", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "if": "not stored('attn_q_a')", "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "in": "n", "w": "attn_kv_a_mqa", "rows": "kv_lora + rot", "out": "kv"},
      {"op": "emit", "kind": "slice", "in": "kv", "attr": {"Offset": "0", "Width": "kv_lora"}, "outs": [{"name": "latent", "width": "kv_lora"}], "out": "lat"},
      {"op": "norm", "in": "lat", "w": "attn_kv_a_norm", "eps": "latent_eps", "out": "lat"},
      {"op": "emit", "kind": "slice", "in": "kv", "attr": {"Offset": "kv_lora", "Width": "rot"}, "outs": [{"name": "k.pe", "width": "rot"}], "out": "kpe"},
      {"op": "emit", "kind": "slice", "in": "q", "attr": {"HeadDim": "head_dim", "Offset": "head_dim - rot", "Width": "rot"}, "outs": [{"name": "q.pe", "width": "heads * rot"}], "out": "qpe"},
      {"op": "rope", "if": "rope_at", "in": "qpe", "name": "q.pe.rope", "attr": {"HeadDim": "rot", "Offset": "0"}, "out": "qpe"},
      {"op": "rope", "if": "rope_at", "in": "kpe", "name": "k.pe.rope", "attr": {"HeadDim": "rot", "Offset": "0"}, "out": "kpe"},
      {"op": "emit", "kind": "slice", "in": "q", "attr": {"HeadDim": "head_dim", "Offset": "0", "Width": "head_dim - rot"}, "outs": [{"name": "q.nope", "width": "heads * (head_dim - rot)"}], "out": "qn"},
      {"op": "emit", "kind": "expert_matvec", "in": "qn", "bind": [{"w": "attn_k_b", "k": "head_dim - rot", "rows": "kv_lora", "sheets": "heads"}], "outs": [{"name": "q.abs", "width": "heads * kv_lora"}], "out": "qabs"},
      {"op": "emit", "kind": "concat", "in": ["qabs", "qpe"], "attr": {"NHead": "heads"}, "outs": [{"name": "q.row", "width": "heads * (kv_lora + rot)"}], "out": "qrow"},
      {"op": "let", "if": "selects and not stored('attn_q_a')", "in": "n", "out": "qa"},
      {"op": "indexer", "if": "selects", "in": ["n", "qa"], "out": "ix"},
      {"op": "emit", "if": "not selects", "kind": "concat", "in": ["lat", "kpe"], "outs": [{"name": "kv.row", "width": "kv_lora + rot"}], "out": "krow"},
      {"op": "emit", "if": "selects", "kind": "concat", "in": ["lat", "kpe", "ix.key"], "outs": [{"name": "kv.row", "width": "kv_lora + rot + key_width"}], "out": "krow"},
      {"op": "kv_append", "in": ["krow", "krow"], "out": "hist"},
      {"op": "select", "if": "selects and select_weighted", "in": ["ix.query", "ix.weight"], "hist": "hist", "attr": {"Offset": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "sel"},
      {"op": "select", "if": "selects and not select_weighted", "in": "ix.query", "hist": "hist", "attr": {"Offset": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "sel"},
      {"op": "attend", "if": "not selects", "in": "qrow", "hist": "hist", "w": "attn_sinks?", "attr": {"NKVHead": "1", "HeadDim": "kv_lora + rot"}, "out": "att"},
      {"op": "attend", "if": "selects", "in": ["qrow", "sel"], "hist": "hist", "w": "attn_sinks?", "attr": {"NKVHead": "1", "HeadDim": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "att"},
      {"op": "emit", "kind": "slice", "in": "att", "attr": {"HeadDim": "kv_lora + rot", "Offset": "0", "Width": "kv_lora"}, "outs": [{"name": "att.latent", "width": "heads * kv_lora"}], "out": "al"},
      {"op": "emit", "kind": "expert_matvec", "in": "al", "bind": [{"w": "attn_v_b", "k": "kv_lora", "rows": "v_head_dim", "sheets": "heads"}], "outs": [{"name": "att.v", "width": "heads * v_head_dim"}], "out": "o"},
      {"op": "matvec", "if": "stored('attn_gate')", "in": "n", "w": "attn_gate", "rows": "heads * v_head_dim", "out": "ag"},
      {"op": "sigmoid_mul", "if": "stored('attn_gate')", "name": "att.gated", "in": ["ag", "o"], "out": "o"},
      {"op": "matvec", "in": "o", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "add", "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "norm", "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec", "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec", "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act", "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec", "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark", "if": "moe", "out": "routed"},
      {"op": "matvec", "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated", "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let", "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit", "if": "moe and stored('exp_probs_b.bias')", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "top_k", "in": "choose", "attr": {"TopK": "[2, experts // expert_groups] | min", "Span": "experts // expert_groups"}, "outs": [{"name": "router.group.sel", "width": "expert_groups * ([2, experts // expert_groups] | min)", "elem": "u32"}, {"name": "router.group.best", "width": "expert_groups * ([2, experts // expert_groups] | min)", "as": "gbest"}]},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "reduce", "in": "gbest", "attr": {"Fn": "'add'", "Span": "[2, experts // expert_groups] | min"}, "outs": [{"name": "router.group.score", "width": "expert_groups"}], "out": "gscore"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "rank", "in": "gscore", "outs": [{"name": "router.group.rank", "width": "expert_groups", "elem": "u32"}], "out": "grank"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": "grank", "attr": {"Fn": "'less'", "Const": "expert_groups_used"}, "outs": [{"name": "router.group.kept", "width": "expert_groups"}], "out": "gkept"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": ["gkept", "choose"], "attr": {"Fn": "'where'", "Const": "-inf"}, "outs": [{"name": "router.kept", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit", "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum", "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "if": "moe", "from": "routed"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and not stored('ffn_gate_shexp'))", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "add", "if": "(stored('ffn_up_shexp')) and (moe)", "in": ["d", "so"], "out": "d"},
      {"op": "add", "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out", "in": "y"}
    ]
  }
}

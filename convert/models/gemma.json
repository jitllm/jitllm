{
  "classes": ["GemmaForCausalLM"],
  "config": {
    "arch": "gemma",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 28"},
      "context_length":                   {"uint": "max_position_embeddings ?? 8192"},
      "embedding_length":                 {"uint": "hidden_size ?? 3072"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 24576"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 16"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? 16"},
      "attention.key_length":             {"uint": "head_dim ?? 256"},
      "attention.value_length":           {"uint": "head_dim ?? 256"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-6"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"}
    },
    "vocab": "vocab_size ?? 256000",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? true"},
    "refuse": [
      {"if": "(hidden_activation ?? hidden_act ?? 'gelu_pytorch_tanh') != 'gelu_pytorch_tanh'",
       "why": "the activation is not gelu_pytorch_tanh, and this graph's feed-forward is tanh-GELU-gated"},
      {"if": "mlp_bias ?? false", "why": "mlp_bias is true, and this container has no feed-forward bias role"},
      {"if": "!((rope_parameters.rope_type ?? rope_scaling.rope_type ?? rope_scaling.type ?? 'default') in ['default'])",
       "why": "a rope scaling other than none is not implemented"},
      {"if": "(rope_parameters.partial_rotary_factor ?? partial_rotary_factor ?? 1) != 1", "why": "a partial rotary is not implemented here"},
      {"if": "(use_sliding_window ?? true) && (sliding_window ?? 0) != 0", "why": "a sliding window in use is not implemented from safetensors"},
      {"if": "use_bidirectional_attention ?? false", "why": "use_bidirectional_attention changes the mask, and this graph is causal"}
    ]
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         {"role": "output_norm.weight", "do": ["plus_one"]},
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          {"role": "attn_norm.weight", "do": ["plus_one"]},
      "post_attention_layernorm.weight": {"role": "ffn_norm.weight", "do": ["plus_one"]},
      "self_attn.q_proj.weight":         "attn_q.weight",
      "self_attn.k_proj.weight":         "attn_k.weight",
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "self_attn.q_proj.bias":           "attn_q.bias",
      "self_attn.k_proj.bias":           "attn_k.bias",
      "self_attn.v_proj.bias":           "attn_v.bias",
      "self_attn.o_proj.bias":           "attn_output.bias",
      "mlp.gate_proj.weight":            "ffn_gate.weight",
      "mlp.up_proj.weight":              "ffn_up.weight",
      "mlp.down_proj.weight":            "ffn_down.weight"
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

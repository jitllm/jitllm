{
  "describe": {"Inkling2LoopForConditionalGeneration": "Inkling 2 Mini, its text model (safetensors only)"},
  "classes": ["Inkling2LoopForConditionalGeneration"],
  "container": {
    "inkling2": {
      "flags": {"no_pos_enc": "true"},
      "norm_eps": "src['attention.layer_norm_rms_epsilon']",
      "final_softcap": "src['final_logit_softcapping']",
      "router": {"gate": "sigmoid", "renormalise": "always"},
      "recurrent": {"conv_kernel": "src['conv_kernel']"},
      "layers": [{"tensors": ["attn_post_conv.weight"], "kind": "ssd_attention"}]
    }
  },
  "config": {
    "root": "text_config",
    "arch": "inkling2",
    "defaults": {
      "vocab_size": 201024,
      "unpadded_vocab_size": 200058,
      "hidden_size": 2304,
      "num_hidden_layers": 24,
      "num_attention_heads": 24,
      "num_key_value_heads": 8,
      "head_dim": 128,
      "swa_num_attention_heads": 24,
      "swa_num_key_value_heads": 8,
      "swa_head_dim": 128,
      "sliding_window_size": 1024,
      "d_rel": 16,
      "rel_extent": 1024,
      "log_scaling_n_floor": 8192,
      "log_scaling_alpha": 0.1,
      "rms_norm_eps": 1e-06,
      "n_routed_experts": 128,
      "num_experts_per_tok": 8,
      "route_scale": 8.0,
      "qk_l2_clip_threshold": 22.627416997969522,
      "rel_l2_clip_threshold": 8.0,
      "n_layers_per_attn_res_block": 6,
      "mlp_gate_softcap": 4.0,
      "mlp_up_softcap": 25.0,
      "final_logit_softcapping": 30.0,
      "scoring_func": "sigmoid"
    },
    "require": [
      {"that": "!(loop_config.is_varloop ?? false)", "else": "a variable loop count is not in the reference"},
      {
        "that": "(loop_config.core_start ?? loop_layer_index_start ?? 6) % n_layers_per_attn_res_block == 0 && (loop_config.core_end ?? loop_layer_index_end ?? 18) % n_layers_per_attn_res_block == 0",
        "else": "the loop must start and end on an attention-residual block boundary (validate_architecture)"
      },
      {
        "that": "num_attention_heads == swa_num_attention_heads",
        "else": "the sliding and full layers' query head counts differ, and the relative bias's profiles are stated for one count"
      },
      {"that": "head_dim == swa_head_dim", "else": "the sliding and full layers' head widths differ"}
    ],
    "gating": "sigmoid",
    "keys": {
      "block_count": {"uint": "num_hidden_layers"},
      "context_length": {"uint": "model_max_length ?? max_position_embeddings ?? 1048576"},
      "embedding_length": {"uint": "hidden_size"},
      "expert_feed_forward_length": {"uint": "(intermediate_size ?? moe_intermediate_size ?? 1152)"},
      "expert_count": {"uint": "n_routed_experts"},
      "expert_used_count": {"uint": "num_experts_per_tok"},
      "expert_weights_scale": {"float": "route_scale"},
      "attention.head_count": {"uint": "num_attention_heads"},
      "attention.head_count_kv": {
        "int32s": "each_match((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), 'hybrid', num_key_value_heads, swa_num_key_value_heads)"
      },
      "attention.key_length": {"uint": "head_dim"},
      "attention.value_length": {"uint": "head_dim"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps"},
      "attention.rel_width": {"uint": "d_rel"},
      "attention.rel_extent": {
        "int32s": "each_match((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), 'hybrid', rel_extent, sliding_window_size)"
      },
      "attention.clip": {"float": "qk_l2_clip_threshold"},
      "attention.rel_clip": {"float": "rel_l2_clip_threshold"},
      "attention.log_floor": {"uint": "log_scaling_n_floor"},
      "attention.log_alpha": {"float": "log_scaling_alpha"},
      "conv_kernel": {"uint": "(sconv_kernel_size ?? conv_kernel_size ?? 4)"},
      "attn_res.block_size": {"uint": "n_layers_per_attn_res_block"},
      "ffn.gate_softcap": {"float": "mlp_gate_softcap"},
      "ffn.up_softcap": {"float": "mlp_up_softcap"},
      "final_logit_softcapping": {"float": "final_logit_softcapping"},
      "loop.start": {"uint": "(loop_config.core_start ?? loop_layer_index_start ?? 6)"},
      "loop.end": {"uint": "(loop_config.core_end ?? loop_layer_index_end ?? 18)"},
      "loop.passes": {"uint": "loop_config.num_passes ?? loop_num_passes ?? 3"},
      "loop.gate_rank": {"uint": "loop_config.gate_rank ?? loop_gate_rank ?? 64"}
    },
    "unroll": "loop(num_hidden_layers, (loop_config.core_start ?? loop_layer_index_start ?? 6), (loop_config.core_end ?? loop_layer_index_end ?? 18), loop_config.num_passes ?? loop_num_passes ?? 3)",
    "vocab": "unpadded_vocab_size",
    "head": {"tensor": "model.llm.unembed.weight", "tied": "false"},
    "window": {
      "size": "sliding_window_size",
      "used": "true",
      "layers": {"list": "layer_types", "slides": "hybrid_sliding", "full": "hybrid", "period": "6"}
    }
  },
  "tensors": {
    "block_prefix": "model.llm.layers.",
    "model": {
      "model.llm.embed.weight": {"role": "token_embd.weight", "do": [{"slice": [0, 0, "unpadded_vocab_size"]}]},
      "model.llm.embed_norm.weight": "token_embd_norm.weight",
      "model.llm.norm.weight": "output_norm.weight",
      "model.llm.unembed.weight": {"role": "output.weight", "do": [{"slice": [0, 0, "unpadded_vocab_size"]}]},
      "model.llm.attn_res.output_query": {"role": "output_res_score.weight", "do": [{"map": "x / sqrt(hidden_size)"}]},
      "model.llm.attn_res.mlp_queries.{i}": {"role": "ffn_res_score.weight", "block": "i", "do": [{"map": "x / sqrt(hidden_size)"}]},
      "model.llm.attn_res.attn_queries.{i}": [
        {
          "role": "attn_res_score.weight",
          "block": "i + 1",
          "where": "at((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), i + 1) != 'hybrid'",
          "do": [{"map": "x / sqrt(hidden_size)"}]
        },
        {
          "role": "attn_res_score_q.weight",
          "block": "i + 1",
          "where": "at((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), i + 1) == 'hybrid'",
          "do": [{"slice": [0, 0, 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        },
        {
          "role": "attn_res_score_k.weight",
          "block": "i + 1",
          "where": "at((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), i + 1) == 'hybrid'",
          "do": [{"slice": [0, 1, 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        },
        {
          "role": "attn_res_score_v.weight",
          "block": "i + 1",
          "where": "at((layer_types ?? every(num_hidden_layers, 6, 5, 'hybrid', 'hybrid_sliding')), i + 1) == 'hybrid'",
          "do": [{"slice": [0, 2, 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        }
      ],
      "model.llm.middle_cycle_cross_pass_queries": [
        {
          "role": "loop_msg_q.weight",
          "each": "(loop_config.core_end ?? loop_layer_index_end ?? 18) - (loop_config.core_start ?? loop_layer_index_start ?? 6)",
          "block": "(loop_config.core_start ?? loop_layer_index_start ?? 6) + i",
          "do": [{"slice": [0, "2 * i + 0", 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        },
        {
          "role": "loop_msg_ffn.weight",
          "each": "(loop_config.core_end ?? loop_layer_index_end ?? 18) - (loop_config.core_start ?? loop_layer_index_start ?? 6)",
          "block": "(loop_config.core_start ?? loop_layer_index_start ?? 6) + i",
          "do": [{"slice": [0, "2 * i + 1", 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        }
      ],
      "model.llm.middle_cycle_cross_pass_kv_queries": [
        {
          "role": "loop_msg_k.weight",
          "each": "(loop_config.core_end ?? loop_layer_index_end ?? 18) - (loop_config.core_start ?? loop_layer_index_start ?? 6)",
          "block": "(loop_config.core_start ?? loop_layer_index_start ?? 6) + i",
          "do": [{"slice": [0, "2 * i + 0", 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        },
        {
          "role": "loop_msg_v.weight",
          "each": "(loop_config.core_end ?? loop_layer_index_end ?? 18) - (loop_config.core_start ?? loop_layer_index_start ?? 6)",
          "block": "(loop_config.core_start ?? loop_layer_index_start ?? 6) + i",
          "do": [{"slice": [0, "2 * i + 1", 1]}, {"reshape": [-1]}, {"map": "x / sqrt(hidden_size)"}]
        }
      ]
    },
    "block": {
      "attn_norm.weight": "attn_norm.weight",
      "q_input_norm.weight": "attn_norm.weight",
      "k_input_norm.weight": "attn_k_in_norm.weight",
      "v_input_norm.weight": "attn_v_in_norm.weight",
      "mlp_norm.weight": "ffn_norm.weight",
      "attn.wq_du.weight": "attn_q.weight",
      "attn.wk_dv.weight": "attn_k.weight",
      "attn.wv_dv.weight": "attn_v.weight",
      "attn.wo_ud.weight": "attn_output.weight",
      "attn.gate_attn.weight": "attn_gate.weight",
      "attn.attn_sink_proj.weight": "attn_sinks_proj.weight",
      "attn.q_l2_clip.scale": {"role": "attn_q_clip_scale.weight", "do": [{"reshape": [-1]}]},
      "attn.wr_du.weight": "attn_rel.weight",
      "attn.rel_l2_clip.scale": {"role": "attn_rel_clip_scale.weight", "do": [{"reshape": [-1]}]},
      "attn.rel_logits_proj.proj": {
        "role": "attn_rel_proj.weight",
        "do": [{"transpose": [1, 0]}, {"reshape": [1, -1, "d_rel"]}, {"repeat": [0, "num_attention_heads"]}]
      },
      "attn.k_sconv.weight": {"role": "attn_k_conv.weight", "do": [{"reshape": [-1, "(sconv_kernel_size ?? conv_kernel_size ?? 4)"]}]},
      "attn.v_sconv.weight": {"role": "attn_v_conv.weight", "do": [{"reshape": [-1, "(sconv_kernel_size ?? conv_kernel_size ?? 4)"]}]},
      "attn.k_sconv.static_w": {"role": "attn_k_conv.weight", "do": [{"transpose": [1, 0]}, {"flip": 1}]},
      "attn.v_sconv.static_w": {"role": "attn_v_conv.weight", "do": [{"transpose": [1, 0]}, {"flip": 1}]},
      "attn.k_sconv.weight_proj": {
        "role": "attn_k_conv_proj.weight",
        "do": [{"reshape": ["num_key_value_heads", "(sconv_kernel_size ?? conv_kernel_size ?? 4)", -1]}, {"flip": 1}, {"reshape": ["num_key_value_heads * (sconv_kernel_size ?? conv_kernel_size ?? 4)", -1]}]
      },
      "attn.v_sconv.weight_proj": {
        "role": "attn_v_conv_proj.weight",
        "do": [{"reshape": ["num_key_value_heads", "(sconv_kernel_size ?? conv_kernel_size ?? 4)", -1]}, {"flip": 1}, {"reshape": ["num_key_value_heads * (sconv_kernel_size ?? conv_kernel_size ?? 4)", -1]}]
      },
      "attn_sconv.weight": {"role": "attn_post_conv.weight", "do": [{"reshape": [-1, "(sconv_kernel_size ?? conv_kernel_size ?? 4)"]}]},
      "mlp_sconv.weight": {"role": "ffn_post_conv.weight", "do": [{"reshape": [-1, "(sconv_kernel_size ?? conv_kernel_size ?? 4)"]}]},
      "mlp.gate.weight": "ffn_gate_inp.weight",
      "mlp.gate.bias": "exp_probs_b.bias",
      "mlp.experts.w13_weight": [
        {
          "role": "ffn_gate_exps.weight",
          "do": [{"reshape": ["n_routed_experts", "(intermediate_size ?? moe_intermediate_size ?? 1152)", 2, "hidden_size"]}, {"slice": [2, 0, 1]}, {"reshape": ["n_routed_experts", "(intermediate_size ?? moe_intermediate_size ?? 1152)", "hidden_size"]}]
        },
        {
          "role": "ffn_up_exps.weight",
          "do": [{"reshape": ["n_routed_experts", "(intermediate_size ?? moe_intermediate_size ?? 1152)", 2, "hidden_size"]}, {"slice": [2, 1, 1]}, {"reshape": ["n_routed_experts", "(intermediate_size ?? moe_intermediate_size ?? 1152)", "hidden_size"]}]
        }
      ],
      "mlp.experts.w2_weight": "ffn_down_exps.weight",
      "controllers.attn.down_weight": "loop_q_down.weight",
      "controllers.attn.forget_weight": "loop_q_forget.weight",
      "controllers.attn.gain_weight": "loop_q_gain.weight",
      "controllers.k.down_weight": "loop_k_down.weight",
      "controllers.k.forget_weight": "loop_k_forget.weight",
      "controllers.k.gain_weight": "loop_k_gain.weight",
      "controllers.v.down_weight": "loop_v_down.weight",
      "controllers.v.forget_weight": "loop_v_forget.weight",
      "controllers.v.gain_weight": "loop_v_gain.weight",
      "controllers.mlp.down_weight": "loop_ffn_down.weight",
      "controllers.mlp.forget_weight": "loop_ffn_forget.weight",
      "controllers.mlp.gain_weight": "loop_ffn_gain.weight"
    },
    "ignore_prefix": ["model.visual.", "mtp."]
  },
  "graph": {
    "facts": [
      ["rb", "src['attn_res.block_size']"],
      ["ls", "src['loop.start']"],
      ["le", "src['loop.end']"],
      ["lp", "src['loop.passes']"],
      ["ll", "le - ls"],
      ["lsrc", "src['block_count']"],
      ["rank", "src['loop.gate_rank']"],
      ["qk_clip", "src['attention.clip']"],
      ["rel_clip", "src['attention.rel_clip']"],
      ["rel_width", "src['attention.rel_width']"],
      ["log_floor", "src['attention.log_floor']"],
      ["log_alpha", "src['attention.log_alpha']"],
      ["gate_cap", "src['ffn.gate_softcap']"],
      ["up_cap", "src['ffn.up_softcap']"],
      ["extent", "src['attention.rel_extent'][page]"],
      ["kvw", "kv_heads * head_dim"],
      ["kvmax", "(src['attention.head_count_kv'] | max) * head_dim"],
      ["span", "2 * (conv - 1) * kvmax + 2 * (conv - 1) * embd"],
      ["inloop", "page >= ls and page < le"],
      ["pass", "(layer - page) // ll + 1 if inloop else 0"],
      ["boundary", "page % rb == 0"],
      ["restart", "inloop and pass > 1 and page == ls"],
      ["msgs", "inloop and pass > 1"],
      ["msg0", "1 if sliding else 3"],
      ["nb0", "ls // rb"],
      ["nl", "ll // rb"],
      ["base1", "1 + nb0"],
      ["pbase", "1 + nb0 + (pass - 1) * nl"],
      ["lastbase", "1 + nb0 + (lp - 1) * nl"],
      ["post0", "1 + nb0 + lp * nl"],
      ["pstream", "post0 + (lsrc - le + rb - 1) // rb"],
      ["seen", "range(1, 1 + (page + rb - 1) // rb) if page < ls else ((range(1, base1) + ([base1] if page > ls else []) + range(pbase + 1, pbase + (page - ls + rb - 1) // rb)) if inloop else (range(1, base1) + [base1] + range(lastbase + 1, lastbase + nl) + range(post0, post0 + (page - le + rb - 1) // rb)))"],
      ["own", "([base1] if restart else ['in']) if boundary else []"],
      ["own_bank", "0 if (not boundary or restart) else (1 + page // rb if page < ls else (pbase + (page - ls) // rb if inloop else post0 + (page - le) // rb))"],
      ["msg_from", "(range(1 + nb0 + (pass - 2) * nl + 1, 1 + nb0 + (pass - 1) * nl) + [pstream]) if msgs else []"],
      ["nmsg", "nl if msgs else 0"]
    ],
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "streams_in", "in": "x", "out": "xs"},
      {"op": "stream_read", "if": "restart", "of": "pre", "streams": "xs", "in": ["x", "x"], "out": "pre"},
      {"op": "stream_writes", "if": "restart", "of": "pre", "streams": "xs", "in": "pre", "ex": "pre.ex", "out": "xs"},
      {"op": "stream_at", "if": "restart", "streams": "xs", "at": "0", "out": "x"},
      {"op": "stream_read", "of": "attn", "streams": "xs", "in": ["x", "x"], "out": "ar"},
      {"op": "emit", "kind": "slice", "in": "ar", "attr": {"Offset": "0", "Width": "embd"}, "outs": [{"name": "hq", "width": "embd"}], "out": "hq"},
      {"op": "emit", "if": "not sliding and page > 0", "kind": "slice", "in": "ar", "attr": {"Offset": "embd", "Width": "embd"}, "outs": [{"name": "hk", "width": "embd"}], "out": "hk"},
      {"op": "emit", "if": "not sliding and page > 0", "kind": "slice", "in": "ar", "attr": {"Offset": "2 * embd", "Width": "embd"}, "outs": [{"name": "hv", "width": "embd"}], "out": "hv"},
      {"op": "let", "if": "sliding or page == 0", "in": "hq", "out": "hk"},
      {"op": "let", "if": "sliding or page == 0", "in": "hq", "out": "hv"},
      {"op": "emit", "if": "msgs", "kind": "slice", "in": "ar", "attr": {"Offset": "msg0 * embd", "Width": "embd"}, "outs": [{"name": "mq", "width": "embd"}], "out": "mq"},
      {"op": "emit", "if": "msgs", "kind": "slice", "in": "ar", "attr": {"Offset": "(msg0 + 1) * embd", "Width": "embd"}, "outs": [{"name": "mk", "width": "embd"}], "out": "mk"},
      {"op": "emit", "if": "msgs", "kind": "slice", "in": "ar", "attr": {"Offset": "(msg0 + 2) * embd", "Width": "embd"}, "outs": [{"name": "mv", "width": "embd"}], "out": "mv"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "hq", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hq.hn", "width": "embd"}], "out": "hq.hn"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "mq", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hq.mn", "width": "embd"}], "out": "hq.mn"},
      {"op": "emit", "if": "msgs", "kind": "concat", "in": ["hq.hn", "hq.mn"], "outs": [{"name": "hq.cat", "width": "2 * embd"}], "out": "hq.cat"},
      {"op": "matvec", "if": "msgs", "in": "hq.cat", "w": "loop_q_down", "rows": "rank", "out": "hq.g"},
      {"op": "matvec", "if": "msgs", "in": "hq.g", "w": "loop_q_forget", "rows": "embd", "out": "hq.f"},
      {"op": "matvec", "if": "msgs", "in": "hq.g", "w": "loop_q_gain", "rows": "embd", "out": "hq.a"},
      {"op": "expr", "if": "msgs", "name": "hq.gated", "width": "embd", "in": ["hq", "mq", "hq.f", "hq.a"], "terms": [{"fn": "tanh", "args": [{"in": 2}]}, {"fn": "sub", "args": [{"const": "1"}, {"term": 0}]}, {"fn": "mul", "args": [{"term": 1}, {"in": 0}]}, {"fn": "tanh", "args": [{"in": 3}]}, {"fn": "mul", "args": [{"term": 3}, {"in": 1}]}, {"fn": "add", "args": [{"term": 2}, {"term": 4}]}], "out": "hq"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "hk", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hk.hn", "width": "embd"}], "out": "hk.hn"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "mk", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hk.mn", "width": "embd"}], "out": "hk.mn"},
      {"op": "emit", "if": "msgs", "kind": "concat", "in": ["hk.hn", "hk.mn"], "outs": [{"name": "hk.cat", "width": "2 * embd"}], "out": "hk.cat"},
      {"op": "matvec", "if": "msgs", "in": "hk.cat", "w": "loop_k_down", "rows": "rank", "out": "hk.g"},
      {"op": "matvec", "if": "msgs", "in": "hk.g", "w": "loop_k_forget", "rows": "embd", "out": "hk.f"},
      {"op": "matvec", "if": "msgs", "in": "hk.g", "w": "loop_k_gain", "rows": "embd", "out": "hk.a"},
      {"op": "expr", "if": "msgs", "name": "hk.gated", "width": "embd", "in": ["hk", "mk", "hk.f", "hk.a"], "terms": [{"fn": "tanh", "args": [{"in": 2}]}, {"fn": "sub", "args": [{"const": "1"}, {"term": 0}]}, {"fn": "mul", "args": [{"term": 1}, {"in": 0}]}, {"fn": "tanh", "args": [{"in": 3}]}, {"fn": "mul", "args": [{"term": 3}, {"in": 1}]}, {"fn": "add", "args": [{"term": 2}, {"term": 4}]}], "out": "hk"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "hv", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hv.hn", "width": "embd"}], "out": "hv.hn"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "mv", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "hv.mn", "width": "embd"}], "out": "hv.mn"},
      {"op": "emit", "if": "msgs", "kind": "concat", "in": ["hv.hn", "hv.mn"], "outs": [{"name": "hv.cat", "width": "2 * embd"}], "out": "hv.cat"},
      {"op": "matvec", "if": "msgs", "in": "hv.cat", "w": "loop_v_down", "rows": "rank", "out": "hv.g"},
      {"op": "matvec", "if": "msgs", "in": "hv.g", "w": "loop_v_forget", "rows": "embd", "out": "hv.f"},
      {"op": "matvec", "if": "msgs", "in": "hv.g", "w": "loop_v_gain", "rows": "embd", "out": "hv.a"},
      {"op": "expr", "if": "msgs", "name": "hv.gated", "width": "embd", "in": ["hv", "mv", "hv.f", "hv.a"], "terms": [{"fn": "tanh", "args": [{"in": 2}]}, {"fn": "sub", "args": [{"const": "1"}, {"term": 0}]}, {"fn": "mul", "args": [{"term": 1}, {"in": 0}]}, {"fn": "tanh", "args": [{"in": 3}]}, {"fn": "mul", "args": [{"term": 3}, {"in": 1}]}, {"fn": "add", "args": [{"term": 2}, {"term": 4}]}], "out": "hv"},
      {"op": "norm", "in": "hq", "w": "attn_norm", "out": "nq"},
      {"op": "norm", "if": "sliding", "in": "hk", "w": "attn_norm", "out": "nk"},
      {"op": "norm", "if": "sliding", "in": "hv", "w": "attn_norm", "out": "nv"},
      {"op": "norm", "if": "not sliding", "in": "hk", "w": "attn_k_in_norm", "out": "nk"},
      {"op": "norm", "if": "not sliding", "in": "hv", "w": "attn_v_in_norm", "out": "nv"},
      {"op": "emit", "if": "not sliding", "kind": "position", "in": [], "outs": [{"name": "pos", "width": "1"}], "out": "pos"},
      {"op": "expr", "if": "not sliding", "name": "tau", "width": "1", "in": ["pos"], "terms": [{"fn": "add", "args": [{"in": 0}, {"const": "1"}]}, {"fn": "div", "args": [{"term": 0}, {"const": "log_floor"}]}, {"fn": "max", "args": [{"term": 1}, {"const": "1"}]}, {"fn": "log", "args": [{"term": 2}]}, {"fn": "mul", "args": [{"term": 3}, {"const": "log_alpha"}]}, {"fn": "add", "args": [{"term": 4}, {"const": "1"}]}], "out": "tau"},
      {"op": "matvec", "in": "nq", "w": "attn_q", "rows": "heads * head_dim", "out": "q"},
      {"op": "emit", "kind": "map", "in": "q", "attr": {"Fn": "'mul'"}, "bind": [{"w": "attn_q_clip_scale"}], "outs": [{"name": "q.scaled", "width": "heads * head_dim"}], "out": "q"},
      {"op": "expr", "name": "q.sq", "width": "heads * head_dim", "in": ["q"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 0}]}], "out": "q.sq"},
      {"op": "emit", "kind": "reduce", "in": "q.sq", "attr": {"Fn": "'add'", "Span": "head_dim"}, "outs": [{"name": "q.ss", "width": "heads"}], "out": "q.ss"},
      {"op": "expr", "name": "q.f", "width": "heads", "in": ["q.ss"], "terms": [{"fn": "sqrt", "args": [{"in": 0}]}, {"fn": "add", "args": [{"term": 0}, {"const": "1e-6"}]}, {"fn": "div", "args": [{"const": "qk_clip"}, {"term": 1}]}, {"fn": "min", "args": [{"term": 2}, {"const": "1"}]}], "out": "q.f"},
      {"op": "expr", "name": "q.clipped", "width": "heads * head_dim", "in": ["q", "q.f"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 1}]}], "out": "q"},
      {"op": "expr", "if": "not sliding", "name": "q.logscaled", "width": "heads * head_dim", "in": ["q", "tau"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 1}]}], "out": "q"},
      {"op": "matvec", "in": "nk", "w": "attn_k", "rows": "kvw", "out": "k"},
      {"op": "matvec", "if": "not sliding", "in": "nk", "w": "attn_k_conv_proj", "rows": "kv_heads * conv", "out": "ktaps"},
      {"op": "emit", "if": "sliding", "kind": "state_conv", "in": "k", "attr": {"Taps": "conv", "Offset": "0", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "attn_k_conv", "k": "conv", "rows": "kvw"}], "outs": [{"name": "k.conv", "width": "kvw"}], "out": "k.conv"},
      {"op": "expr", "if": "sliding", "name": "k.convolved", "width": "kvw", "in": ["k.conv", "k"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(conv + 1) ** -0.5"}]}], "out": "k"},
      {"op": "emit", "if": "not sliding", "kind": "state_conv", "in": ["k", "ktaps"], "attr": {"Taps": "conv", "Offset": "0", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "attn_k_conv", "k": "conv", "rows": "kvw"}], "outs": [{"name": "k.conv", "width": "kvw"}], "out": "k.conv"},
      {"op": "expr", "if": "not sliding", "name": "k.convolved", "width": "kvw", "in": ["k.conv", "k"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(2 * conv + 1) ** -0.5"}]}], "out": "k"},
      {"op": "expr", "name": "k.sq", "width": "kv_heads * head_dim", "in": ["k"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 0}]}], "out": "k.sq"},
      {"op": "emit", "kind": "reduce", "in": "k.sq", "attr": {"Fn": "'add'", "Span": "head_dim"}, "outs": [{"name": "k.ss", "width": "kv_heads"}], "out": "k.ss"},
      {"op": "expr", "name": "k.f", "width": "kv_heads", "in": ["k.ss"], "terms": [{"fn": "sqrt", "args": [{"in": 0}]}, {"fn": "add", "args": [{"term": 0}, {"const": "1e-6"}]}, {"fn": "div", "args": [{"const": "qk_clip"}, {"term": 1}]}, {"fn": "min", "args": [{"term": 2}, {"const": "1"}]}], "out": "k.f"},
      {"op": "expr", "name": "k.clipped", "width": "kv_heads * head_dim", "in": ["k", "k.f"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 1}]}], "out": "k"},
      {"op": "matvec", "in": "nv", "w": "attn_v", "rows": "kvw", "out": "v"},
      {"op": "matvec", "if": "not sliding", "in": "nv", "w": "attn_v_conv_proj", "rows": "kv_heads * conv", "out": "vtaps"},
      {"op": "emit", "if": "sliding", "kind": "state_conv", "in": "v", "attr": {"Taps": "conv", "Offset": "(conv - 1) * kvmax", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "attn_v_conv", "k": "conv", "rows": "kvw"}], "outs": [{"name": "v.conv", "width": "kvw"}], "out": "v.conv"},
      {"op": "expr", "if": "sliding", "name": "v.convolved", "width": "kvw", "in": ["v.conv", "v"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(conv + 1) ** -0.5"}]}], "out": "v"},
      {"op": "emit", "if": "not sliding", "kind": "state_conv", "in": ["v", "vtaps"], "attr": {"Taps": "conv", "Offset": "(conv - 1) * kvmax", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "attn_v_conv", "k": "conv", "rows": "kvw"}], "outs": [{"name": "v.conv", "width": "kvw"}], "out": "v.conv"},
      {"op": "expr", "if": "not sliding", "name": "v.convolved", "width": "kvw", "in": ["v.conv", "v"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(2 * conv + 1) ** -0.5"}]}], "out": "v"},
      {"op": "emit", "kind": "head_norm", "in": "v", "attr": {"Eps": "eps", "HeadDim": "head_dim"}, "outs": [{"name": "v.normed", "width": "kvw"}], "out": "v"},
      {"op": "kv_append", "in": ["k", "v"], "out": "kv"},
      {"op": "matvec", "in": "nq", "w": "attn_rel", "rows": "heads * rel_width", "out": "r"},
      {"op": "emit", "kind": "map", "in": "r", "attr": {"Fn": "'mul'"}, "bind": [{"w": "attn_rel_clip_scale"}], "outs": [{"name": "r.scaled", "width": "heads * rel_width"}], "out": "r"},
      {"op": "expr", "name": "r.sq", "width": "heads * rel_width", "in": ["r"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 0}]}], "out": "r.sq"},
      {"op": "emit", "kind": "reduce", "in": "r.sq", "attr": {"Fn": "'add'", "Span": "rel_width"}, "outs": [{"name": "r.ss", "width": "heads"}], "out": "r.ss"},
      {"op": "expr", "name": "r.f", "width": "heads", "in": ["r.ss"], "terms": [{"fn": "sqrt", "args": [{"in": 0}]}, {"fn": "add", "args": [{"term": 0}, {"const": "1e-6"}]}, {"fn": "div", "args": [{"const": "rel_clip"}, {"term": 1}]}, {"fn": "min", "args": [{"term": 2}, {"const": "1"}]}], "out": "r.f"},
      {"op": "expr", "name": "r.clipped", "width": "heads * rel_width", "in": ["r", "r.f"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 1}]}], "out": "r"},
      {"op": "expr", "if": "not sliding", "name": "r.logscaled", "width": "heads * rel_width", "in": ["r", "tau"], "terms": [{"fn": "mul", "args": [{"in": 0}, {"in": 1}]}], "out": "r"},
      {"op": "emit", "kind": "expert_matvec", "in": "r", "bind": [{"w": "attn_rel_proj", "k": "rel_width", "rows": "extent", "sheets": "heads"}], "outs": [{"name": "rel.bias", "width": "heads * extent"}], "out": "bias"},
      {"op": "matvec", "in": "nq", "w": "attn_sinks_proj", "rows": "heads", "out": "sink"},
      {"op": "attend", "in": ["q", "bias", "sink"], "hist": "kv", "attr": {"Extent": "extent", "RowSinks": "true"}, "out": "att"},
      {"op": "matvec", "in": "nq", "w": "attn_gate", "rows": "heads * head_dim", "out": "ag"},
      {"op": "sigmoid_mul", "name": "att.gated", "in": ["ag", "att"], "out": "att"},
      {"op": "matvec", "in": "att", "w": "attn_output", "rows": "embd", "out": "o"},
      {"op": "emit", "kind": "state_conv", "in": "o", "attr": {"Taps": "conv", "Offset": "2 * (conv - 1) * kvmax", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "attn_post_conv", "k": "conv", "rows": "embd"}], "outs": [{"name": "o.conv", "width": "embd"}], "out": "o.conv"},
      {"op": "expr", "name": "o.convolved", "width": "embd", "in": ["o.conv", "o"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(conv + 1) ** -0.5"}]}], "out": "o"},
      {"op": "add", "if": "not boundary", "in": ["x", "o"], "out": "h"},
      {"op": "stream_join", "if": "boundary", "of": "attn", "streams": "xs", "in": ["x", "o"], "out": "h"},
      {"op": "stream_read", "of": "ffn", "streams": "xs", "in": ["x", "h"], "out": "fr"},
      {"op": "emit", "kind": "slice", "in": "fr", "attr": {"Offset": "0", "Width": "embd"}, "outs": [{"name": "fi", "width": "embd"}], "out": "fi"},
      {"op": "emit", "if": "msgs", "kind": "slice", "in": "fr", "attr": {"Offset": "embd", "Width": "embd"}, "outs": [{"name": "mm", "width": "embd"}], "out": "mm"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "fi", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "fi.hn", "width": "embd"}], "out": "fi.hn"},
      {"op": "emit", "if": "msgs", "kind": "head_norm", "in": "mm", "attr": {"Eps": "eps", "HeadDim": "embd"}, "outs": [{"name": "fi.mn", "width": "embd"}], "out": "fi.mn"},
      {"op": "emit", "if": "msgs", "kind": "concat", "in": ["fi.hn", "fi.mn"], "outs": [{"name": "fi.cat", "width": "2 * embd"}], "out": "fi.cat"},
      {"op": "matvec", "if": "msgs", "in": "fi.cat", "w": "loop_ffn_down", "rows": "rank", "out": "fi.g"},
      {"op": "matvec", "if": "msgs", "in": "fi.g", "w": "loop_ffn_forget", "rows": "embd", "out": "fi.f"},
      {"op": "matvec", "if": "msgs", "in": "fi.g", "w": "loop_ffn_gain", "rows": "embd", "out": "fi.a"},
      {"op": "expr", "if": "msgs", "name": "fi.gated", "width": "embd", "in": ["fi", "mm", "fi.f", "fi.a"], "terms": [{"fn": "tanh", "args": [{"in": 2}]}, {"fn": "sub", "args": [{"const": "1"}, {"term": 0}]}, {"fn": "mul", "args": [{"term": 1}, {"in": 0}]}, {"fn": "tanh", "args": [{"in": 3}]}, {"fn": "mul", "args": [{"term": 3}, {"in": 1}]}, {"fn": "add", "args": [{"term": 2}, {"term": 4}]}], "out": "fi"},
      {"op": "norm", "in": "fi", "w": "ffn_norm", "out": "m"},
      {"op": "mark", "out": "routed"},
      {"op": "matvec", "in": "m", "w": "ffn_gate_inp", "rows": "experts", "out": "logits"},
      {"op": "stated", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "emit", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}], "out": "eg"},
      {"op": "emit", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}], "out": "eu"},
      {"op": "expr", "name": "experts.act", "width": "experts_used * rows('ffn_up_exps')", "in": ["eg", "eu"], "terms": [{"fn": "div", "args": [{"in": 0}, {"const": "gate_cap"}]}, {"fn": "tanh", "args": [{"term": 0}]}, {"fn": "mul", "args": [{"term": 1}, {"const": "gate_cap"}]}, {"fn": "sigmoid", "args": [{"in": 0}]}, {"fn": "mul", "args": [{"term": 2}, {"term": 3}]}, {"fn": "div", "args": [{"in": 1}, {"const": "up_cap"}]}, {"fn": "tanh", "args": [{"term": 5}]}, {"fn": "mul", "args": [{"term": 6}, {"const": "up_cap"}]}, {"fn": "mul", "args": [{"term": 4}, {"term": 7}]}], "out": "ea"},
      {"op": "emit", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}], "out": "ed"},
      {"op": "emit", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "from": "routed"},
      {"op": "emit", "kind": "state_conv", "in": "d", "attr": {"Taps": "conv", "Offset": "2 * (conv - 1) * kvmax + (conv - 1) * embd", "Span": "span"}, "advances": ["rec.state"], "bind": [{"w": "ffn_post_conv", "k": "conv", "rows": "embd"}], "outs": [{"name": "d.conv", "width": "embd"}], "out": "d.conv"},
      {"op": "expr", "name": "d.convolved", "width": "embd", "in": ["d.conv", "d"], "terms": [{"fn": "add", "args": [{"in": 0}, {"in": 1}]}, {"fn": "mul", "args": [{"term": 0}, {"const": "(conv + 1) ** -0.5"}]}], "out": "d"},
      {"op": "add", "in": ["h", "d"], "out": "y"},
      {"op": "out_streams", "streams": "xs", "in": "y"}
    ],
    "streams": {
      "count": "pstream + 1",
      "defs": {
        "mix": [
          {
            "op": "each",
            "var": "j",
            "start": "0",
            "count": "inputs - nmsg",
            "ops": [
              {"op": "rms_norm", "in": ["@j"], "eps": "1e-6", "out": "nv[j]"},
              {"op": "scale", "w": ["$0"]},
              {"op": "sum", "out": "sc[j]"}
            ]
          },
          {"op": "concat", "in": ["sc[range(0, inputs - nmsg)]"], "out": "s"},
          {"op": "max", "out": "mx"},
          {"op": "stated", "in": ["s", "mx"], "width": "(inputs - nmsg) - (0)", "expr": "exp(x - y)", "out": "ex"},
          {"op": "sum", "out": "se"},
          {"op": "stated", "in": ["ex", "se"], "width": "(inputs - nmsg) - (0)", "expr": "x / y", "out": "pr"},
          {
            "op": "each",
            "var": "j",
            "start": "0",
            "count": "inputs - nmsg",
            "ops": [
              {"op": "slice", "in": ["pr"], "offset": "j - (0)", "width": "1", "out": "pj"},
              {"op": "stated", "in": ["pj", "nv[j]"], "width": "embd", "expr": "x * y", "out": "part"},
              {"op": "let", "if": "j == (0)", "in": ["part"], "out": "acc"},
              {"op": "add", "if": "j > (0)", "in": ["acc", "part"], "out": "acc"}
            ]
          },
          {"op": "let", "in": ["acc"]}
        ],
        "msg": [
          {
            "op": "each",
            "var": "j",
            "start": "inputs - nmsg",
            "count": "inputs",
            "ops": [
              {"op": "rms_norm", "in": ["@j"], "eps": "1e-6", "out": "nv[j]"},
              {"op": "scale", "w": ["$0"]},
              {"op": "sum", "out": "sc[j]"}
            ]
          },
          {"op": "concat", "in": ["sc[range(inputs - nmsg, inputs)]"], "out": "s"},
          {"op": "max", "out": "mx"},
          {"op": "stated", "in": ["s", "mx"], "width": "(inputs) - (inputs - nmsg)", "expr": "exp(x - y)", "out": "ex"},
          {"op": "sum", "out": "se"},
          {"op": "stated", "in": ["ex", "se"], "width": "(inputs) - (inputs - nmsg)", "expr": "x / y", "out": "pr"},
          {
            "op": "each",
            "var": "j",
            "start": "inputs - nmsg",
            "count": "inputs",
            "ops": [
              {"op": "slice", "in": ["pr"], "offset": "j - (inputs - nmsg)", "width": "1", "out": "pj"},
              {"op": "stated", "in": ["pj", "nv[j]"], "width": "embd", "expr": "x * y", "out": "part"},
              {"op": "let", "if": "j == (inputs - nmsg)", "in": ["part"], "out": "acc"},
              {"op": "add", "if": "j > (inputs - nmsg)", "in": ["acc", "part"], "out": "acc"}
            ]
          },
          {"op": "let", "in": ["acc"]}
        ]
      },
      "block": {
        "bank": "own_bank",
        "pre": {
          "if": "restart",
          "from": ["run", "@base1"],
          "read": [{"op": "let", "in": ["in1"]}],
          "exports": ["@0"],
          "writes": {
            "var": "k",
            "ops": [
              {"op": "let", "if": "k == 0", "in": ["in1"]},
              {"op": "let", "if": "k == pstream", "in": ["in2"]},
              {"op": "let", "if": "k != 0 and k != pstream", "in": ["in"]}
            ]
          }
        },
        "attn": {
          "read_if": "page > 0",
          "join_if": "boundary",
          "from": ["@seen + ['run'] + msg_from"],
          "read": [
            {"op": "call", "if": "sliding", "def": "mix", "w": ["attn_res_score"], "out": "a"},
            {"op": "call", "if": "not sliding", "def": "mix", "w": ["attn_res_score_q"], "out": "a"},
            {"op": "call", "if": "not sliding", "def": "mix", "w": ["attn_res_score_k"], "out": "b"},
            {"op": "call", "if": "not sliding", "def": "mix", "w": ["attn_res_score_v"], "out": "c"},
            {"op": "call", "if": "msgs", "def": "msg", "w": ["loop_msg_q"], "out": "mq"},
            {"op": "call", "if": "msgs", "def": "msg", "w": ["loop_msg_k"], "out": "mk"},
            {"op": "call", "if": "msgs", "def": "msg", "w": ["loop_msg_v"], "out": "mv"},
            {"op": "concat", "if": "sliding and msgs", "in": ["a", "mq", "mk", "mv"]},
            {"op": "concat", "if": "not sliding and not msgs", "in": ["a", "b", "c"]},
            {"op": "concat", "if": "not sliding and msgs", "in": ["a", "b", "c", "mq", "mk", "mv"]}
          ],
          "join": [{"op": "let", "in": ["in1"]}]
        },
        "ffn": {
          "from": ["@seen + own + ['run'] + msg_from"],
          "read": [
            {"op": "call", "def": "mix", "w": ["ffn_res_score"], "out": "f"},
            {"op": "call", "if": "msgs", "def": "msg", "w": ["loop_msg_ffn"], "out": "mm"},
            {"op": "concat", "if": "msgs", "in": ["f", "mm"]}
          ]
        }
      },
      "head": {
        "read_if": "dense('output_res_score')",
        "from": ["@range(1, base1) + [base1] + range(lastbase + 1, lastbase + nl) + range(post0, pstream) + ['run']"],
        "read": [{"op": "call", "def": "mix", "w": ["output_res_score"], "out": "o"}]
      }
    }
  }
}

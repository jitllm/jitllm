{
  "classes": ["Phi3ForCausalLM"],
  "config": {
    "arch": "phi3",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 32"},
      "context_length":                   {"uint": "max_position_embeddings ?? 4096"},
      "embedding_length":                 {"uint": "hidden_size ?? 3072"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 8192"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 32)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.dimension_count":             {"uint": "(head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32)) * (rope_parameters.partial_rotary_factor ?? partial_rotary_factor ?? 1)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"}
    },
    "vocab": "vocab_size ?? 32064",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window ?? 0", "used": "true"}
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.qkv_proj.weight": [
        {"role": "attn_q.weight", "do": [{"reshape": ["((num_attention_heads ?? 32) + 2 * (num_key_value_heads ?? (num_attention_heads ?? 32))) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))", "hidden_size ?? 3072"]}, {"slice": [0, 0, "(num_attention_heads ?? 32) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))"]}]},
        {"role": "attn_k.weight", "do": [{"reshape": ["((num_attention_heads ?? 32) + 2 * (num_key_value_heads ?? (num_attention_heads ?? 32))) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))", "hidden_size ?? 3072"]}, {"slice": [0, "(num_attention_heads ?? 32) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))", "(num_key_value_heads ?? (num_attention_heads ?? 32)) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))"]}]},
        {"role": "attn_v.weight", "do": [{"reshape": ["((num_attention_heads ?? 32) + 2 * (num_key_value_heads ?? (num_attention_heads ?? 32))) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))", "hidden_size ?? 3072"]}, {"slice": [0, "((num_attention_heads ?? 32) + (num_key_value_heads ?? (num_attention_heads ?? 32))) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))", "(num_key_value_heads ?? (num_attention_heads ?? 32)) * (head_dim ?? (hidden_size ?? 3072) / (num_attention_heads ?? 32))"]}]}],
      "self_attn.o_proj.weight":         "attn_output.weight",
      "mlp.gate_up_proj.weight": [
        {"role": "ffn_gate.weight", "do": [{"reshape": ["2 * (intermediate_size ?? 8192)", "hidden_size ?? 3072"]}, {"slice": [0, 0, "intermediate_size ?? 8192"]}]},
        {"role": "ffn_up.weight", "do": [{"reshape": ["2 * (intermediate_size ?? 8192)", "hidden_size ?? 3072"]}, {"slice": [0, "intermediate_size ?? 8192", "intermediate_size ?? 8192"]}]}],
      "mlp.down_proj.weight":            "ffn_down.weight"
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

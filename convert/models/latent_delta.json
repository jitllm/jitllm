{
  "classes": ["KimiK3ForConditionalGeneration"],
  "template": "kimi_k3_chat.jinja",
  "config": {
    "root": "text_config",
    "defaults": {"vocab_size": 163840, "hidden_size": 4096, "intermediate_size": 11008, "num_hidden_layers": 32, "num_attention_heads": 32,
                 "hidden_act": "silu", "rms_norm_eps": 1e-6, "max_position_embeddings": 4096, "mla_use_nope": false,
                 "moe_renormalize": true, "moe_router_activation_func": "sigmoid", "routed_scaling_factor": 1.0, "first_k_dense_replace": 0,
                 "moe_layer_freq": 1, "use_grouped_topk": true, "num_expert_group": 1, "topk_group": 1, "topk_method": "noaux_tc",
                 "num_nextn_predict_layers": 0, "num_experts_per_token": 0, "moe_intermediate_size": 0, "num_shared_experts": 0},
    "arch": "kimi-k3",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers"},
      "context_length":                   {"uint": "max_position_embeddings"},
      "embedding_length":                 {"uint": "hidden_size"},
      "feed_forward_length":              {"uint": "intermediate_size"},
      "attention.head_count":             {"uint": "num_attention_heads"},
      "attention.head_count_kv":          {"int32s": "each_layer(num_hidden_layers, linear_attn_config.full_attn_layers, 1, 1, 0)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps"},
      "ssm.conv_kernel":                  {"uint": "linear_attn_config.short_conv_kernel_size"},
      "kda.head_dim":                     {"uint": "linear_attn_config.head_dim"},
      "kda.gate_lower_bound":             {"float": "linear_attn_config.gate_lower_bound", "if": "linear_attn_config.gate_lower_bound != null"},
      "attention.kv_lora_rank":           {"uint": "kv_lora_rank"},
      "attention.q_lora_rank":            {"uint": "q_lora_rank", "if": "(q_lora_rank ?? 0) != 0"},
      "rope.dimension_count":             {"uint": "qk_rope_head_dim"},
      "attention.key_length":             {"uint": "kv_lora_rank + qk_rope_head_dim"},
      "attention.value_length":           {"uint": "kv_lora_rank"},
      "attention.key_length_mla":         {"uint": "qk_nope_head_dim + qk_rope_head_dim"},
      "attention.value_length_mla":       {"uint": "v_head_dim"},
      "leading_dense_block_count":        {"uint": "first_k_dense_replace"},
      "attn_res.block_size":              {"uint": "attn_res_block_size", "if": "attn_res_block_size != null"},
      "expert_latent_length":             {"uint": "routed_expert_hidden_size", "if": "routed_expert_hidden_size != null"},
      "activation.situ_beta":             {"float": "activation_situ_beta ?? 0"},
      "activation.situ_linear_beta":      {"float": "activation_situ_linear_beta ?? 0"},
      "expert_count":                     {"uint": "num_experts"},
      "expert_used_count":                {"uint": "num_experts_per_token"},
      "expert_feed_forward_length":       {"uint": "moe_intermediate_size"},
      "expert_shared_count":              {"uint": "num_shared_experts"},
      "expert_weights_scale":             {"float": "routed_scaling_factor"},
      "expert_weights_norm":              {"bool": "moe_renormalize"},
      "expert_group_used_count":          {"uint": "!use_grouped_topk || num_expert_group <= 1 || num_expert_group <= topk_group ? 1 : topk_group"},
      "expert_group_count":               {"uint": "num_expert_group", "if": "use_grouped_topk && num_expert_group > 1 && num_expert_group > topk_group"}
    },
    "vocab": "vocab_size",
    "head": {"tensor": "language_model.lm_head.weight", "tied": "$.tie_word_embeddings ?? tie_word_embeddings ?? false"},
    "activation": "hidden_act",
    "gating": "sigmoid",
    "require": [
      {"that": "hidden_act == 'situ'", "else": "hidden_act is not situ, and Kimi-K3's FFNs are situ"},
      {"that": "mla_use_nope == true", "else": "mla_use_nope is false or absent (the class's default), and Kimi-K3's latent attention has no positional encoding"},
      {"that": "moe_router_activation_func == 'sigmoid'", "else": "moe_router_activation_func is not sigmoid, and Kimi-K3 routes with a sigmoid"},
      {"that": "topk_method == 'noaux_tc'", "else": "topk_method is not noaux_tc, and Kimi-K3 selects with the correction bias"},
      {"that": "moe_layer_freq == 1", "else": "moe_layer_freq is not 1: this container states the dense run as a length, and a mixture every few blocks is not one"},
      {"that": "num_nextn_predict_layers == 0", "else": "num_nextn_predict_layers is not 0: Kimi-K3's prediction blocks are not implemented"},
      {"that": "linear_attn_config != null", "else": "no linear_attn_config: Kimi-K3 is a hybrid and the layer kinds are read there"},
      {"that": "linear_attn_config.use_full_rank_gate == true", "else": "linear_attn_config.use_full_rank_gate is false or absent (the class's default): Kimi-Linear's low-rank KDA output gate under Kimi-K3 is not implemented"},
      {"that": "linear_attn_config.num_heads == num_attention_heads", "else": "linear_attn_config.num_heads differs from num_attention_heads: the container's KDA heads are the attention's"},
      {"that": "partitions(num_hidden_layers, 1, linear_attn_config.kda_layers, linear_attn_config.full_attn_layers)", "else": "linear_attn_config names a layer twice, outside the model, or in neither kda_layers nor full_attn_layers (one-indexed)"},
      {"that": "(kv_lora_rank ?? 0) != 0 && (qk_nope_head_dim ?? 0) != 0 && (qk_rope_head_dim ?? 0) != 0 && (v_head_dim ?? 0) != 0", "else": "kv_lora_rank, qk_nope_head_dim, qk_rope_head_dim or v_head_dim is absent, and Kimi-K3's full blocks are MLA"},
      {"that": "(num_experts ?? 0) != 0", "else": "no num_experts: Kimi-K3's blocks after the dense lead are mixtures"},
      {"that": "(rope_parameters.rope_type ?? 'default') == 'default' && (rope_parameters.type ?? 'default') == 'default' && (rope_scaling.rope_type ?? 'default') == 'default' && (rope_scaling.type ?? 'default') == 'default'", "else": "a rotary scaling on a model with no rotary (mla_use_nope)"},
      {"that": "rope_scaling.rope_theta == null || rope_scaling.rope_theta == (rope_parameters.rope_theta ?? rope_theta ?? 10000)", "else": "rope_scaling states another rope_theta"}
    ]
  },
  "tensors": {
    "block_prefix": "language_model.model.layers.",
    "model": {"language_model.model.embed_tokens.weight": "token_embd.weight", "language_model.model.norm.weight": "output_norm.weight",
              "language_model.lm_head.weight": "output.weight"},
    "block": {
      "input_layernorm.weight": "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight": "attn_q.weight",
      "self_attn.q_a_proj.weight": "attn_q_a.weight",
      "self_attn.q_a_layernorm.weight": "attn_q_a_norm.weight",
      "self_attn.q_b_proj.weight": "attn_q_b.weight",
      "self_attn.kv_a_proj_with_mqa.weight": "attn_kv_a_mqa.weight",
      "self_attn.kv_a_layernorm.weight": "attn_kv_a_norm.weight",
      "self_attn.kv_b_proj.weight": [{"role": "attn_k_b.weight", "do": [{"reshape": ["num_attention_heads", "qk_nope_head_dim + v_head_dim", "kv_lora_rank"]}, {"slice": [1, 0, "qk_nope_head_dim"]}, {"transpose": [0, 2, 1]}]}, {"role": "attn_v_b.weight", "do": [{"reshape": ["num_attention_heads", "qk_nope_head_dim + v_head_dim", "kv_lora_rank"]}, {"slice": [1, "qk_nope_head_dim", "v_head_dim"]}]}],
      "self_attn.o_proj.weight": "attn_output.weight",
      "self_attn.g_proj.weight": "attn_gate.weight",
      "mlp.gate_proj.weight": "ffn_gate.weight",
      "mlp.up_proj.weight": "ffn_up.weight",
      "mlp.down_proj.weight": "ffn_down.weight",
      "block_sparse_moe.gate.weight": "ffn_gate_inp.weight",
      "block_sparse_moe.gate.e_score_correction_bias": "exp_probs_b.bias",
      "block_sparse_moe.routed_expert_down_proj.weight": "ffn_routed_down.weight",
      "block_sparse_moe.routed_expert_norm.weight": "ffn_routed_norm.weight",
      "block_sparse_moe.routed_expert_up_proj.weight": "ffn_routed_up.weight",
      "block_sparse_moe.shared_experts.gate_proj.weight": "ffn_gate_shexp.weight",
      "block_sparse_moe.shared_experts.up_proj.weight": "ffn_up_shexp.weight",
      "block_sparse_moe.shared_experts.down_proj.weight": "ffn_down_shexp.weight"
    },
    "block_linear": {
      "self_attn.q_proj.weight": "attn_qkv.weight",
      "self_attn.k_proj.weight": "attn_qkv.weight",
      "self_attn.v_proj.weight": "attn_qkv.weight",
      "self_attn.q_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size"]}]},
      "self_attn.k_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size"]}]},
      "self_attn.v_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size"]}]},
      "self_attn.b_proj.weight": "ssm_ba.weight",
      "self_attn.f_a_proj.weight": "ssm_f_a.weight",
      "self_attn.f_b_proj.weight": "ssm_f_b.weight",
      "self_attn.A_log": {"role": "ssm_a", "do": [{"reshape": [-1]}, {"trim": [0, "num_attention_heads"]}, {"map": "-exp(x)"}, {"repeat": [0, "linear_attn_config.head_dim"]}]},
      "self_attn.dt_bias": "ssm_dt.bias",
      "self_attn.o_norm.weight": "ssm_norm.weight",
      "self_attn.o_proj.weight": "ssm_out.weight"
    },
    "fuse": {"attn_qkv.weight": ["self_attn.q_proj.weight", "self_attn.k_proj.weight", "self_attn.v_proj.weight"],
             "ssm_conv1d.weight": ["self_attn.q_conv1d.weight", "self_attn.k_conv1d.weight", "self_attn.v_conv1d.weight"]},
    "experts": {"prefix": "block_sparse_moe.experts.", "names": {"w1.weight": "ffn_gate_exps.weight", "w3.weight": "ffn_up_exps.weight", "w2.weight": "ffn_down_exps.weight"}},
    "gather": [
      {"role": "attn_res_score.weight", "from": ["self_attention_res_norm.weight", "self_attention_res_proj.weight"], "do": [{"map": "x * y"}],
       "if": "(attn_res_block_size ?? 0) != 0", "every": true, "name": "{block}self_attention_res_norm*proj", "count": "hidden_size"},
      {"role": "ffn_res_score.weight", "from": ["mlp_res_norm.weight", "mlp_res_proj.weight"], "do": [{"map": "x * y"}],
       "if": "(attn_res_block_size ?? 0) != 0", "every": true, "name": "{block}mlp_res_norm*proj", "count": "hidden_size"},
      {"role": "output_res_score.weight", "from": ["language_model.model.output_attn_res_norm.weight", "language_model.model.output_attn_res_proj.weight"],
       "do": [{"map": "x * y"}], "if": "(attn_res_block_size ?? 0) != 0", "model": true, "name": "language_model.model.output_attn_res_norm*proj",
       "count": "hidden_size"}
    ],
    "ignore_prefix": ["vision_tower.", "mm_projector."]
  },
  "gguf": ["kimi-k3"],
  "container": {
    "kimi-k3": {"latent": {"kv": "src['attention.kv_lora_rank'] | default(0)", "q": "src['attention.q_lora_rank'] | default(0)", "norm_eps": "1e-6"},
      "flags": {"no_pos_enc": "true"}, "router": {"gate": "sigmoid"},
      "layers_by_kv_heads": true,
      "tensors": {
        "block_linear": {
          "attn_q.weight": "attn_qkv.weight", "attn_k.weight": "attn_qkv.weight", "attn_v.weight": "attn_qkv.weight",
          "ssm_conv1d_q.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "ssm.conv_kernel"]}]},
          "ssm_conv1d_k.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "ssm.conv_kernel"]}]},
          "ssm_conv1d_v.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "ssm.conv_kernel"]}]},
          "attn_output.weight": "ssm_out.weight",
          "ssm_a": {"role": "ssm_a", "do": [{"reshape": [-1]}, {"repeat": [0, "kda.head_dim"]}]}
        },
        "fuse": {"attn_qkv.weight": ["attn_q.weight", "attn_k.weight", "attn_v.weight"],
                 "ssm_conv1d.weight": ["ssm_conv1d_q.weight", "ssm_conv1d_k.weight", "ssm_conv1d_v.weight"]}
      },
      "recurrent": {"conv_kernel": "src['ssm.conv_kernel']", "groups": "src['attention.head_count']", "heads_v": "src['attention.head_count']",
                    "state_size": "src['kda.head_dim']", "inner": "src['attention.head_count'] * src['kda.head_dim']"},
      "delta_decay_bound": "src['kda.gate_lower_bound'] | default(none)",
      "attn_res_block": "src['attn_res.block_size'] | default(0)", "expert_latent": "src['expert_latent_length'] | default(0)",
      "situ": {"beta": "src['activation.situ_beta'] | default(0)", "linear_beta": "src['activation.situ_linear_beta'] | default(0)"}}
  },
  "go_classes": ["KimiLinearForCausalLM"],
  "graph": {
    "block": [
      {"op": "in", "out": "x", "width": "embd"},
      {"op": "streams_in", "if": "streams > 1", "in": "x", "out": "xs"},
      {"op": "let", "in": "x", "out": "ai"},
      {"op": "stream_read", "if": "streams > 1", "of": "attn", "streams": "xs", "in": ["x", "x"], "out": "ai"},
      {"op": "norm", "in": "ai", "w": "attn_norm", "out": "n"},
      {"op": "matvec", "in": "n", "w": "attn_qkv", "rows": "chans", "out": "mixed", "if": "linear"},
      {"op": "emit", "kind": "state_conv", "in": "mixed", "attr": {"Taps": "conv"}, "advances": ["rec.conv"], "bind": [{"w": "ssm_conv1d", "k": "conv", "rows": "chans"}], "outs": [{"name": "conv", "width": "chans"}], "out": "conv", "if": "linear"},
      {"op": "silu", "name": "conv.act", "in": "conv", "out": "act", "if": "linear"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "0", "Width": "k_heads * k_dim"}, "outs": [{"name": "q", "width": "k_heads * k_dim"}], "out": "q", "if": "linear"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "k_heads * k_dim", "Width": "k_heads * k_dim"}, "outs": [{"name": "k", "width": "k_heads * k_dim"}], "out": "k", "if": "linear"},
      {"op": "emit", "kind": "slice", "in": "act", "attr": {"Offset": "2 * k_heads * k_dim", "Width": "v_heads * v_dim"}, "outs": [{"name": "v", "width": "v_heads * v_dim"}], "out": "v", "if": "linear"},
      {"op": "emit", "kind": "head_norm", "in": "k", "attr": {"Eps": "1e-6 / k_dim", "HeadDim": "k_dim"}, "outs": [{"name": "k.unit", "width": "k_heads * k_dim"}], "out": "k", "if": "linear"},
      {"op": "emit", "kind": "map", "in": "k", "attr": {"Fn": "'mul'", "Const": "delta_scale"}, "outs": [{"name": "k.unit.scaled", "width": "k_heads * k_dim"}], "out": "k", "if": "linear"},
      {"op": "emit", "kind": "head_norm", "in": "q", "attr": {"Eps": "1e-6 / k_dim", "HeadDim": "k_dim"}, "outs": [{"name": "q.unit", "width": "k_heads * k_dim"}], "out": "q", "if": "linear"},
      {"op": "emit", "kind": "map", "in": "q", "attr": {"Fn": "'mul'", "Const": "delta_scale"}, "outs": [{"name": "q.unit.scaled", "width": "k_heads * k_dim"}], "out": "q", "if": "linear"},
      {"op": "emit", "kind": "map", "in": "q", "attr": {"Fn": "'mul'", "Const": "delta_scale"}, "outs": [{"name": "q.scaled", "width": "k_heads * k_dim"}], "out": "q", "if": "linear"},
      {"op": "matvec", "if": "(linear) and (stored('ssm_g_a'))", "in": "n", "w": "ssm_g_a", "rows": "rows('ssm_g_a')", "out": "za"},
      {"op": "matvec", "if": "(linear) and (stored('ssm_g_a'))", "in": "za", "w": "ssm_g_b", "rows": "v_heads * v_dim", "out": "z"},
      {"op": "matvec", "if": "(linear) and (not stored('ssm_g_a'))", "in": "n", "w": "attn_gate", "rows": "v_heads * v_dim", "out": "z"},
      {"op": "matvec", "in": "n", "w": "ssm_f_a", "rows": "rows('ssm_f_a')", "out": "fa", "if": "linear"},
      {"op": "matvec", "in": "fa", "w": "ssm_f_b", "rows": "v_heads * k_dim", "out": "alpha", "if": "linear"},
      {"op": "matvec", "in": "n", "w": "ssm_ba", "rows": "v_heads", "out": "braw", "if": "linear"},
      {"op": "stated", "of": "delta_decay", "in": "alpha", "out": "decay", "if": "linear"},
      {"op": "emit", "kind": "map", "in": "braw", "attr": {"Fn": "'sigmoid'"}, "outs": [{"name": "beta", "width": "v_heads"}], "out": "beta", "if": "linear"},
      {"op": "emit", "if": "linear and tiled", "kind": "tile", "in": "q", "outs": [{"name": "q.tiled", "width": "v_heads * k_dim"}], "out": "q"},
      {"op": "emit", "if": "linear and tiled", "kind": "tile", "in": "k", "outs": [{"name": "k.tiled", "width": "v_heads * k_dim"}], "out": "k"},
      {"op": "emit", "if": "linear", "kind": "state_scan", "in": ["q", "k", "v", "decay", "beta"], "advances": ["rec.state"], "attr": {"NHead": "v_heads", "NKVHead": "v_heads if tiled else k_heads", "HeadDim": "k_dim", "Span": "state_span", "Update": "5"}, "axes": ["'head col' if tiled else 'group col'", "'head col' if tiled else 'group col'", "'head row'", "'head col' if stored('ssm_f_b') else 'head'", "'head'"], "terms": [{"fn": "mul", "args": [{"state": true}, {"in": 3}]}, {"fn": "mul", "args": [{"term": 0}, {"in": 1}]}, {"fn": "sub", "args": [{"in": 2}, {"sum": 1}]}, {"fn": "mul", "args": [{"term": 2}, {"in": 4}]}, {"fn": "mul", "args": [{"in": 1}, {"term": 3}]}, {"fn": "add", "args": [{"term": 0}, {"term": 4}]}, {"fn": "mul", "args": [{"term": 5}, {"in": 0}]}], "outs": [{"name": "delta", "width": "v_heads * v_dim"}], "out": "o"},
      {"op": "head_norm", "in": "o", "w": "ssm_norm", "width": "v_dim", "out": "o", "if": "linear"},
      {"op": "stated", "of": "delta_gate", "in": ["z", "o"], "out": "mix", "if": "linear"},
      {"op": "matvec", "in": "mix", "w": ["ssm_out", "attn_output.bias?"], "rows": "embd", "out": "o", "if": "linear"},
      {"op": "matvec", "if": "(not linear) and (stored('attn_q_a'))", "in": "n", "w": "attn_q_a", "rows": "rows('attn_q_a')", "out": "qa"},
      {"op": "norm", "if": "(not linear) and (stored('attn_q_a'))", "in": "qa", "w": "attn_q_a_norm", "eps": "latent_eps", "out": "qa"},
      {"op": "matvec", "if": "(not linear) and (stored('attn_q_a'))", "in": "qa", "w": ["attn_q_b", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "if": "(not linear) and (not stored('attn_q_a'))", "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec", "in": "n", "w": "attn_kv_a_mqa", "rows": "kv_lora + rot", "out": "kv", "if": "not linear"},
      {"op": "emit", "kind": "slice", "in": "kv", "attr": {"Offset": "0", "Width": "kv_lora"}, "outs": [{"name": "latent", "width": "kv_lora"}], "out": "lat", "if": "not linear"},
      {"op": "norm", "in": "lat", "w": "attn_kv_a_norm", "eps": "latent_eps", "out": "lat", "if": "not linear"},
      {"op": "emit", "kind": "slice", "in": "kv", "attr": {"Offset": "kv_lora", "Width": "rot"}, "outs": [{"name": "k.pe", "width": "rot"}], "out": "kpe", "if": "not linear"},
      {"op": "emit", "kind": "slice", "in": "q", "attr": {"HeadDim": "head_dim", "Offset": "head_dim - rot", "Width": "rot"}, "outs": [{"name": "q.pe", "width": "heads * rot"}], "out": "qpe", "if": "not linear"},
      {"op": "rope", "if": "(not linear) and (rope_at)", "in": "qpe", "name": "q.pe.rope", "attr": {"HeadDim": "rot", "Offset": "0"}, "out": "qpe"},
      {"op": "rope", "if": "(not linear) and (rope_at)", "in": "kpe", "name": "k.pe.rope", "attr": {"HeadDim": "rot", "Offset": "0"}, "out": "kpe"},
      {"op": "emit", "kind": "slice", "in": "q", "attr": {"HeadDim": "head_dim", "Offset": "0", "Width": "head_dim - rot"}, "outs": [{"name": "q.nope", "width": "heads * (head_dim - rot)"}], "out": "qn", "if": "not linear"},
      {"op": "emit", "kind": "expert_matvec", "in": "qn", "bind": [{"w": "attn_k_b", "k": "head_dim - rot", "rows": "kv_lora", "sheets": "heads"}], "outs": [{"name": "q.abs", "width": "heads * kv_lora"}], "out": "qabs", "if": "not linear"},
      {"op": "emit", "kind": "concat", "in": ["qabs", "qpe"], "attr": {"NHead": "heads"}, "outs": [{"name": "q.row", "width": "heads * (kv_lora + rot)"}], "out": "qrow", "if": "not linear"},
      {"op": "let", "if": "(not linear) and (selects and not stored('attn_q_a'))", "in": "n", "out": "qa"},
      {"op": "indexer", "if": "(not linear) and (selects)", "in": ["n", "qa"], "out": "ix"},
      {"op": "emit", "if": "(not linear) and (not selects)", "kind": "concat", "in": ["lat", "kpe"], "outs": [{"name": "kv.row", "width": "kv_lora + rot"}], "out": "krow"},
      {"op": "emit", "if": "(not linear) and (selects)", "kind": "concat", "in": ["lat", "kpe", "ix.key"], "outs": [{"name": "kv.row", "width": "kv_lora + rot + key_width"}], "out": "krow"},
      {"op": "kv_append", "in": ["krow", "krow"], "out": "hist", "if": "not linear"},
      {"op": "select", "if": "(not linear) and (selects and select_weighted)", "in": ["ix.query", "ix.weight"], "hist": "hist", "attr": {"Offset": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "sel"},
      {"op": "select", "if": "(not linear) and (selects and not select_weighted)", "in": "ix.query", "hist": "hist", "attr": {"Offset": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "sel"},
      {"op": "attend", "if": "(not linear) and (not selects)", "in": "qrow", "hist": "hist", "w": "attn_sinks?", "attr": {"NKVHead": "1", "HeadDim": "kv_lora + rot"}, "out": "att"},
      {"op": "attend", "if": "(not linear) and (selects)", "in": ["qrow", "sel"], "hist": "hist", "w": "attn_sinks?", "attr": {"NKVHead": "1", "HeadDim": "kv_lora + rot", "Width": "kv_lora + rot + key_width"}, "out": "att"},
      {"op": "emit", "kind": "slice", "in": "att", "attr": {"HeadDim": "kv_lora + rot", "Offset": "0", "Width": "kv_lora"}, "outs": [{"name": "att.latent", "width": "heads * kv_lora"}], "out": "al", "if": "not linear"},
      {"op": "emit", "kind": "expert_matvec", "in": "al", "bind": [{"w": "attn_v_b", "k": "kv_lora", "rows": "v_head_dim", "sheets": "heads"}], "outs": [{"name": "att.v", "width": "heads * v_head_dim"}], "out": "o", "if": "not linear"},
      {"op": "matvec", "if": "(not linear) and (stored('attn_gate'))", "in": "n", "w": "attn_gate", "rows": "heads * v_head_dim", "out": "ag"},
      {"op": "sigmoid_mul", "if": "(not linear) and (stored('attn_gate'))", "name": "att.gated", "in": ["ag", "o"], "out": "o"},
      {"op": "matvec", "in": "o", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o", "if": "not linear"},
      {"op": "add", "if": "not (streams > 1 and attn_join)", "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "stream_join", "if": "streams > 1 and attn_join", "of": "attn", "streams": "xs", "in": ["x", "o"], "out": "h"},
      {"op": "let", "in": "h", "out": "fi"},
      {"op": "stream_read", "if": "streams > 1", "of": "ffn", "streams": "xs", "in": ["x", "h"], "out": "fi"},
      {"op": "norm", "in": "fi", "w": "ffn_norm", "out": "m"},
      {"op": "matvec", "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec", "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act", "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec", "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark", "if": "moe", "out": "routed"},
      {"op": "let", "if": "moe", "in": "m", "out": "ei"},
      {"op": "matvec", "if": "moe and stored('ffn_routed_down')", "in": "m", "w": "ffn_routed_down", "rows": "rows('ffn_routed_down')", "out": "ei"},
      {"op": "matvec", "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated", "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "let", "if": "moe", "in": "score", "out": "choose"},
      {"op": "emit", "if": "moe and stored('exp_probs_b.bias')", "kind": "map", "in": "score", "attr": {"Fn": "'add'"}, "bind": [{"w": "exp_probs_b.bias"}], "outs": [{"name": "router.biased", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "top_k", "in": "choose", "attr": {"TopK": "[2, experts // expert_groups] | min", "Span": "experts // expert_groups"}, "outs": [{"name": "router.group.sel", "width": "expert_groups * ([2, experts // expert_groups] | min)", "elem": "u32"}, {"name": "router.group.best", "width": "expert_groups * ([2, experts // expert_groups] | min)", "as": "gbest"}]},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "reduce", "in": "gbest", "attr": {"Fn": "'add'", "Span": "[2, experts // expert_groups] | min"}, "outs": [{"name": "router.group.score", "width": "expert_groups"}], "out": "gscore"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "rank", "in": "gscore", "outs": [{"name": "router.group.rank", "width": "expert_groups", "elem": "u32"}], "out": "grank"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": "grank", "attr": {"Fn": "'less'", "Const": "expert_groups_used"}, "outs": [{"name": "router.group.kept", "width": "expert_groups"}], "out": "gkept"},
      {"op": "emit", "if": "moe and expert_groups > 1", "kind": "map", "in": ["gkept", "choose"], "attr": {"Fn": "'where'", "Const": "-inf"}, "outs": [{"name": "router.kept", "width": "experts"}], "out": "choose"},
      {"op": "emit", "if": "moe", "kind": "top_k", "in": "choose", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit", "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit", "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe and expert_scale != 0 and expert_scale != 1", "kind": "map", "in": "w", "attr": {"Fn": "'mul'", "Const": "expert_scale"}, "outs": [{"name": "router.scaled", "width": "experts_used"}], "out": "w"},
      {"op": "emit", "if": "moe", "kind": "tile", "in": "ei", "attr": {"Span": "(rows('ffn_routed_down') if stored('ffn_routed_down') else embd)"}, "outs": [{"name": "experts.in", "width": "experts_used * (rows('ffn_routed_down') if stored('ffn_routed_down') else embd)"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "(rows('ffn_routed_down') if stored('ffn_routed_down') else embd)", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "(rows('ffn_routed_down') if stored('ffn_routed_down') else embd)", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit", "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * (rows('ffn_routed_down') if stored('ffn_routed_down') else embd)"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "(rows('ffn_routed_down') if stored('ffn_routed_down') else embd)", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "(rows('ffn_routed_down') if stored('ffn_routed_down') else embd)", "rows": "experts"}], "out": "ed"},
      {"op": "emit", "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * (rows('ffn_routed_down') if stored('ffn_routed_down') else embd)"}], "out": "ed"},
      {"op": "split_sum", "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed", "if": "moe", "from": "routed"},
      {"op": "norm", "if": "moe and stored('ffn_routed_norm')", "in": "d", "w": "ffn_routed_norm", "out": "d"},
      {"op": "matvec", "if": "moe and stored('ffn_routed_up')", "in": "d", "w": "ffn_routed_up", "rows": "embd", "out": "d"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "in": "m", "w": "ffn_gate_shexp", "rows": "rows('ffn_up_shexp')", "out": "sg"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "m", "w": "ffn_up_shexp", "rows": "rows('ffn_up_shexp')", "out": "su"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and stored('ffn_gate_shexp'))", "name": "shared.act", "in": ["sg", "su"], "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "act", "if": "(stored('ffn_up_shexp')) and (moe and not stored('ffn_gate_shexp'))", "name": "shared.act", "in": "su", "width": "rows('ffn_up_shexp')", "out": "sa"},
      {"op": "matvec", "if": "(stored('ffn_up_shexp')) and (moe)", "in": "sa", "w": "ffn_down_shexp", "rows": "embd", "out": "so"},
      {"op": "add", "if": "(stored('ffn_up_shexp')) and (moe)", "in": ["d", "so"], "out": "d"},
      {"op": "add", "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out_streams", "if": "streams > 1", "streams": "xs", "in": "y"},
      {"op": "out", "if": "streams < 2", "in": "y"}
    ],
    "streams": {
      "if": "attn_res_block > 0",
      "count": "1 + (trunk + attn_res_block - 1) // attn_res_block",
      "defs": {
        "bank": [
          {"op": "each", "var": "j", "count": "inputs", "ops": [
            {"op": "rms_norm", "in": ["@j"], "eps": "eps"},
            {"op": "scale",    "w": ["$0"]},
            {"op": "sum",      "out": "sc[j]"}
          ]},
          {"op": "concat", "in": ["sc[range(inputs)]"], "out": "s"},
          {"op": "max",    "out": "mx"},
          {"op": "stated", "in": ["s", "mx"], "width": "inputs", "expr": "exp(x - y)", "out": "ex"},
          {"op": "sum",    "out": "se"},
          {"op": "stated", "in": ["ex", "se"], "width": "inputs", "expr": "x / y", "out": "pr"},
          {"op": "each", "var": "j", "count": "inputs", "ops": [
            {"op": "slice",  "in": ["pr"], "offset": "j", "width": "1", "out": "pj"},
            {"op": "stated", "in": ["pj", "@j"], "width": "embd", "expr": "x * y", "out": "part"},
            {"op": "let",    "if": "j == 0", "in": ["part"], "out": "acc"},
            {"op": "add",    "if": "j > 0", "in": ["acc", "part"], "out": "acc"}
          ]},
          {"op": "let", "in": ["acc"]}
        ]
      },
      "block": {
        "bank": "1 + layer // attn_res_block if layer % attn_res_block == 0 else 0",
        "attn": {
          "read_if": "stored('attn_res_score')",
          "join_if": "layer % attn_res_block == 0",
          "from": ["@range(1, (layer + attn_res_block - 1) // attn_res_block + 1) + ['run']"],
          "read": [{"op": "call", "def": "bank", "w": ["attn_res_score"]}],
          "join": [{"op": "let", "in": ["in1"]}]
        },
        "ffn": {
          "read_if": "stored('ffn_res_score')",
          "from": ["@range(1, layer // attn_res_block + (1 if layer % attn_res_block == 0 else 2)) + (['in'] if layer % attn_res_block == 0 else []) + ['run']"],
          "read": [{"op": "call", "def": "bank", "w": ["ffn_res_score"]}]
        }
      },
      "head": {
        "read_if": "dense('output_res_score')",
        "from": ["@range(1, streams) + ['run']"],
        "read": [{"op": "call", "def": "bank", "w": ["output_res_score"]}]
      }
    }
  }
}

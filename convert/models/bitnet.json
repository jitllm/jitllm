{
  "classes": ["BitNetForCausalLM"],
  "config": {
    "defaults": {"num_key_value_heads": 5},
    "arch": "bitnet-b1.58",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 30"},
      "context_length":                   {"uint": "max_position_embeddings ?? 2048"},
      "embedding_length":                 {"uint": "hidden_size ?? 2560"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 6912"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 20"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 20)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 2560) / (num_attention_heads ?? 20)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 2560) / (num_attention_heads ?? 20)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 500000"}
    },
    "vocab": "vocab_size ?? 128256",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'relu2'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "require": [
      {"that": "(hidden_act ?? 'relu2') == 'relu2'", "else": "hidden_act is not the squared ReLU this graph's feed-forward is gated by"},
      {"that": "(mlp_bias ?? false) == false", "else": "mlp_bias is true, and this container has no feed-forward bias role"},
      {"that": "quantization_config.quant_method == 'bitnet'", "else": "a BitNetForCausalLM without a bitnet quantization_config runs full-precision projections in transformers"},
      {"that": "(quantization_config.use_rms_norm ?? false) == false", "else": "use_rms_norm puts an RMSNorm inside every projection"},
      {"that": "(quantization_config.modules_to_not_convert ?? []) == [] || quantization_config.modules_to_not_convert == ['lm_head']", "else": "modules_to_not_convert names a projection left full precision"},
      {"that": "(quantization_config.linear_class ?? 'bitlinear') in ['bitlinear', 'autobitlinear']", "else": "linear_class is not a BitNet linear"},
      {"that": "(quantization_config.quantization_mode ?? 'offline') in ['offline', 'online']", "else": "quantization_mode is not offline or online"},
      {"that": "!((quantization_config.linear_class ?? 'bitlinear') == 'bitlinear' && (quantization_config.quantization_mode ?? 'offline') == 'online')", "else": "linear_class bitlinear in mode online is not a stored form"}
    ]
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight":         "attn_q.weight",
      "self_attn.k_proj.weight":         "attn_k.weight",
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "self_attn.attn_sub_norm.weight":  "attn_sub_norm.weight",
      "mlp.gate_proj.weight":            "ffn_gate.weight",
      "mlp.up_proj.weight":              "ffn_up.weight",
      "mlp.down_proj.weight":            "ffn_down.weight",
      "mlp.ffn_sub_norm.weight":         "ffn_sub_norm.weight"
    },
    "ternary": {
      "roles": ["attn_q.weight", "attn_k.weight", "attn_v.weight", "attn_output.weight", "ffn_gate.weight", "ffn_up.weight", "ffn_down.weight"],
      "scale": "_scale",
      "latent": "(quantization_config.quantization_mode ?? 'offline') == 'online'",
      "reciprocal": "(quantization_config.linear_class ?? 'bitlinear') == 'bitlinear'"
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

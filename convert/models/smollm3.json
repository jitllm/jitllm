{
  "classes": ["SmolLM3ForCausalLM"],
  "gguf": ["smollm3"],
  "container": {
    "smollm3": {"flags": {"no_pe_global": "true"}, "window": {"size": "0", "period": "4"}}
  },
  "config": {
    "defaults": {"num_key_value_heads": 4},
    "arch": "smollm3",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 36"},
      "context_length":                   {"uint": "max_position_embeddings ?? 32768"},
      "embedding_length":                 {"uint": "hidden_size ?? 2048"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 11008"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 16"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? (num_attention_heads ?? 16)"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-6"},
      "rope.dimension_count":             {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 2000000"}
    },
    "vocab": "vocab_size ?? 128256",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? true"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "use_sliding_window ?? false"},
    "rotary_layers": {"each": "no_rope_layers", "every": "no_rope_layer_interval ?? 4"}
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight":         {"role": "attn_q.weight", "do": [
        {"reshape": ["num_attention_heads ?? 16", 2, "(head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)) / 2", "hidden_size ?? 2048"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_attention_heads ?? 16) * (head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16))", -1]}]},
      "self_attn.k_proj.weight":         {"role": "attn_k.weight", "do": [
        {"reshape": ["num_key_value_heads ?? (num_attention_heads ?? 16)", 2, "(head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)) / 2", "hidden_size ?? 2048"]},
        {"transpose": [0, 2, 1, 3]},
        {"reshape": ["(num_key_value_heads ?? (num_attention_heads ?? 16)) * (head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16))", -1]}]},
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "self_attn.q_proj.bias":           {"role": "attn_q.bias", "do": [
        {"reshape": ["num_attention_heads ?? 16", 2, "(head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)) / 2"]}, {"transpose": [0, 2, 1]}, {"reshape": [-1]}]},
      "self_attn.k_proj.bias":           {"role": "attn_k.bias", "do": [
        {"reshape": ["num_key_value_heads ?? (num_attention_heads ?? 16)", 2, "(head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 16)) / 2"]}, {"transpose": [0, 2, 1]}, {"reshape": [-1]}]},
      "self_attn.v_proj.bias":           "attn_v.bias",
      "self_attn.o_proj.bias":           "attn_output.bias",
      "mlp.gate_proj.weight":            "ffn_gate.weight",
      "mlp.up_proj.weight":              "ffn_up.weight",
      "mlp.down_proj.weight":            "ffn_down.weight"
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "norm",       "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "add",        "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "norm",       "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec",     "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec",     "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act",        "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec",     "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "add",        "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

{
  "describe": {"qwen3moe": "Qwen3 30B-A3B, 235B-A22B", "qwen3vlmoe": "Qwen3-VL mixtures", "Qwen3MoeForCausalLM": "Qwen3 mixtures"},
  "classes": ["Qwen3MoeForCausalLM"],
  "gguf": ["qwen3moe", "qwen3vlmoe"],
  "container": {
    "qwen3moe": {"stop": ["<|im_end|>", "<|endoftext|>"], "tensors": {"sizes": {"q": "at(attention.head_count, block) * (attention.key_length ?? (embedding_length / at(attention.head_count, 0)))",
                            "k": "at(attention.head_count_kv ?? (attention.head_count), block) * (attention.value_length ?? (embedding_length / at(attention.head_count, 0)))",
                            "v": "at(attention.head_count_kv ?? (attention.head_count), block) * (attention.value_length ?? (embedding_length / at(attention.head_count, 0)))"},
                  "block": {"attn_qkv.weight": [
                     {"role": "attn_q.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "0", "size.q"]}]},
                     {"role": "attn_k.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "size.q", "size.k"]}]},
                     {"role": "attn_v.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "size.q + size.k", "size.v"]}]}],
                            "attn_qkv.bias": [
                     {"role": "attn_q.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "0", "size.q"]}]},
                     {"role": "attn_k.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "size.q", "size.k"]}]},
                     {"role": "attn_v.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "size.q + size.k", "size.v"]}]}]}},
      "flags": {"rope_neox": "true", "qk_norm": "true"}, "moe_step": "src['interleave_moe_layer_step'] | default(none)"},
    "qwen3vlmoe": {"stop": ["<|im_end|>", "<|endoftext|>"], "tensors": {"sizes": {"q": "at(attention.head_count, block) * (attention.key_length ?? (embedding_length / at(attention.head_count, 0)))",
                            "k": "at(attention.head_count_kv ?? (attention.head_count), block) * (attention.value_length ?? (embedding_length / at(attention.head_count, 0)))",
                            "v": "at(attention.head_count_kv ?? (attention.head_count), block) * (attention.value_length ?? (embedding_length / at(attention.head_count, 0)))"},
                  "block": {"attn_qkv.weight": [
                     {"role": "attn_q.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "0", "size.q"]}]},
                     {"role": "attn_k.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "size.q", "size.k"]}]},
                     {"role": "attn_v.weight", "do": [{"reshape": ["size.q + size.k + size.v", "embedding_length"]}, {"slice": [0, "size.q + size.k", "size.v"]}]}],
                            "attn_qkv.bias": [
                     {"role": "attn_q.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "0", "size.q"]}]},
                     {"role": "attn_k.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "size.q", "size.k"]}]},
                     {"role": "attn_v.bias", "do": [{"reshape": ["size.q + size.k + size.v"]}, {"slice": [0, "size.q + size.k", "size.v"]}]}]}},
      "flags": {"rope_neox": "true", "qk_norm": "true"}, "rope_layout": "interleaved", "rope_sections": "src['rope.dimension_sections']"}
  },
  "config": {
    "arch": "qwen3moe",
    "keys": {
      "block_count":                      {"uint": "num_hidden_layers ?? 24"},
      "context_length":                   {"uint": "max_position_embeddings ?? 32768"},
      "embedding_length":                 {"uint": "hidden_size ?? 2048"},
      "feed_forward_length":              {"uint": "intermediate_size ?? 6144"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 32"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? 4"},
      "attention.key_length":             {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 32)"},
      "attention.value_length":           {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 32)"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-6"},
      "rope.dimension_count":             {"uint": "head_dim ?? (hidden_size ?? 2048) / (num_attention_heads ?? 32)"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"},
      "expert_count":                     {"uint": "num_experts ?? 128"},
      "expert_used_count":                {"uint": "num_experts_per_tok ?? 8"},
      "expert_feed_forward_length":       {"uint": "moe_intermediate_size ?? 768"},
      "expert_weights_norm":              {"bool": "norm_topk_prob ?? false"},
      "interleave_moe_layer_step":        {"uint": "decoder_sparse_step", "if": "(decoder_sparse_step ?? 1) > 1"}
    },
    "vocab": "vocab_size ?? 151936",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? false"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "use_sliding_window ?? false"},
    "require": [
      {"that": "(mlp_only_layers ?? []) == []",
       "else": "mlp_only_layers lists dense layers by index, which a dense lead and a mixture period do not state"}
    ]
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight":         "output_norm.weight",
      "lm_head.weight":            "output.weight"
    },
    "block": {
      "input_layernorm.weight":          "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight":         "attn_q.weight",
      "self_attn.k_proj.weight":         "attn_k.weight",
      "self_attn.v_proj.weight":         "attn_v.weight",
      "self_attn.o_proj.weight":         "attn_output.weight",
      "self_attn.q_proj.bias":           "attn_q.bias",
      "self_attn.k_proj.bias":           "attn_k.bias",
      "self_attn.v_proj.bias":           "attn_v.bias",
      "self_attn.o_proj.bias":           "attn_output.bias",
      "self_attn.q_norm.weight":         "attn_q_norm.weight",
      "self_attn.k_norm.weight":         "attn_k_norm.weight",
      "mlp.gate_proj.weight":            "ffn_gate.weight",
      "mlp.up_proj.weight":              "ffn_up.weight",
      "mlp.down_proj.weight":            "ffn_down.weight",
      "mlp.gate.weight":                 "ffn_gate_inp.weight"
    },
    "experts": {
      "prefix": "mlp.experts.",
      "names": {
        "gate_proj.weight": "ffn_gate_exps.weight",
        "up_proj.weight":   "ffn_up_exps.weight",
        "down_proj.weight": "ffn_down_exps.weight"
      }
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  },
  "graph": {
    "block": [
      {"op": "in",         "out": "x", "width": "embd"},
      {"op": "in",         "if": "layer < deep_taps", "out": "ple", "width": "side_width"},
      {"op": "norm",       "in": "x", "w": "attn_norm", "out": "n"},
      {"op": "matvec",     "in": "n", "w": ["attn_q", "attn_q.bias?"], "rows": "heads * head_dim", "out": "q"},
      {"op": "matvec",     "in": "n", "w": ["attn_k", "attn_k.bias?"], "rows": "kv_heads * head_dim", "out": "k"},
      {"op": "matvec",     "in": "n", "w": ["attn_v", "attn_v.bias?"], "rows": "kv_heads * head_dim", "out": "v"},
      {"op": "head_norm",  "in": "q", "w": "attn_q_norm", "out": "q"},
      {"op": "head_norm",  "in": "k", "w": "attn_k_norm", "out": "k"},
      {"op": "rope",       "if": "rope_at", "in": "q", "name": "q.rope", "out": "q"},
      {"op": "rope",       "if": "rope_at", "in": "k", "name": "k.rope", "out": "k"},
      {"op": "kv_append",  "in": ["k", "v"], "out": "kv"},
      {"op": "attend",     "in": "q", "hist": "kv", "w": "attn_sinks?", "out": "att"},
      {"op": "matvec",     "in": "att", "w": ["attn_output", "attn_output.bias?"], "rows": "embd", "out": "o"},
      {"op": "add",        "in": ["x", "o"], "alpha": "residual_scale", "out": "h"},
      {"op": "norm",       "in": "h", "w": "ffn_norm", "out": "m"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": "ffn_gate", "rows": "ffn", "out": "g"},
      {"op": "matvec",     "if": "not moe", "in": "m", "w": ["ffn_up", "ffn_up.bias?"], "rows": "ffn", "out": "u"},
      {"op": "act",        "if": "not moe", "in": ["g", "u"], "width": "ffn", "out": "a"},
      {"op": "matvec",     "if": "not moe", "in": "a", "w": ["ffn_down", "ffn_down.bias?"], "rows": "embd", "out": "d"},
      {"op": "mark",       "if": "moe", "out": "routed"},
      {"op": "matvec",     "if": "moe", "in": "m", "w": ["ffn_gate_inp", "ffn_gate_inp.bias?"], "rows": "experts", "out": "logits"},
      {"op": "stated",     "if": "moe", "of": "router_score", "name": "router.score", "in": "logits", "width": "experts", "out": "score"},
      {"op": "emit",       "if": "moe", "kind": "top_k", "in": "score", "attr": {"TopK": "experts_used"}, "outs": [{"name": "router.sel", "width": "experts_used", "elem": "u32", "as": "sel"}, {"name": "router.best", "width": "experts_used"}]},
      {"op": "emit",       "if": "moe", "kind": "take", "in": ["score", "sel"], "outs": [{"name": "router.w", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "reduce", "in": "w", "attr": {"Fn": "'add'"}, "outs": [{"name": "router.wsum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": "ws", "attr": {"Fn": "'add'", "Const": "1e-20"}, "outs": [{"name": "router.sum", "width": "1"}], "out": "ws"},
      {"op": "emit",       "if": "moe and expert_norm", "kind": "map", "in": ["w", "ws"], "attr": {"Fn": "'div'"}, "outs": [{"name": "router.wn", "width": "experts_used"}], "out": "w"},
      {"op": "emit",       "if": "moe", "kind": "tile", "in": "m", "attr": {"Span": "embd"}, "outs": [{"name": "experts.in", "width": "experts_used * embd"}], "out": "ein"},
      {"op": "emit", "if": "(moe) and stored('ffn_gate_exps')", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.gate", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_gate_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_gate_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eg"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ein", "sel"], "outs": [{"name": "experts.up", "width": "experts_used * rows('ffn_up_exps')"}], "bind": [{"w": "ffn_up_exps", "k": "embd", "rows": "rows('ffn_up_exps')", "sheets": "experts"}, {"w": "ffn_up_exps.bias?", "k": "rows('ffn_up_exps')", "rows": "experts"}], "out": "eu"},
      {"op": "act", "if": "(moe) and stored('ffn_gate_exps')", "name": "experts.act", "in": ["eg", "eu"], "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "act", "if": "(moe) and not stored('ffn_gate_exps')", "name": "experts.act", "in": "eu", "width": "experts_used * rows('ffn_up_exps')", "out": "ea"},
      {"op": "emit",       "if": "moe", "kind": "expert_matvec", "in": ["ea", "sel"], "outs": [{"name": "experts.down", "width": "experts_used * embd"}], "bind": [{"w": "ffn_down_exps", "k": "rows('ffn_up_exps')", "rows": "embd", "sheets": "experts"}, {"w": "ffn_down_exps.bias?", "k": "embd", "rows": "experts"}], "out": "ed"},
      {"op": "emit",       "if": "moe", "kind": "map", "in": ["ed", "w"], "attr": {"Fn": "'mul'"}, "outs": [{"name": "experts.weighted", "width": "experts_used * embd"}], "out": "ed"},
      {"op": "split_sum",  "if": "moe", "in": "ed", "parts": "experts_used", "name": "experts.out", "out": "d"},
      {"op": "routed",     "if": "moe", "from": "routed"},
      {"op": "add",        "in": ["h", "d"], "alpha": "residual_scale", "out": "y"},
      {"op": "emit",       "if": "layer < deep_taps", "kind": "slice", "in": "ple", "attr": {"Offset": "layer * embd", "Width": "embd"}, "outs": [{"name": "deep.in", "width": "embd"}], "out": "tap"},
      {"op": "add",        "if": "layer < deep_taps", "in": ["y", "tap"], "out": "y"},
      {"op": "out",        "in": "y"}
    ]
  }
}

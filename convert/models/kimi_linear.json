{
  "classes": ["KimiLinearForCausalLM"],
  "config": {
    "defaults": {
      "vocab_size": 163840,
      "hidden_size": 2304,
      "intermediate_size": 9216,
      "moe_intermediate_size": 1024,
      "num_hidden_layers": 27,
      "num_attention_heads": 32,
      "routed_scaling_factor": 2.446,
      "kv_lora_rank": 512,
      "qk_rope_head_dim": 64,
      "v_head_dim": 128,
      "qk_nope_head_dim": 128,
      "topk_group": 1,
      "hidden_act": "silu",
      "rms_norm_eps": 1e-05,
      "tie_word_embeddings": false,
      "first_k_dense_replace": 1
    },
    "arch": "kimilinear",
    "keys": {
      "block_count": {"uint": "num_hidden_layers"},
      "context_length": {"uint": "max_position_embeddings ?? model_max_length"},
      "embedding_length": {"uint": "hidden_size"},
      "feed_forward_length": {"uint": "intermediate_size"},
      "attention.head_count": {"uint": "num_attention_heads"},
      "attention.head_count_kv": {"int32s": "linear_attn_config != null ? each_layer(num_hidden_layers, linear_attn_config.full_attn_layers, 1, num_attention_heads, 0) : each_match(layer_types, 'full_attention', num_attention_heads, 0)"},
      "rope.freq_base": {"float": "rope_parameters.rope_theta ?? rope_theta ?? 10000"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps"},
      "ssm.conv_kernel": {"uint": "linear_attn_config.short_conv_kernel_size ?? linear_conv_kernel_dim ?? 4"},
      "kda.head_dim": {"uint": "linear_attn_config.head_dim ?? linear_head_dim ?? 128"},
      "attention.kv_lora_rank": {"uint": "kv_lora_rank"},
      "attention.q_lora_rank": {"uint": "q_lora_rank", "if": "(q_lora_rank ?? 0) != 0"},
      "rope.dimension_count": {"uint": "qk_rope_head_dim"},
      "attention.key_length": {"uint": "kv_lora_rank + qk_rope_head_dim"},
      "attention.value_length": {"uint": "kv_lora_rank"},
      "attention.key_length_mla": {"uint": "qk_nope_head_dim + qk_rope_head_dim"},
      "attention.value_length_mla": {"uint": "v_head_dim"},
      "leading_dense_block_count": {"uint": "mlp_layer_types != null ? leading(mlp_layer_types, 'dense') : first_k_dense_replace"},
      "expert_count": {"uint": "num_experts ?? n_routed_experts ?? 256"},
      "expert_used_count": {"uint": "num_experts_per_token ?? num_experts_per_tok ?? 8"},
      "expert_feed_forward_length": {"uint": "moe_intermediate_size"},
      "expert_shared_count": {"uint": "num_shared_experts ?? n_shared_experts ?? 1"},
      "expert_weights_scale": {"float": "routed_scaling_factor"},
      "expert_weights_norm": {"bool": "moe_renormalize ?? norm_topk_prob ?? true"},
      "expert_group_count": {"uint": "num_expert_group ?? n_group ?? 1"},
      "expert_group_used_count": {"uint": "topk_group"}
    },
    "vocab": "vocab_size",
    "head": {
      "tensor": "lm_head.weight",
      "tied": "tie_word_embeddings"
    },
    "activation": "hidden_act",
    "gating": "sigmoid",
    "require": [
      {"that": "mla_use_nope ?? true", "else": "mla_use_nope is false, and this graph runs Kimi's latent attention with no positional encoding"},
      {"that": "(moe_router_activation_func ?? 'sigmoid') == 'sigmoid'", "else": "moe_router_activation_func is not sigmoid, and KimiLinear routes with a sigmoid"},
      {"that": "(num_key_value_heads ?? (num_attention_heads)) == num_attention_heads", "else": "num_key_value_heads differs from the attention heads: latent attention shares one key-value latent across every head"},
      {"that": "num_local_experts == null || num_local_experts == (num_experts ?? n_routed_experts ?? 256)", "else": "num_local_experts disagrees with the routed expert count"},
      {"that": "(num_nextn_predict_layers ?? 0) == 0", "else": "num_nextn_predict_layers is not 0: Kimi-Linear's prediction blocks are not implemented"},
      {"that": "layer_types != null || linear_attn_config != null", "else": "neither layer_types nor linear_attn_config: a hybrid with a defaulted kind map converts fluently wrong"},
      {"that": "linear_attn_config == null || partitions(num_hidden_layers, 1, linear_attn_config.kda_layers, linear_attn_config.full_attn_layers)", "else": "linear_attn_config names a layer twice, outside the model, or in neither kda_layers nor full_attn_layers (one-indexed)"},
      {"that": "layer_types == null || (count(layer_types, 'linear_attention') + count(layer_types, 'full_attention') == num_hidden_layers && count(layer_types, 'linear_attention') > 0)", "else": "layer_types has an entry that is neither linear_attention nor full_attention, a length other than the blocks', or no linear_attention block, so this is not the hybrid"},
      {"that": "layer_types == null || linear_attn_config == null || each_match(layer_types, 'full_attention', num_attention_heads, 0) == each_layer(num_hidden_layers, linear_attn_config.full_attn_layers, 1, num_attention_heads, 0)", "else": "layer_types and linear_attn_config disagree"},
      {"that": "linear_attn_config == null || ((linear_attn_config.head_dim ?? (linear_head_dim)) == (linear_head_dim ?? (linear_attn_config.head_dim)) && (linear_attn_config.short_conv_kernel_size ?? (linear_conv_kernel_dim)) == (linear_conv_kernel_dim ?? (linear_attn_config.short_conv_kernel_size)) && (linear_attn_config.num_heads ?? (linear_num_heads)) == (linear_num_heads ?? (linear_attn_config.num_heads)))", "else": "linear_attn_config and the flat linear keys disagree"},
      {"that": "(linear_attn_config.num_heads ?? linear_num_heads ?? 32) == num_attention_heads", "else": "the linear heads differ from num_attention_heads: the container's KDA heads are the attention's"},
      {"that": "(linear_attn_config.short_conv_kernel_size ?? linear_conv_kernel_dim ?? 4) >= 2", "else": "a causal convolution needs at least two taps"},
      {"that": "mlp_layer_types == null || (count(mlp_layer_types, 'dense') + count(mlp_layer_types, 'sparse') == num_hidden_layers && count(mlp_layer_types, 'dense') == leading(mlp_layer_types, 'dense'))", "else": "mlp_layer_types has a dense block after a sparse one, which a dense run stated as a length cannot express, an entry neither dense nor sparse, or a length other than the blocks'"},
      {"that": "mlp_layer_types != null || (moe_layer_freq ?? 1) == 1", "else": "moe_layer_freq is not 1: this container states the dense run as a length, and a mixture every few blocks is not one"},
      {"that": "mlp_layer_types == null || first_k_dense_replace == leading(mlp_layer_types, 'dense') || first_k_dense_replace == 1", "else": "first_k_dense_replace disagrees with mlp_layer_types' leading dense blocks"},
      {"that": "(kv_lora_rank ?? 0) != 0 && (qk_nope_head_dim ?? 0) != 0 && (qk_rope_head_dim ?? 0) != 0 && (v_head_dim ?? 0) != 0", "else": "kv_lora_rank, qk_nope_head_dim, qk_rope_head_dim or v_head_dim is zero, and Kimi-Linear's full blocks are MLA"},
      {"that": "(rope_parameters.rope_type ?? 'default') == 'default' && (rope_parameters.type ?? 'default') == 'default' && (rope_scaling.rope_type ?? 'default') == 'default' && (rope_scaling.type ?? 'default') == 'default'", "else": "a rotary scaling on a model with no rotary (mla_use_nope)"}
    ]
  },
  "tensors": {
    "block_prefix": "model.layers.",
    "model": {
      "model.embed_tokens.weight": "token_embd.weight",
      "model.norm.weight": "output_norm.weight",
      "lm_head.weight": "output.weight"
    },
    "block": {
      "input_layernorm.weight": "attn_norm.weight",
      "post_attention_layernorm.weight": "ffn_norm.weight",
      "self_attn.q_proj.weight": "attn_q.weight",
      "self_attn.q_a_proj.weight": "attn_q_a.weight",
      "self_attn.q_a_layernorm.weight": "attn_q_a_norm.weight",
      "self_attn.q_b_proj.weight": "attn_q_b.weight",
      "self_attn.kv_a_proj_with_mqa.weight": "attn_kv_a_mqa.weight",
      "self_attn.kv_a_layernorm.weight": "attn_kv_a_norm.weight",
      "self_attn.kv_b_proj.weight": [{"role": "attn_k_b.weight", "do": [{"reshape": ["num_attention_heads", "qk_nope_head_dim + v_head_dim", "kv_lora_rank"]}, {"slice": [1, 0, "qk_nope_head_dim"]}, {"transpose": [0, 2, 1]}]}, {"role": "attn_v_b.weight", "do": [{"reshape": ["num_attention_heads", "qk_nope_head_dim + v_head_dim", "kv_lora_rank"]}, {"slice": [1, "qk_nope_head_dim", "v_head_dim"]}]}],
      "self_attn.k_b_proj.weight": "attn_k_b.weight",
      "self_attn.v_b_proj.weight": "attn_v_b.weight",
      "self_attn.o_proj.weight": "attn_output.weight",
      "mlp.gate_proj.weight": "ffn_gate.weight",
      "mlp.up_proj.weight": "ffn_up.weight",
      "mlp.down_proj.weight": "ffn_down.weight",
      "block_sparse_moe.gate_proj.weight": "ffn_gate.weight",
      "block_sparse_moe.up_proj.weight": "ffn_up.weight",
      "block_sparse_moe.down_proj.weight": "ffn_down.weight",
      "block_sparse_moe.gate.weight": "ffn_gate_inp.weight",
      "block_sparse_moe.gate.e_score_correction_bias": "exp_probs_b.bias",
      "block_sparse_moe.shared_experts.gate_proj.weight": "ffn_gate_shexp.weight",
      "block_sparse_moe.shared_experts.up_proj.weight": "ffn_up_shexp.weight",
      "block_sparse_moe.shared_experts.down_proj.weight": "ffn_down_shexp.weight"
    },
    "block_linear": {
      "self_attn.q_proj.weight": "attn_qkv.weight",
      "self_attn.k_proj.weight": "attn_qkv.weight",
      "self_attn.v_proj.weight": "attn_qkv.weight",
      "self_attn.q_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size ?? linear_conv_kernel_dim ?? 4"]}]},
      "self_attn.k_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size ?? linear_conv_kernel_dim ?? 4"]}]},
      "self_attn.v_conv1d.weight": {"role": "ssm_conv1d.weight", "do": [{"reshape": [-1, "linear_attn_config.short_conv_kernel_size ?? linear_conv_kernel_dim ?? 4"]}]},
      "self_attn.b_proj.weight": "ssm_ba.weight",
      "self_attn.f_a_proj.weight": "ssm_f_a.weight",
      "self_attn.f_b_proj.weight": "ssm_f_b.weight",
      "self_attn.g_a_proj.weight": "ssm_g_a.weight",
      "self_attn.g_b_proj.weight": "ssm_g_b.weight",
      "self_attn.A_log": {"role": "ssm_a", "do": [{"reshape": [-1]}, {"trim": [0, "num_attention_heads"]}, {"map": "-exp(x)"}, {"repeat": [0, "linear_attn_config.head_dim ?? linear_head_dim ?? 128"]}]},
      "self_attn.dt_bias": "ssm_dt.bias",
      "self_attn.o_norm.weight": "ssm_norm.weight",
      "self_attn.o_proj.weight": "ssm_out.weight"
    },
    "fuse": {
      "attn_qkv.weight": ["self_attn.q_proj.weight", "self_attn.k_proj.weight", "self_attn.v_proj.weight"],
      "ssm_conv1d.weight": ["self_attn.q_conv1d.weight", "self_attn.k_conv1d.weight", "self_attn.v_conv1d.weight"]
    },
    "experts": {
      "prefix": "block_sparse_moe.experts.",
      "names": {"w1.weight": "ffn_gate_exps.weight", "w3.weight": "ffn_up_exps.weight", "w2.weight": "ffn_down_exps.weight"}
    },
    "ignore": ["model.rotary_emb.inv_freq", "self_attn.rotary_emb.inv_freq"]
  }
}

      "feed_forward_length":              {"uint": "intermediate_size ?? 3072"},
      "attention.head_count":             {"uint": "num_attention_heads ?? 16"},
      "attention.head_count_kv":          {"uint": "num_key_value_heads ?? 2"},
      "attention.key_length":             {"uint": "head_dim ?? 128"},
      "attention.value_length":           {"uint": "head_dim ?? 128"},
      "attention.layer_norm_rms_epsilon": {"float": "rms_norm_eps ?? 1e-5"},
      "rope.dimension_count":             {"uint": "head_dim ?? 128"},
      "rope.freq_base":                   {"float": "rope_parameters.rope_theta ?? rope_theta ?? 500000"}
    },
    "vocab": "vocab_size ?? 103424",
    "head": {"tensor": "lm_head.weight", "tied": "tie_word_embeddings ?? true"},
    "activation": "hidden_act ?? 'silu'",
    "rope_scaling": "rope_parameters ?? rope_scaling",
    "window": {"size": "sliding_window", "used": "use_sliding_window ?? true"}
  },
  "tensors": {

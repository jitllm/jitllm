{
  "input_formats": [
    {
      "name": "gguf",
      "example": "jitllm convert model.gguf out.jlm",
      "note": "a GGUF of an architecture in architectures; its tensor types must be in quantization.dequantable",
      "evidence": ["TestGreedyMatchesLlamaCpp"]
    },
    {
      "name": "gguf+mmproj",
      "example": "jitllm convert model.gguf mmproj.gguf out.jlm",
      "note": "a text GGUF and its vision projector, joined into one container; the projector must be in projectors",
      "evidence": ["TestOneContainerCarriesTextAndVision"]
    },
    {
      "name": "safetensors",
      "example": "jitllm convert ./hf-model-dir out.jlm",
      "note": "a Hugging Face directory whose config.json class is in safetensors_classes; -q8 stores the matrices as Q8_0",
      "evidence": ["TestSafetensorsMatchTransformers"]
    },
    {
      "name": "url",
      "example": "jitllm convert hf://owner/repo/model.gguf out.jlm",
      "note": "an hf:// or https:// URL, downloaded into JITLLM_MODELS first",
      "evidence": ["TestLibraryArgsExpandsANameAndNothingElse"]
    },
    {
      "name": "catalogue name",
      "example": "jitllm convert qwen3-0.6b",
      "note": "a name from `jitllm library`",
      "evidence": ["TestLibraryArgsExpandsANameAndNothingElse", "TestEveryArchitectureIsObtainable"]
    },
    {
      "name": "jlm",
      "example": "jitllm run out.jlm 'Hello'",
      "note": "the only format the engine runs; a container of another version is refused with the convert command",
      "evidence": ["TestEveryModelRunsGenerated"]
    }
  ],

{
  "checks": {
    "vet": {
      "command": ["./scripts/vet"],
      "note": "go vet with the argued unsafe.Pointer allowlist, the engine module"
    },
    "vet-server": {
      "command": ["./scripts/vet", "server"],
      "note": "go vet over the server module"
    },
    "srcgate": {
      "module": ".", "packages": ["./internal/srcgate", "./internal/oracle", "./internal/testmodels"], "cap": "8G",
      "note": "the source gates: docs/models.md and docs/capabilities.json generated, no oracle import, the README"
    },
    "capabilities": {
      "module": ".", "packages": ["./internal/capabilities", "./internal/srcgate"], "run": "TestMaintainedEvidenceExists|TestMaintainedGateFires|TestManifestIsDerived|TestCapabilitiesDocIsGenerated", "cap": "8G",
      "note": "the capability manifest against the code; regenerate with: cd server && go run ./cmd/gencapabilities"
    },
    "capabilities-api": {
      "module": "server", "packages": ["."], "run": "TestAPIManifestIsGenerated|TestAPIManifestCoversEveryField|TestRouteTableIsWhatIsServed|TestCapabilitiesEndpoint|TestRefusalsAreRefused", "cap": "8G",
      "note": "the server's half of the manifest against its route table and handlers"
    },
    "checks-map": {
      "module": ".", "packages": ["./scripts/checks"], "cap": "4G",
      "note": "this map covers the tree and names gates that exist"
    },
    "cmd": {
      "module": ".", "packages": ["./cmd/..."], "cap": "8G",
      "note": "the CLI: flags, environment, doctor, capabilities"
    },
    "jit-cpu": {
      "module": ".", "packages": ["./jit/cpu/..."], "cap": "8G",
      "note": "every host emitter against the oracle at ragged widths (RULE 8), and no assembly but the trampolines"
    },
    "nn": {
      "module": ".", "packages": ["./engine/nn/...", "./engine/grammar/..."], "cap": "8G"
    },
    "sched": {
      "module": ".", "packages": ["./engine/sched/..."], "cap": "8G",
      "note": "the pool, core sets and memory budgets"
    },
    "format": {
      "module": ".", "packages": ["./format/..."], "cap": "8G",
      "note": "the container, its pager and the quant decoders"
    },
    "convert": {
      "module": ".", "packages": ["./convert/..."], "cap": "16G",
      "needs": {"models": true},
      "note": "conversion; some gates read GGUFs from JITLLM_MODELS"
    },
    "tok": {
      "module": ".", "packages": ["./tok/..."], "cap": "8G",
      "needs": {"models": true},
      "note": "tokenizers against their references"
    },
    "model-correctness": {
      "module": ".", "packages": ["./engine/model"], "run": "TestGreedyMatchesLlamaCpp|TestBatchMatchesForward|TestPrefillMatchesForward|TestEveryModelRunsGenerated|TestSafetensorsMatchTransformers|TestTowerEncodes", "cap": "16G",
      "needs": {"models": true},
      "note": "the engine against llama.cpp, transformers and its own batched path (RULE 7, RULE 11d); run the same on the arm64 host"
    },
    "five-principles": {
      "module": ".", "packages": ["./engine/model"], "run": "TestEveryModelRunsGenerated|TestDecodeDoesNotAllocate|TestPagingDoesNotChangeTheAnswer|TestOpenHonoursAPageBudget|TestForwardBatchFaultsItsBlocksIn|TestTwoPagedModels|TestWindowedLayersHoldTheirWindow|TestPrefixCacheRestoresAWindowedLayer", "cap": "16G",
      "needs": {"models": true},
      "note": "the five principles' host gates: generated code, paging and zero-allocation decode"
    },
    "relocation": {
      "module": ".", "packages": ["./engine/model"], "run": "TestLayerRelocatesToAnotherDevice|TestRelocatedBlocksComeBack|TestKVPagesRelocateWithTheLayer|TestBatchSeamMovesCarryEveryRow|TestMLASeamMovesWithItsHistory|TestShrinkingTheSeamBringsTheSummaryHome", "cap": "16G",
      "needs": {"models": true, "device": true},
      "note": "relocation, host <-> device and between devices"
    },
    "device-model": {
      "module": ".", "packages": ["./engine/model"], "run": "OnEveryDevice|TestDeviceMatchesHost|TestTowerOnDeviceMatchesHost", "cap": "16G",
      "needs": {"models": true, "device": true},
      "note": "every graph feature on the device, every block placed against the host (RULE 11c)"
    },
    "gpu-lowering": {
      "module": ".", "packages": ["./jit/ir/...", "./jit/ptx/...", "./jit/spirv/...", "./jit/msl/...", "./jit/amdgpu/...", "./jit/gpu/lowertest/...", "./jit/gpu/kernels/..."], "cap": "8G",
      "note": "the IR and its four lowerings; runs with no GPU"
    },
    "gpu-backend": {
      "module": ".", "packages": ["./backend/...", "./backend/cuda/...", "./backend/vulkan/...", "./backend/metal/...", "./backend/hip/...", "./backend/ffi/..."], "cap": "8G",
      "needs": {"device": true},
      "note": "the backends against the oracle on a real device"
    },
    "composer": {
      "module": ".", "packages": ["./jit", "./jit/x86/...", "./engine/graph/...", "./engine/cost/...", "./engine/probe/..."], "cap": "16G",
      "note": "the composer: the graph, its lowering and passes, the one keyed cache, the estimator and the hardware probes"
    },
    "composed": {
      "module": ".", "packages": ["./engine/model"], "run": "TestFrontStatesTheModelAsOps|TestComposedBlocksServe|TestComposedShadowHoldsEveryBlock|TestC6ServesComposed|TestPrefillFoldsALayerNormHead|TestPlacedPromptsCompileNothing|TestDeviceMemoryHoldsSteadyAcrossMoves|TestSessionsStepAtOnceComposed|TestSessionsRelocateAtOnceComposed|TestABatchLeavesAnotherSessionAlone|TestLayerRelocatesToAnotherDevice|TestBlocksMoveBetweenDevices", "cap": "16G",
      "needs": {"models": true, "device": true},
      "note": "the composer serving the tier's blocks and heads: every block served, none formed at a step, forms charged and freed, sessions side by side, moves; -tags jitllmcomposed runs every device gate composed (docs/testing.md)"
    },
    "gpu-tier": {
      "module": ".", "packages": ["./jit/gpu/tier/..."], "cap": "16G",
      "needs": {"device": true},
      "note": "placement, budgets and multi-device"
    },
    "server": {
      "module": "server", "packages": ["./..."], "cap": "8G",
      "needs": {"models": true},
      "note": "the HTTP and Connect surfaces; the end-to-end gates load stories260K"
    },
    "common": {
      "module": "common", "packages": ["./..."], "cap": "8G"
    },
    "ui": {
      "module": "ui", "packages": ["./..."], "cap": "8G"
    },
    "tui": {
      "module": "tui", "packages": ["./..."], "cap": "8G"
    },
    "dev-tools": {
      "module": ".", "packages": ["./dev/tools/...", "./dev/probe/...", "./dev/httpbench/...", "./dev/decisionbench/..."], "cap": "8G",
      "note": "the harnesses' own tests; dev/bench's perf floors are measured serially by the main session (RULE 2, RULE 4) and are not run here"
    },
    "scripts": {
      "module": ".", "packages": ["./scripts/..."], "cap": "8G",
      "note": "the generators and runners written in Go"
    },
    "proto": {
      "command": ["buf", "lint"],
      "note": "and `buf generate` must leave server/gen unchanged; generated code is never edited by hand"
    }
  },
  "entries": [
    {"prefix": "engine/model/", "evidence": "docs/engineering-history/model-correctness.md", "checks": ["model-correctness", "five-principles", "relocation", "device-model", "composed", "vet"]},

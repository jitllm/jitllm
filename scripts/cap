#!/usr/bin/env bash
# Run a command inside a rootless, memory-capped cgroup-v2 scope so a runaway
# test/VM (OOM, fork bomb) is killed inside its own cgroup — never the host.
#
# Used two ways:
#   - manually:        scripts/cap [MEM] -- <command...>
#   - wrapping a test:  scripts/cap 8G -- taskset -c 0,2,4,6,8,10 go test ./...
#
# MEM defaults to $JITLLM_CAP_MEM or 8G.  See AGENTS.md RULE 3.
#
# It protects the DEVELOPER'S OWN MACHINE from OOM. It is not a measurement
# tool: a benchmark host runs both engines bare and takes only the measurement
# lock below (scripts/vs-llamacpp.sh does), because a memory cgroup charges
# llama.cpp's mmap page cache and throttles it at MemoryHigh while jitllm's
# O_DIRECT reads are not charged that way.
#
# ★★★ TWO CONTROLS, AND THE SECOND ONE IS WHY THE DESKTOP KEPT DYING.
#
# MemoryMax is the HARD ceiling: cross it and the kernel kills inside this cgroup. It works — every
# kernel OOM on this box since the cap was adopted is "Memory cgroup out of memory", contained,
# host survived.
#
# But a job is free to thrash right up against MemoryMax, and the sustained reclaim that causes is
# SYSTEM-WIDE memory PRESSURE (PSI). systemd-oomd watches pressure, not limits, and kills the
# cgroup under the most pressure — which on a desktop is GNOME Shell, not the test. Observed
# with every kernel kill that boot contained and ZERO global OOMs:
#
#	org.gnome.Shell@x11.service: systemd-oomd killed some process(es) in this unit.
#
# i.e. the caps held and the session died anyway. MemoryHigh is the missing half: it THROTTLES the
# cgroup and reclaims inside it before the pressure escapes, so the job slows down instead of the
# desktop dying. Set to 90% of MemoryMax.
#
# ★ 90, NOT 75. At 75% a job whose working set legitimately IS its budget lives permanently in
# reclaim: `go test -c ./internal/vm` has an RSS of 3.17G, and under `cap 4G` the 3.0G MemoryHigh
# throttled it to 3.6% CPU for 21 minutes without ever finishing. MemoryHigh is meant to catch a
# RUNAWAY before its pressure escapes the cgroup, not to strangle a job that is using what it was
# given. 90% leaves a real throttle band under the hard wall and still fires long before MemoryMax.
#
# ★ JITLLM_NO_CAP IS DELIBERATELY *NOT* HONOURED HERE, AND ADDING IT WAS A
# MISTAKE I MADE AND REVERTED. It is the HOOK's variable: scripts/require-cap.py
# lets a command through when the command line contains JITLLM_NO_CAP=1, which
# means the command runs WITHOUT this script and says so in plain sight. Making
# it also disable the cgroup INSIDE this script created something far worse --
# `JITLLM_NO_CAP=1 ./scripts/cap 8G -- go test ./...` reads as a capped run, and
# would not have been one. A bypass that is visible in the command is a decision;
# a bypass that makes a capped-looking command uncapped is a trap. Keep the two
# layers' escape hatches distinct. THERE IS NO BYPASS VARIABLE IN THIS SCRIPT AT
# ALL: WARP_NO_CAP=1 used to be one, inherited from warpjs-itr2, and it had the
# identical property under a different name, and it was removed.
#
# An unavailable systemd-run is a HARD ERROR rather than a silent uncapped exec: that silent
# fallback is how warpjs-itr2's test262 runner reached 25-28 GB anon-RSS and took the whole machine
# down twice, and "always safe to invoke" is not the same as "always capping".
# ★★★ AND A THIRD CONTROL: HEAVY JOBS ARE MUTUALLY EXCLUSIVE WITH MEASUREMENTS.
#
# RULE 3a says "never fan out parallel measurement agents" and RULE 2 gates on a
# quiet box, and both were still only PROMISES -- nothing stopped two measuring
# jobs overlapping. Once, four wait-loops left over from an earlier part
# of the session were still sleeping on conditions that no longer existed, and
# one of them would have run `go build` plus sixteen prefill runs the moment its
# condition fired. It did fire, in the middle of a gated A/B, and the round it
# landed on read 1.005 where its five neighbours read 1.033-1.048.
#
# The PSI gate cannot catch that: a script checks PSI once at the top and then
# measures for half an hour, and the interloper starts at minute twelve.
#
# So the lock is here, because RULE 3 already forces every heavy job through
# this script and the require-cap hook already enforces that. Nothing new has to
# be remembered, which is RULE 3b's whole point -- "a safety rule that depends on
# remembering it is not a safety rule".
#
#   MEASUREMENT payloads (jitllm run/bench/verify, llama-bench, the *bench probes,
#   a compiled .test, go test -bench) take the lock EXCLUSIVE.
#   Everything else -- builds, plain `go test` -- takes it SHARED.
#
# So two measurements exclude each other, a build excludes a measurement, and
# two builds run concurrently as before. A waiter says who it is waiting for,
# because the point is to make the stray VISIBLE rather than to serialise
# silently. JITLLM_NO_LOCK=1 opts out; JITLLM_LOCK_WAIT sets the timeout.
capIsMeasurement() {
  # ★ AN ARBITRARY SCRIPT CAN SAY SO, BECAUSE THE CLASSIFIER CANNOT KNOW. A
  # one-off A/B in a scratchpad is a measurement and its basename says nothing;
  # the first such script written after this lock landed took the SHARED lock
  # and was duly interrupted mid-run. JITLLM_MEASURE=1 is how a wrapper declares
  # what it is.
  [ "${JITLLM_MEASURE:-0}" = "1" ] && return 0
  # Skip the wrappers a caller puts in front of the real payload.
  while [ $# -gt 0 ]; do
    case "$1" in
      taskset)                             # `taskset -c LIST cmd` or `taskset MASK cmd`
        shift
        if [ "${1:-}" = "-c" ]; then shift 2; else shift; fi ;;
      env|nice|ionice) shift ;;
      *=*) shift ;;                        # leading VAR=value
      *) break ;;
    esac
  done
  [ $# -eq 0 ] && return 1
  case "$(basename "$1")" in
    jitllm|jitllm-*)
      # ★ ONLY THE SUBCOMMANDS THAT TIME SOMETHING. `jitllm convert` streaming
      # a 98 GB checkpoint is eight hours of network wait, and holding the lock
      # EXCLUSIVE for it would park every build and test behind a download.
      case "${2:-}" in convert|info|tokenize|hardware|library|asm) return 1 ;; esac
      return 0 ;;
    llama-bench|llama-cli|*bench|*.test|vs-llamacpp.sh|vs-llamacpp-paged.sh) return 0 ;;
    go)
      case " $* " in *" -bench"*) return 0 ;; esac
      return 1 ;;
  esac
  return 1
}

if [ "${1:-}" = "--selftest" ]; then
  fail=0
  t() { # t <want 0|1> <argv...>
    want="$1"; shift
    if capIsMeasurement "$@"; then got=0; else got=1; fi
    [ "$got" = "$want" ] || { echo "cap --selftest: want $want got $got for: $*" >&2; fail=1; }
  }
  t 0 taskset -c 0,2,4 ./jitllm run -n 320 m.gguf hi
  t 1 ./jitllm convert -q8 hf://owner/repo
  t 0 taskset -c 0,2 /tmp/x/jitllm-fold run m.gguf hi
  t 0 /home/u/llama/llama-bench -m m.gguf -p 512
  t 0 ./dev/tools/fmtbench
  t 0 ./scripts/ref/q3kbench
  t 0 /tmp/go-build/model.test -test.run=X
  t 0 go test ./engine/nn -bench=. -run=XXX
  t 1 go test ./engine/ ./engine/nn/ -count=1
  t 1 go build -o jitllm ./cmd/jitllm
  t 1 taskset -c 0,2,4,6,8,10 go test ./... -count=1
  t 1 gcc -O2 -o probe probe.c
  t 0 ./scripts/vs-llamacpp.sh cpu m.gguf
  t 0 ./scripts/vs-llamacpp-paged.sh m.gguf 2G
  t 1 make -j4
  ( export JITLLM_MEASURE=1; t 0 ./scratchpad/my-ab.sh )
  [ "$fail" = 0 ] && echo "cap --selftest: ok"
  exit "$fail"
fi

mem="${JITLLM_CAP_MEM:-8G}"
case "${1:-}" in
  [0-9]*[GMK]) mem="$1"; shift ;;
esac
[ "${1:-}" = "--" ] && shift

# MemoryHigh = 90% of MemoryMax, in the same unit. Integer arithmetic on the numeric part.
high="$mem"
case "$mem" in
  *G) high="$(( ${mem%G} * 921 ))M" ;;
  *M) high="$(( ${mem%M} * 9 / 10 ))M" ;;
  *K) high="$(( ${mem%K} * 9 / 10 ))K" ;;
esac

# ★ macOS HAS NO CGROUP TO CAP WITH, SO THE REFUSAL BELOW WOULD BLOCK EVERYTHING
# THERE. This is a PLATFORM fact rather than an override: it cannot be set by
# accident, cannot be exported into a Linux shell, and cannot make a Linux run
# look capped when it is not. The Linux refusal is untouched, which is the half
# that matters -- RULE 3c records systemd-oomd killing GNOME Shell three times.
if [ "$(uname -s)" = Darwin ]; then
  echo "scripts/cap: no cgroup on Darwin; running UNCAPPED (mem=$mem ignored)." >&2
  exec "$@"
fi

# ★ A CONTAINER WITH NO SYSTEMD AT ALL (a CI image, a rented runner) is the one
# place the cap is applied another way, and it is decided by a PLATFORM fact, as
# Darwin's is: /run/systemd/system exists exactly when systemd is PID 1. On a
# host that boots systemd -- the laptop -- a missing user manager is still the
# refusal below, never this. The container's own cgroup takes the limit when
# it is writable (a child cgroup with memory.max, memory.high and
# memory.swap.max). Failing that, a container whose own cgroup states a
# memory.max is already capped by it, read-only, and the job runs under that
# wall rather than its own. With neither, the job runs UNCAPPED and says so: a
# container is not the developer's machine, there is no desktop for oomd to
# kill, and the only other wall, ulimit -v, limits ADDRESS SPACE rather than
# memory -- the CUDA runtime reserves address space in proportion to the card,
# so llama-bench aborted at 12 GiB and ran at 256 GiB, and an 80 GB card failed
# every cuMemAlloc at 16 GiB. The mode is printed, so a log says what capped it.
capmode=systemd
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [ "$(uname -s)" = Linux ] && [ ! -d /run/systemd/system ] \
  && { ! command -v systemd-run >/dev/null 2>&1 || [ ! -S "$runtime/systemd/private" ]; }; then
  capmode=container
fi
capBytes() {
  case "$1" in
    *G) echo $(( ${1%G} * 1024 * 1024 * 1024 )) ;;
    *M) echo $(( ${1%M} * 1024 * 1024 )) ;;
    *K) echo $(( ${1%K} * 1024 )) ;;
    *) echo "$1" ;;
  esac
}
if [ "$capmode" = systemd ] && { ! command -v systemd-run >/dev/null 2>&1 || [ ! -S "$runtime/systemd/private" ]; }; then
  echo "scripts/cap: REFUSING to run uncapped — systemd-run --user is unavailable." >&2
  echo "  RULE 3c: systemd-oomd has killed the desktop three times on this box, twice from an" >&2
  echo "  uncapped 'go test'. There is NO bypass here on purpose -- a flag that makes a" >&2
  echo "  capped-looking command uncapped is a trap. To run without a cap deliberately, run" >&2
  echo "  the command WITHOUT scripts/cap and put JITLLM_NO_CAP=1 on it, where the hook sees" >&2
  echo "  it and it is visible in the command line." >&2
  exit 70
fi

# ★ BOUND THE COMPILER'S PARALLELISM, NOT JUST ITS MEMORY.
#
# The caps above stop a job exceeding its budget. They do NOT stop it entering
# the MemoryHigh throttle band, and on this box entering that band is itself
# fatal: user@1000.service carries ManagedOOMMemoryPressure=kill, so the reclaim
# pressure that throttling generates is exactly the signal systemd-oomd acts on,
# and the unit it kills is GNOME Shell. Observed three times in one day, the
# last with `cap 4G -- go build ./...` — memory contained, session dead anyway.
#
# `go build` defaults to one compile process per CPU, which is 20 here. Holding
# it to 4 keeps peak RSS far below the cap, so the throttle band is never
# entered, so no pressure escapes and oomd never fires. Attacking the cause is
# cheaper than surviving the symptom. Both are overridable if a caller means it.
case " $GOFLAGS " in
  *" -p="*) ;;
  *) GOFLAGS="${GOFLAGS:+$GOFLAGS }-p=4" ;;
esac
export GOFLAGS
export GOMAXPROCS="${GOMAXPROCS:-6}"

if [ "${JITLLM_NO_LOCK:-0}" != "1" ]; then
  lockfile="${TMPDIR:-/tmp}/jitllm-cap.lock"
  : >>"$lockfile" 2>/dev/null || lockfile=""
  if [ -n "$lockfile" ] && command -v flock >/dev/null 2>&1; then
    if capIsMeasurement "$@"; then mode="-x"; kind="measurement"; else mode="-s"; kind="build"; fi
    # ★ The fd is deliberately NOT close-on-exec: the exec below replaces this
    # shell with systemd-run, and the lock has to outlive the shell and cover
    # the whole job. bash's `exec N>` gives exactly that.
    exec 9>>"$lockfile"
    if ! flock -n "$mode" 9; then
      # fuser reports THIS shell too -- fd 9 is already open -- so drop it and
      # its children, or the message accuses the waiter of being the holder.
      holders="$(command -v fuser >/dev/null 2>&1 && fuser "$lockfile" 2>/dev/null | tr -s ' ' '\n' \
        | grep -E '^[0-9]+$' | grep -v "^$$\$" | tr '\n' ' ')"
      echo "scripts/cap: waiting -- this is a $kind and the box is already busy${holders:+ (pids:$holders)}" >&2
      [ -n "$holders" ] && ps -o pid=,etime=,args= -p $holders 2>/dev/null | cut -c1-160 >&2
      t0=$SECONDS
      if ! flock -w "${JITLLM_LOCK_WAIT:-1800}" "$mode" 9; then
        echo "scripts/cap: REFUSING -- still busy after ${JITLLM_LOCK_WAIT:-1800}s." >&2
        echo "  A measurement taken beside another job is not a measurement (RULE 2, RULE 3a)." >&2
        echo "  Kill the holder above, or set JITLLM_NO_LOCK=1 if you mean it." >&2
        exit 75
      fi
      echo "scripts/cap: acquired after $((SECONDS-t0))s" >&2
    fi
  fi
fi

if [ "$capmode" = container ]; then
  maxb="$(capBytes "$mem")"
  highb="$(( maxb / 1000 * 900 ))"
  cg=""
  rel="$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null | head -1)"
  if [ -n "$rel" ] && [ -f "/sys/fs/cgroup${rel%/}/cgroup.controllers" ]; then
    parent="/sys/fs/cgroup${rel%/}"
    # The memory controller must be delegated to the children; a write the
    # container forbids fails and leaves the ulimit mode.
    grep -qw memory "$parent/cgroup.subtree_control" 2>/dev/null \
      || echo +memory 2>/dev/null >"$parent/cgroup.subtree_control"
    child="$parent/jitllm-cap-$$"
    if grep -qw memory "$parent/cgroup.subtree_control" 2>/dev/null && mkdir "$child" 2>/dev/null; then
      if echo "$maxb" 2>/dev/null >"$child/memory.max" && echo "$highb" 2>/dev/null >"$child/memory.high" \
        && { echo 0 2>/dev/null >"$child/memory.swap.max" || [ ! -e "$child/memory.swap.max" ]; } \
        && echo $$ 2>/dev/null >"$child/cgroup.procs"; then
        cg="$child"
      else
        rmdir "$child" 2>/dev/null
      fi
    fi
  fi
  if [ -n "$cg" ]; then
    echo "scripts/cap: container mode, cgroup $cg memory.max=$mem memory.high=$highb" >&2
  elif encl="$(cat "/sys/fs/cgroup${rel%/}/memory.max" 2>/dev/null)" && [ -n "$encl" ] && [ "$encl" != max ]; then
    echo "scripts/cap: container mode, the container's own cgroup memory.max=$encl (read-only; $mem not applied)" >&2
  else
    echo "scripts/cap: container mode, no writable cgroup and no stated memory.max; running UNCAPPED ($mem not applied)" >&2
  fi
  exec "$@"
fi

exec systemd-run --user --scope -q --collect \
  -p MemoryMax="$mem" -p MemoryHigh="$high" -p MemorySwapMax=0 -p TasksMax=4096 -- "$@"
